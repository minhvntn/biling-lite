<Window x:Class="Server.Admin.App.SystemHealthCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chẩn đoán Sức khỏe Hệ thống &amp; Tự động Sửa chữa (Auto Repair)" 
        Height="730" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Blue Action Button -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Purple Gradient Auto Repair Button -->
        <Style x:Key="AutoRepairButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#7C3AED" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6D28D9" Offset="0"/>
                                            <GradientStop Color="#4F46E5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary White Button -->
        <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Banner Status -->
            <RowDefinition Height="Auto"/>
            <!-- Detailed Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="44" Height="44" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                <TextBlock Text="🩺" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Chẩn đoán Sức khỏe Hệ thống &amp; Tự động Sửa chữa" FontSize="18.5" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Kiểm tra và tự động khắc phục sự cố Backend API, Cơ sở dữ liệu PostgreSQL và Kênh Realtime" FontSize="12.5" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- 2. BANNER STATUS CARD -->
        <Border Grid.Row="1" x:Name="BannerCardBorder"
                Background="#ECFDF5"
                BorderBrush="#86EFAC"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="BannerIconTextBlock" Text="✅" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="BannerTitleTextBlock" Text="HỆ THỐNG HOẠT ĐỘNG TỐT" FontSize="15" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock x:Name="BannerMessageTextBlock" Text="Backend và Cơ sở dữ liệu đang phản hồi ổn định, không có sự cố nào." FontSize="12.5" Foreground="#166534" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. DETAILED CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- KHUNG TIẾN TRÌNH TỰ ĐỘNG SỬA CHỮA (HIỆN RA KHI BẤM REPAIR) -->
                <Border x:Name="RepairProgressBorder"
                        Visibility="Collapsed"
                        Background="#FAF5FF"
                        BorderBrush="#C084FC"
                        BorderThickness="1.5"
                        CornerRadius="10"
                        Padding="16,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="16" Foreground="#7C3AED" Margin="0,0,6,0"/>
                                <TextBlock Text="TIẾN TRÌNH TỰ ĐỘNG SỬA CHỮA HỆ THỐNG" FontSize="13.5" FontWeight="Bold" Foreground="#6B21A8"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3E8FF" CornerRadius="6" Padding="10,3" Margin="8,0,0,0">
                                <TextBlock x:Name="RepairStepCountTextBlock" Text="Đang xử lý..." FontSize="12" FontWeight="Bold" Foreground="#7E22CE"/>
                            </Border>
                        </Grid>

                        <ProgressBar x:Name="RepairProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Background="#E9D5FF" Foreground="#7C3AED" BorderThickness="0" Margin="0,0,0,10"/>

                        <!-- Các bước kiểm tra thực tế -->
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock x:Name="RepairStep1TextBlock" Text="• Bước 1: 🗄️ Đang kiểm tra &amp; khởi động dịch vụ PostgreSQL..." FontSize="12.5" Foreground="#581C87" Margin="0,2"/>
                            <TextBlock x:Name="RepairStep2TextBlock" Text="• Bước 2: 🌐 Đang kiểm tra tiến trình Backend &amp; giải phóng cổng 39090..." FontSize="12.5" Foreground="#581C87" Margin="0,2"/>
                            <TextBlock x:Name="RepairStep3TextBlock" Text="• Bước 3: 🚀 Đang khởi động lại Backend Service nếu bị tắt..." FontSize="12.5" Foreground="#581C87" Margin="0,2"/>
                            <TextBlock x:Name="RepairStep4TextBlock" Text="• Bước 4: ⚡ Đang kết nối lại Realtime Hub &amp; đồng bộ dữ liệu..." FontSize="12.5" Foreground="#581C87" Margin="0,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- HẠNG MỤC 1: BACKEND API -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Máy chủ Dịch vụ (Backend API)" FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="BackendBadgeBorder" DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                <TextBlock x:Name="BackendBadgeText" Text="Đang hoạt động" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A"/>
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                <TextBlock Text="Địa chỉ kết nối:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="BackendUrlTextBlock" Text="http://localhost:39090/api/v1" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="Độ trễ phản hồi (Latency):" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="BackendLatencyTextBlock" Text="-- ms" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Mã phản hồi HTTP:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="BackendStatusCodeTextBlock" Text="200 OK" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Thời gian máy chủ:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="BackendServerTimeTextBlock" Text="--" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- HẠNG MỤC 2: CƠ SỞ DỮ LIỆU POSTGRESQL -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗄️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Cơ sở dữ liệu (PostgreSQL Database)" FontSize="14.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border x:Name="DbBadgeBorder" DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="6" Padding="10,3">
                                <TextBlock x:Name="DbBadgeText" Text="Đã kết nối" FontSize="12" FontWeight="SemiBold" Foreground="#16A34A"/>
                            </Border>
                        </DockPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                <TextBlock Text="Tên Database:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="DbNameTextBlock" Text="servermanagerbilling" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="Dung lượng Database:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="DbSizeTextBlock" Text="-- MB" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Tốc độ truy vấn SQL:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="DbQueryLatencyTextBlock" Text="-- ms" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Tình trạng các bảng:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="DbTablesStatusTextBlock" Text="Sẵn sàng" FontSize="12.5" FontWeight="Medium" Foreground="#1E293B"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- HẠNG MỤC 3: KÊNH REALTIME & MÁY TRẠM -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Cột Realtime -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kênh Realtime" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="RealtimeBadgeBorder" DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="5" Padding="8,2">
                                    <TextBlock x:Name="RealtimeBadgeText" Text="Đã kết nối" FontSize="11.5" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="RealtimeDescTextBlock" Text="Đang đồng bộ máy trạm thời gian thực" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Cột Máy trạm -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Máy trạm phòng nét" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#EFF6FF" CornerRadius="5" Padding="8,2">
                                    <TextBlock x:Name="PcOnlineCountBadgeText" Text="-- Online" FontSize="11.5" FontWeight="SemiBold" Foreground="#2563EB"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="PcSummaryTextBlock" Text="Tổng số máy trạm: --" FontSize="12" Foreground="#64748B" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KHUNG CHẨN ĐOÁN LỖI & HƯỚNG DẪN XỬ LÝ -->
                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="💡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Gợi ý &amp; Đánh giá từ Hệ thống:" FontSize="13" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DiagnosticSuggestionTextBlock"
                                   Text="Đang chẩn đoán tình trạng hệ thống..."
                                   FontSize="12.5"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 4. FOOTER ACTION BUTTONS -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <!-- Nút chẩn đoán lại và nút Tự động sửa chữa bên trái -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RecheckHealthButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RecheckHealthButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kiểm tra lại" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AutoRepairButton"
                            Style="{StaticResource AutoRepairButtonStyle}"
                            Margin="10,0,0,0"
                            Click="AutoRepairButton_Click"
                            ToolTip="Tự động kiểm tra PostgreSQL, khởi động lại Backend và nạp lại toàn bộ dữ liệu">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tự động sửa chữa (1-Click)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nút copy và đóng bên phải -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyReportButton"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="0,0,10,0"
                            Click="CopyReportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sao chép báo cáo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Đóng"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Width="80"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
