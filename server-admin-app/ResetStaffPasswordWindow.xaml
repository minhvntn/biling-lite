<Window x:Class="Server.Admin.App.ResetStaffPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu tài khoản" Height="330" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F9FAFB">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeaderTextBlock" Text="Đổi mật khẩu" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="#1E293B"/>
            
            <TextBlock Text="Mật khẩu mới" Margin="0,0,0,5" Foreground="#4B5563" FontWeight="SemiBold" FontSize="13"/>
            <PasswordBox x:Name="NewPasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,12"/>
            
            <TextBlock Text="Xác nhận mật khẩu mới" Margin="0,0,0,5" Foreground="#4B5563" FontWeight="SemiBold" FontSize="13"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,0,20"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="84" Height="34" Margin="0,0,10,0" Click="CancelButton_Click" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#374151" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="SaveButton" Content="Lưu mật khẩu" Width="120" Height="34" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Click="SaveButton_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
            
            <TextBlock x:Name="StatusTextBlock" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
