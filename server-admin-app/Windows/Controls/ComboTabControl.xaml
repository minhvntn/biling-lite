<UserControl x:Class="Server.Admin.App.Windows.Controls.ComboTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F5F7FA">
    <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabControl_SelectionChanged">
        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="20,10" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="#1E5AA8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </TabControl.Resources>

        <TabItem Header="Cấu hình &amp; Bán Thẻ">
            <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Combo Packages -->
        <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,10,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Cấu hình Gói Combo" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button x:Name="BtnAddCombo" Content="Thêm Gói Mới" Margin="20,0,0,0" Padding="15,8" Background="#1E5AA8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddCombo_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <DataGrid x:Name="GridCombos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          Background="Transparent" BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="45">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Sửa" Click="MenuItemEditCombo_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên gói" Binding="{Binding name}" Width="2*" />
                        <DataGridTextColumn Header="Giá (VND)" Binding="{Binding price, StringFormat={}{0:N0}}" Width="1*" />
                        <DataGridTextColumn Header="Giờ BĐ" Binding="{Binding startTime}" Width="1*" />
                        <DataGridTextColumn Header="Giờ KT" Binding="{Binding endTime}" Width="1*" />
                        <DataGridTextColumn Header="Hạn (Ngày)" Binding="{Binding validityDays}" Width="1*" />
                        <DataGridTemplateColumn Header="Thao tác" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Xóa" Click="BtnDeleteCombo_Click" Tag="{Binding id}" Background="#DC2626" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right Column: Generate Combo Cards -->
        <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="10,0,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Bán Thẻ Combo" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,20" />

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Chọn gói Combo:" Margin="0,0,0,5" Foreground="#64748B" />
                    <ComboBox x:Name="CboComboPackages" DisplayMemberPath="name" SelectedValuePath="id" Margin="0,0,0,15" Height="35" Padding="5" />

                    <TextBlock Text="Số lượng thẻ (1-100):" Margin="0,0,0,5" Foreground="#64748B" />
                    <TextBox x:Name="TxtQuantity" Text="1" Margin="0,0,0,15" Height="35" Padding="5" VerticalContentAlignment="Center" />

                    <Button x:Name="BtnGenerate" Content="Tạo Thẻ (Bán Mới)" Height="45" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="15" FontWeight="SemiBold" Click="BtnGenerate_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Results Area -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Danh sách tài khoản vừa tạo:" Foreground="#64748B" Margin="0,0,0,10" />
                    <TextBox x:Name="TxtGeneratedResults" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" 
                             FontFamily="Consolas" Background="#F8FAFC" BorderBrush="#E2E8F0" Padding="10" />
                </Grid>
            </Grid>
        </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Danh sách thẻ Combo đã tạo" x:Name="TabComboCards">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Danh sách các tài khoản Combo trên hệ thống" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button x:Name="BtnRefreshCards" Content="Làm mới" Margin="20,0,0,0" Padding="15,8" Background="#F1F5F9" Foreground="#1E293B" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnRefreshCards_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <DataGrid x:Name="GridComboCards" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          Background="White" BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="45">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tài khoản" Binding="{Binding username}" Width="1*" />
                        <DataGridTextColumn Header="Giá (VND)" Binding="{Binding balance, StringFormat={}{0:N0}}" Width="1*" />
                        <DataGridTextColumn Header="TG Bắt đầu" Binding="{Binding createdAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1*" />
                        <DataGridTextColumn Header="TG Kết thúc" Binding="{Binding comboExpiresAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1*" />
                        <DataGridTextColumn Header="Thời lượng (h)" Binding="{Binding playHours}" Width="1*" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding status}" Width="1*" />
                        <DataGridTemplateColumn Header="Thao tác" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Xóa" Click="BtnDeleteComboCard_Click" Tag="{Binding id}" Background="#DC2626" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
        <TabItem Header="Combo tạo sẵn" x:Name="TabPreGeneratedCombos">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Danh sách thẻ Combo sẵn sàng" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" />
                    <Button x:Name="BtnGeneratePreCombos" Content="Tạo mới toàn bộ" Margin="20,0,0,0" Padding="15,8" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnGeneratePreCombos_Click" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <DataGrid x:Name="GridPreGeneratedCombos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          Background="White" BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="45"
                          MouseDoubleClick="GridPreGeneratedCombos_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên gói" Binding="{Binding comboName}" Width="1.5*" />
                        <DataGridTextColumn Header="Tài khoản" Binding="{Binding username}" Width="1*" />
                        <DataGridTextColumn Header="Giá (VND)" Binding="{Binding price, StringFormat={}{0:N0}}" Width="1*" />
                        <DataGridTextColumn Header="Giờ BĐ" Binding="{Binding startTime}" Width="0.8*" />
                        <DataGridTextColumn Header="Giờ KT" Binding="{Binding endTime}" Width="0.8*" />
                        <DataGridTextColumn Header="Lượng (h)" Binding="{Binding durationHours}" Width="0.8*" />
                        <DataGridTextColumn Header="Hạn (Ngày)" Binding="{Binding validityDays}" Width="1*" />
                        <DataGridTextColumn Header="Hạn dùng đến" Binding="{Binding expiresAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
