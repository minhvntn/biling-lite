<Window x:Class="Server.Admin.App.Windows.AddComboWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Gói Combo" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Tên gói Combo:" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtName" Grid.Row="1" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="2" Text="Giá tiền (VND):" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtPrice" Grid.Row="3" Height="35" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center" Text="30000"/>

        <Grid Grid.Row="4" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Giờ bắt đầu (HH:mm):" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboStartTime" Height="35" Padding="5" VerticalContentAlignment="Center" IsEditable="True" Text="22:00"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Giờ kết thúc (HH:mm):" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboEndTime" Height="35" Padding="5" VerticalContentAlignment="Center" IsEditable="True" Text="06:00"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Số ngày dùng (Valid Days):" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtValidityDays" Padding="5" Height="35" VerticalContentAlignment="Center" Text="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Thời lượng giới hạn (giờ):" Margin="0,0,0,5" Foreground="#1E293B" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtDurationHours" Padding="5" Height="35" VerticalContentAlignment="Center" ToolTip="Để trống hoặc 0 nếu muốn chơi không giới hạn thời gian" Text="0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Width="80" Height="35" Margin="0,0,10,0" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Lưu lại" Width="100" Height="35" Background="#1E5AA8" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
