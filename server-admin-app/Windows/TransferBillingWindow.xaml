<Window x:Class="Server.Admin.App.Windows.TransferBillingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán tới máy khác"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Background="White"
            CornerRadius="14"
            BorderBrush="#CBD5E1"
            BorderThickness="1"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="25" ShadowDepth="6" Opacity="0.18" />
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#EDE9FE" Margin="0,0,12,0">
                    <TextBlock Text="⇄" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Thanh toán tới máy khác" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                    <TextBlock Text="Cộng dồn tiền giờ &amp; dịch vụ sang máy khác thanh toán" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2" 
                        Width="32" Height="32" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="6" x:Name="CloseBorder">
                                <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Main Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Khung nguồn -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MÁY CHUYỂN (NGUỒN):" FontSize="12" FontWeight="Bold" Foreground="#64748B" />
                                    <Border Background="#EDE9FE" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                                        <TextBlock x:Name="SourceMachineNameTextBlock" Text="Máy 01" FontSize="13.5" FontWeight="Bold" Foreground="#7C3AED" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="SourceCustomerNameTextBlock" Text="Khách vãng lai" FontSize="13" Foreground="#334155" FontWeight="SemiBold" />
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,4,0,8" />

                            <!-- Tiền giờ -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tiền giờ chơi:" FontSize="13" Foreground="#475569" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock x:Name="SourcePlayAmountTextBlock" Text="0 VND" FontSize="13" FontWeight="SemiBold" Foreground="#EA580C" />
                                    <TextBlock x:Name="SourcePlayDurationTextBlock" Text=" (0 phút)" FontSize="12" Foreground="#94A3B8" Margin="4,1,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Tiền dịch vụ -->
                            <Grid Margin="0,4,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tiền dịch vụ (chưa trả):" FontSize="13" Foreground="#475569" />
                                <TextBlock Grid.Column="1" x:Name="SourceServiceAmountTextBlock" Text="0 VND" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" />
                            </Grid>

                            <!-- Chi tiết món dịch vụ -->
                            <TextBlock x:Name="SourceServiceSummaryTextBlock" 
                                       Text="Không có dịch vụ" 
                                       FontSize="11" 
                                       Foreground="#64748B" 
                                       FontStyle="Italic" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,4" />

                            <!-- Tiền gộp trước đó nếu có -->
                            <Grid x:Name="SourcePreviousTransferredRow" Margin="0,2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Khoản đã cộng dồn trước đó:" FontSize="13" Foreground="#475569" />
                                <TextBlock Grid.Column="1" x:Name="SourcePreviousTransferredAmountTextBlock" Text="0 VND" FontSize="13" FontWeight="SemiBold" Foreground="#6D28D9" />
                            </Grid>

                            <Separator Background="#CBD5E1" Margin="0,8,0,8" />

                            <!-- Tổng tiền chuyển -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TỔNG TIỀN CHUYỂN:" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="SourceTotalAmountTextBlock" Text="0 VND" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Khung chọn máy đích -->
                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="CHỌN MÁY NHẬN THANH TOÁN (CỘNG DỒN VÀO):" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,8" />

                            <ComboBox x:Name="TargetMachineComboBox" 
                                      Height="46" 
                                      FontSize="14"
                                      MaxDropDownHeight="360"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="TargetMachineComboBox_SelectionChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="MinHeight" Value="46" />
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Setter Property="BorderBrush" Value="#F1F5F9" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Tên máy to rõ -->
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="15" 
                                                       FontWeight="Bold" 
                                                       Foreground="#0F172A" 
                                                       VerticalAlignment="Center" />
                                            
                                            <!-- Badge VIP / Khách vãng lai -->
                                            <Border Grid.Column="1" 
                                                    Background="{Binding BadgeBackground}" 
                                                    BorderBrush="{Binding BadgeBorderBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="8,3" 
                                                    Margin="0,0,12,0" 
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BadgeText}" 
                                                           FontSize="12" 
                                                           FontWeight="Bold" 
                                                           Foreground="{Binding BadgeForeground}" />
                                            </Border>
                                            
                                            <!-- Tên khách / Hội viên & Thời gian chơi -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserDisplayName}" 
                                                           FontSize="14" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="#1E293B" 
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" • " 
                                                           FontSize="13" 
                                                           Foreground="#94A3B8" 
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DurationText}" 
                                                           FontSize="13" 
                                                           Foreground="#64748B" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Ghi chú chuyển (không bắt buộc):" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,12,0,4" />
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Height="38" Background="White">
                                <TextBox x:Name="NoteTextBox" 
                                         VerticalContentAlignment="Center" 
                                         FontSize="13"
                                         Padding="8,0" 
                                         BorderThickness="0" 
                                         Background="Transparent" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lưu ý -->
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" 
                                       Text="Sau khi xác nhận, máy chuyển sẽ được KẾT THÚC PHIÊN VÀ KHÓA MÁY ngay lập tức. Toàn bộ tiền giờ và dịch vụ sẽ được cộng dồn vào hóa đơn thanh toán của máy đích." 
                                       FontSize="11.5" 
                                       Foreground="#92400E" 
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Error / Status -->
                    <TextBlock x:Name="StatusTextBlock" 
                               Margin="0,8,0,0" 
                               FontSize="12" 
                               Foreground="#DC2626" 
                               TextWrapping="Wrap" 
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- 3. Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.5*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Height="44" 
                        Content="Hủy bỏ" 
                        FontSize="14"
                        Background="#F1F5F9" 
                        Foreground="#475569" 
                        FontWeight="SemiBold" 
                        BorderBrush="#CBD5E1" 
                        BorderThickness="1" 
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2" 
                        x:Name="ConfirmTransferButton"
                        Height="44" 
                        Content="Xác nhận chuyển &amp; Khóa máy" 
                        FontSize="14"
                        Background="#7C3AED" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="ConfirmTransferButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
