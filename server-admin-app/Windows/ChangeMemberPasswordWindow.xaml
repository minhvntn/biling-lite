<Window x:Class="Server.Admin.App.Windows.ChangeMemberPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi mật khẩu hội viên" Height="340" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PrimaryColor" Color="#8B5CF6" />
        <SolidColorBrush x:Key="TextMain" Color="#1E293B" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Body -->
                <RowDefinition Height="64"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="18,0" Background="#FAF5FF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="6" Background="#EDE9FE" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="🔑" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Đổi mật khẩu hội viên" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="CancelButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="28" Height="28">
                        <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="22,16,22,12">
                <!-- Member Summary Card -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="👤" FontSize="18" Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Tài khoản: " FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="MemberUsernameTextBlock" Text="-" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMain}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Họ tên: " FontSize="12" Foreground="{StaticResource TextMuted}" />
                                <TextBlock x:Name="MemberFullNameTextBlock" Text="-" FontSize="12" Foreground="{StaticResource TextMain}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- New Password Field -->
                <TextBlock Text="Mật khẩu mới" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,0,0,5" />
                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Background="White" Height="42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="🔒" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                        
                        <PasswordBox x:Name="NewPasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="14" VerticalContentAlignment="Center" Padding="4,0,4,0" KeyDown="PasswordInput_KeyDown" />
                        <TextBox x:Name="NewPasswordVisibleBox" Grid.Column="1" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="14" VerticalContentAlignment="Center" Padding="4,0,4,0" KeyDown="PasswordInput_KeyDown" />

                        <Button Grid.Column="2" Click="TogglePasswordVisibility_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Hiển thị / Ẩn mật khẩu">
                            <TextBlock x:Name="EyeIconTextBlock" Text="👁️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Quick shortcut -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Mẹo: " FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <Button Click="SetDefaultPassword_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0">
                        <TextBlock Text="Đặt mật khẩu mặc định: 123456" FontSize="11.5" Foreground="{StaticResource PrimaryColor}" TextDecorations="Underline" />
                    </Button>
                </StackPanel>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="#EF4444" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="18,0" CornerRadius="0,0,12,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Hủy" Click="CancelButton_Click" IsCancel="True" Width="85" Height="36" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMuted}" Cursor="Hand" Margin="0,0,10,0" Template="{StaticResource RoundedButtonTemplate}" />
                    <Button x:Name="SaveButton" Content="Lưu mật khẩu" Click="SaveButton_Click" IsDefault="True" Width="120" Height="36" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Template="{StaticResource RoundedButtonTemplate}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

