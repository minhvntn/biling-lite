<Window x:Class="Server.Admin.App.Windows.PayServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán dịch vụ" Height="750" Width="1100"
        WindowStartupLocation="CenterOwner"
        FontSize="16" FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#1E293B" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" x:FieldModifier="public" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" />
        
        <TextBlock x:Name="SummaryTextBlock" Grid.Row="1" x:FieldModifier="public" FontSize="16" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16" />
        
        <DataGrid x:Name="OrdersGrid" x:FieldModifier="public" Grid.Row="2" Margin="0,0,0,20"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" RowHeight="44">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Chọn" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" Margin="0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Dịch vụ" Width="2*" Binding="{Binding ServiceName}" IsReadOnly="True" />
                <DataGridTextColumn Header="SL" Width="80" Binding="{Binding Quantity}" IsReadOnly="True" />
                <DataGridTextColumn Header="Đơn giá" Width="150" Binding="{Binding UnitPriceText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Thành tiền" Width="160" Binding="{Binding LineTotalText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Thời gian gọi" Width="200" Binding="{Binding CreatedAtText}" IsReadOnly="True" />
                <DataGridTextColumn Header="Ghi chú" Width="2*" Binding="{Binding Note}" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        
        <TextBlock x:Name="StatusTextBlock" x:FieldModifier="public" Grid.Row="3" FontSize="16" Foreground="#64748B" Margin="0,0,0,20" TextWrapping="Wrap"
                   Text="Chọn món cần thu rồi bấm &quot;Thanh toán món đã chọn&quot;. Có thể lặp lại nhiều lần cho đến khi hết món." />
                   
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SelectAllButton" x:FieldModifier="public" Content="Chọn tất cả" Width="140" />
            <Button x:Name="ClearSelectionButton" x:FieldModifier="public" Content="Bỏ chọn" Width="120" Margin="0,0,24,0" />
            <Button x:Name="PaySelectedButton" x:FieldModifier="public" Content="Thanh toán món đã chọn" Width="260" Background="#22C55E" Foreground="White" FontWeight="Bold" BorderThickness="0" />
            <Button x:Name="PayAllButton" x:FieldModifier="public" Content="Thanh toán tất cả" Width="220" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" />
            <Button x:Name="CloseButton" x:FieldModifier="public" Content="Đóng" Width="120" IsCancel="True" Margin="24,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
