<Window x:Class="Server.Admin.App.Windows.SelectServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:local="clr-namespace:Server.Admin.App"
        Title="Chọn dịch vụ máy trạm"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="1240"
        Height="780"
        MinWidth="1080"
        MinHeight="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- DataGrid Column Header Style -->
        <Style x:Key="ModernDataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- DataGrid Row Style -->
        <Style x:Key="ModernDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="56"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F7FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Cell Style -->
        <Style x:Key="ModernDataGridCell" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stepper Button Style -->
        <Style x:Key="StepperButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Window Container with Rounded Border -->
    <Border Background="#F8FAFC"
            CornerRadius="16"
            BorderBrush="#CBD5E1"
            BorderThickness="1">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0. Header Bar -->
                <RowDefinition Height="*"/>    <!-- 1. Two-Column Main Content -->
                <RowDefinition Height="Auto"/> <!-- 2. Footer Summary & Actions -->
            </Grid.RowDefinitions>

            <!-- ================= 0. HEADER BAR ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                    <svgc:SvgViewbox Source="/Assets/payment/service.svg" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Machine Badge -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Chọn dịch vụ gọi món" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border x:Name="MachineNameBadge" Background="#2563EB" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <svgc:SvgViewbox Source="/Assets/payment/pc.svg" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock x:Name="MachineNameText" Text="Máy 01" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Bấm + để thêm món mới, bấm - để hủy món đã gọi (tối đa bằng số lượng chưa thanh toán)."
                               FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Top Right Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Width="36" Height="36" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="MaximizeButton_Click" ToolTip="Phóng to / Thu nhỏ">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock x:Name="MaximizeButtonIcon" Text="🗖" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Width="36" Height="36" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" ToolTip="Đóng">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 1. TWO-COLUMN MAIN CONTENT ================= -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/> <!-- Left Panel -->
                    <ColumnDefinition Width="*"/>   <!-- Right Panel (Catalog) -->
                </Grid.ColumnDefinitions>

                <!-- ================= LEFT PANEL ================= -->
                <Grid Grid.Column="0" Margin="0,0,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Previous Orders Card -->
                        <RowDefinition Height="*"/>    <!-- Pending Client Orders Card -->
                    </Grid.RowDefinitions>

                    <!-- CARD 1: PREVIOUSLY ORDERED SERVICES -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📋" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ĐÃ GỌI TRƯỚC ĐÓ" FontSize="12.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Border x:Name="PreviousOrdersCountBadge" Background="#EFF6FF" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="PreviousOrdersCountText" Text="0 món" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="PreviousOrdersTotalAmountText" Text="0 đ" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Items List -->
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- Items Control for Previously Ordered Items -->
                                    <ItemsControl x:Name="PreviousOrdersItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ServiceName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SourceDetailText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" Margin="0,0,0,2">
                                                                <TextBlock Text="{Binding QuantityText}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding AmountText}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty State for Previous Orders -->
                                    <Border x:Name="PreviousOrdersEmptyState" Visibility="Collapsed" Padding="16,14" Background="#F8FAFC" CornerRadius="8" BorderBrush="#F1F5F9" BorderThickness="1">
                                        <TextBlock Text="Chưa có dịch vụ nào đã gọi trên máy này." FontSize="12.5" Foreground="#94A3B8" FontStyle="Italic" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: PENDING CLIENT ORDERS -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Card Header -->
                                <RowDefinition Height="*"/>    <!-- Orders Grid / Empty State -->
                                <RowDefinition Height="Auto"/> <!-- Pending Summary -->
                                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ORDER CHỜ TỪ KHÁCH" FontSize="12.5" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Border x:Name="PendingOrdersBadge" Background="#FEF3C7" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="PendingOrdersBadgeText" Text="0 chờ duyệt" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- DataGrid for Pending Orders -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <DataGrid x:Name="PendingOrdersDataGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserReorderColumns="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9"
                                              ColumnHeaderStyle="{StaticResource ModernDataGridHeader}"
                                              RowStyle="{StaticResource ModernDataGridRow}"
                                              CellStyle="{StaticResource ModernDataGridCell}"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ScrollViewer.CanContentScroll="True"
                                              FontSize="13">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="46">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox x:Name="SelectAllPendingCheckBox"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Cursor="Hand"
                                                              Click="SelectAllPendingCheckBox_Click">
                                                        <CheckBox.LayoutTransform>
                                                            <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                        </CheckBox.LayoutTransform>
                                                    </CheckBox>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Cursor="Hand">
                                                            <CheckBox.LayoutTransform>
                                                                <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                                                            </CheckBox.LayoutTransform>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Món" Binding="{Binding ServiceName}" Width="1.4*" IsReadOnly="True" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="SL" Binding="{Binding QuantityText}" Width="45" IsReadOnly="True" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Tiền" Binding="{Binding AmountText}" Width="80" IsReadOnly="True" FontWeight="SemiBold"/>
                                            <DataGridTextColumn Header="Lúc" Binding="{Binding CreatedAtText}" Width="65" IsReadOnly="True" Foreground="#64748B"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Empty State for Pending Orders -->
                                    <Border x:Name="PendingOrdersEmptyState" Visibility="Collapsed" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" VerticalAlignment="Center" Margin="12">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="✓ Không có order chờ từ máy trạm" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Khách chưa gửi yêu cầu gọi món nào." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Pending Summary Text -->
                            <TextBlock Grid.Row="2" x:Name="PendingOrderSummaryTextBlock"
                                       FontSize="12" Foreground="#64748B" Margin="0,8,0,8"
                                       TextWrapping="Wrap"/>

                            <!-- Actions for Pending Orders -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ConfirmPendingButton"
                                        Content="✓ Xác nhận đã chọn"
                                        Height="36"
                                        Background="#10B981" Foreground="White"
                                        FontWeight="SemiBold" FontSize="12.5"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="ConfirmPendingButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Grid.Column="2" x:Name="CancelPendingButton"
                                        Content="✕ Hủy đã chọn"
                                        Height="36"
                                        Background="#EF4444" Foreground="White"
                                        FontWeight="SemiBold" FontSize="12.5"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="CancelPendingButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= RIGHT PANEL (SERVICE CATALOG) ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Category Filter Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Services DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- TOOLBAR: SEARCH & CATEGORY CHIPS -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search Input -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Height="40" Padding="8,0" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                    <TextBox Grid.Column="1" x:Name="SearchTextBox"
                                             VerticalAlignment="Center"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="14"
                                             Foreground="#0F172A"
                                             TextChanged="SearchTextBox_TextChanged"/>
                                    <TextBlock Grid.Column="1" x:Name="SearchPlaceholder"
                                               Text="Tìm kiếm nhanh theo tên món hoặc danh mục..."
                                               FontSize="13.5"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Margin="2,0,0,0"/>
                                    <Button Grid.Column="2" x:Name="ClearSearchButton"
                                            Visibility="Collapsed"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="6"
                                            Click="ClearSearchButton_Click">
                                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#94A3B8"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Category Chips -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CategoryChipsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayText}"
                                                    Background="{Binding Background}"
                                                    Foreground="{Binding Foreground}"
                                                    BorderBrush="{Binding BorderBrush}"
                                                    BorderThickness="1"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Padding="12,5"
                                                    Margin="0,0,8,0"
                                                    Cursor="Hand"
                                                    Click="CategoryChip_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="14"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- MAIN SERVICES DATAGRID -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <DataGrid x:Name="ServicesDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeader}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      RowHeight="58"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="False"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="3,3"
                                      VirtualizingPanel.CacheLengthUnit="Item"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.IsDeferredScrollingEnabled="False"
                                      PreviewMouseWheel="ServicesDataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <!-- 1. Dịch vụ (Hình ảnh + Tên) -->
                                    <DataGridTemplateColumn Header="Tên dịch vụ" Width="2.3*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Image / Fallback Icon -->
                                                    <Border Width="44" Height="44" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F1F5F9" Margin="0,0,12,0" ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding ServiceImageSource}"
                                                                   Stretch="UniformToFill"
                                                                   SnapsToDevicePixels="True"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>
                                                            <!-- Fallback Icon if no image -->
                                                            <TextBlock Text="🏷️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Service Name & Previous info -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ServiceName}" FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <!-- Previous order badge if any -->
                                                            <Border Background="#FEF3C7" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasPreviousOrders}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding PreviouslyOrderedText, StringFormat='Đã gọi: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#B45309"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 2. Danh mục -->
                                    <DataGridTemplateColumn Header="Danh mục" Width="1.1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding CategoryBgBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding CategoryFgBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 3. Đơn giá -->
                                    <DataGridTemplateColumn Header="Đơn giá" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitPriceText, StringFormat='{}{0} đ'}"
                                                           FontSize="14.5" FontWeight="SemiBold" Foreground="#334155"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 4. Số lượng (Stepper To, Rõ, Đẹp) -->
                                    <DataGridTemplateColumn Header="Số lượng" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8"
                                                        Height="36" Width="134" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="34"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Minus Button -->
                                                        <Button Grid.Column="0" Content="−"
                                                                Style="{StaticResource StepperButtonStyle}"
                                                                Background="#EF4444" Foreground="White"
                                                                BorderThickness="0" Margin="2"
                                                                Click="DecreaseQuantityButton_Click"
                                                                ToolTip="Giảm / Hủy số lượng đã gọi"/>

                                                        <!-- Quantity Text Display -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                                   Foreground="{Binding QuantityForeground}"
                                                                   FontSize="16" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <!-- Plus Button -->
                                                        <Button Grid.Column="2" Content="+"
                                                                Style="{StaticResource StepperButtonStyle}"
                                                                Background="#10B981" Foreground="White"
                                                                BorderThickness="0" Margin="2"
                                                                Click="IncreaseQuantityButton_Click"
                                                                ToolTip="Thêm món gọi mới"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 5. Thành tiền -->
                                    <DataGridTemplateColumn Header="Thành tiền" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LineTotalText}"
                                                           Foreground="{Binding LineTotalForeground}"
                                                           FontSize="15" FontWeight="Bold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty Catalog Filter State -->
                            <Border x:Name="CatalogEmptyState" Visibility="Collapsed" Background="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Không tìm thấy dịch vụ nào phù hợp" FontSize="15" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Vui lòng thử từ khóa tìm kiếm hoặc chọn danh mục khác." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= 2. FOOTER: SUMMARY CARDS & MAIN ACTIONS ================= -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Real-time Metric Summary Badges -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Add Metric -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm:" FontSize="13" Foreground="#15803D" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="AddSummaryText" Text="0 món • 0 đ" FontSize="13.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Cancel Metric -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="➖" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hủy:" FontSize="13" Foreground="#B91C1C" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="CancelSummaryText" Text="0 món • 0 đ" FontSize="13.5" FontWeight="Bold" Foreground="#B91C1C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Net Total Amount -->
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="CHÊNH LỆCH THANH TOÁN:" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="NetAmountText" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Main Buttons & Error Text -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="280"/>

                        <!-- Cancel Button -->
                        <Button Content="Đóng / Hủy"
                                Width="110" Height="42"
                                Background="White" Foreground="#475569"
                                BorderBrush="#CBD5E1" BorderThickness="1"
                                FontWeight="SemiBold" FontSize="14"
                                Cursor="Hand" Margin="0,0,10,0"
                                Click="CloseButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Update Machine Orders Button -->
                        <Button x:Name="SubmitButton"
                                Content="✓ Cập nhật máy"
                                Width="170" Height="42"
                                Background="#2563EB" Foreground="White"
                                BorderThickness="0"
                                FontWeight="Bold" FontSize="14.5"
                                Cursor="Hand"
                                Click="SubmitButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

