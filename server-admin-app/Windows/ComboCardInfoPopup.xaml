<Window x:Class="Server.Admin.App.Windows.ComboCardInfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin thẻ Combo" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">

    <Border Margin="14" Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="26" ShadowDepth="5" Opacity="0.16" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Voucher Header -->
                <RowDefinition Height="Auto"/> <!-- Credentials Card -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Voucher Header Banner -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,18,20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#3B82F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="White" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="🎟️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="THẺ COMBO HỘI VIÊN" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <Border Background="#312E81" CornerRadius="10" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtComboName" Text="Gói: Combo Đêm" FontSize="12" FontWeight="SemiBold" Foreground="#E0E7FF"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Credentials Body -->
            <StackPanel Grid.Row="1" Margin="22,18,22,16">
                <!-- Account Box -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tài khoản:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="TxtUsername" Grid.Column="1" Text="COMBO107" FontSize="18" FontWeight="Bold" Foreground="#2563EB" 
                                 BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Password Box -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mật khẩu:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox x:Name="TxtPassword" Grid.Column="1" Text="3725" FontSize="20" FontWeight="Bold" Foreground="#DC2626" 
                                 FontFamily="Consolas" BorderThickness="0" Background="Transparent" IsReadOnly="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Expiry Date -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="🕒 Hạn sử dụng:" FontSize="12" Foreground="#64748B" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtExpiresAt" Text="06/06/2026 09:00" FontSize="12.5" FontWeight="Bold" Foreground="#059669"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,16,16">
                <Button Content="Đóng" MinHeight="36" FontSize="13" FontWeight="SemiBold" Foreground="White" Background="#2563EB" 
                        Padding="20,0" Cursor="Hand" Click="BtnClose_Click" BorderThickness="0" IsDefault="True">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
