<Window x:Class="Server.Admin.App.Windows.ComboCardInfoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin thẻ Combo" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Border Padding="30" Background="White" CornerRadius="12" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#CBD5E1" BlurRadius="12" ShadowDepth="3" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="Thông tin tài khoản Combo" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" HorizontalAlignment="Center" />
            <TextBlock x:Name="TxtComboName" Text="Gói: Combo Đêm" FontSize="18" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,30" />

            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tài khoản:" FontSize="22" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,15,15" />
                <TextBox x:Name="TxtUsername" Grid.Row="0" Grid.Column="1" Text="combo107" FontSize="24" FontWeight="Bold" Foreground="#1E5AA8" BorderThickness="0" Background="Transparent" IsReadOnly="True" Margin="0,0,0,15" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mật khẩu:" FontSize="22" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,15,15" />
                <TextBox x:Name="TxtPassword" Grid.Row="1" Grid.Column="1" Text="3725" FontSize="24" FontWeight="Bold" Foreground="#DC2626" BorderThickness="0" Background="Transparent" IsReadOnly="True" Margin="0,0,0,15" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Hạn dùng:" FontSize="20" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,15,0" />
                <TextBlock x:Name="TxtExpiresAt" Grid.Row="2" Grid.Column="1" Text="06/06/2026 09:00" FontSize="20" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
            </Grid>

            <Button Content="Đóng" MinHeight="50" FontSize="20" FontWeight="SemiBold" Foreground="White" Background="#1E5AA8" Padding="15,10" Cursor="Hand" Click="BtnClose_Click" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Border>
</Window>
