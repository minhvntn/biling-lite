<Window x:Class="Server.Admin.App.Windows.EditMemberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Thông tin hội viên" Height="580" Width="1050"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#F8FAFC" />
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PrimaryColor" Color="#8B5CF6" />
        <SolidColorBrush x:Key="PrimaryHoverColor" Color="#7C3AED" />
        <SolidColorBrush x:Key="TextMain" Color="#1E293B" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />
        <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ReadOnlyInputBg" Color="#F8FAFC" />
        
        <!-- Input Field Style -->
        <Style x:Key="IconTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0,10,0" />
        </Style>

        <Style x:Key="IconComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0,10,0" />
        </Style>
        
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,4,0,16" />
        </Style>

        <!-- Buttons -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="{StaticResource MainBg}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- Title Bar -->
                <RowDefinition Height="*"/> <!-- Content -->
                <RowDefinition Height="70"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="🖥️" FontSize="18" Foreground="{StaticResource PrimaryColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Thông tin hội viên" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand">
                            <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                
                <!-- THÔNG TIN CÁ NHÂN -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#F5F3FF" Margin="0,0,12,0">
                                <TextBlock Text="👤" FontSize="20" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="THÔNG TIN CÁ NHÂN" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryColor}" />
                                <TextBlock Text="Cập nhật đầy đủ thông tin cá nhân của hội viên" FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Username -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Username" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}" Background="{StaticResource ReadOnlyInputBg}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👤" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" IsReadOnly="True" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Họ tên -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Họ tên" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👤" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="FullNameBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Số điện thoại -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Số điện thoại" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📞" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="PhoneBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- CCCD/CMND -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="CCCD/CMND" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🪪" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="IdentityBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Số dư -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Số dư (VND)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👛" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="BalanceBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Điểm tích lũy -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Điểm tích lũy" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⭐" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="PointsBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Bậc VIP -->
                            <Border Grid.Row="3" Grid.Column="0" Background="#F5F3FF" CornerRadius="8" Padding="12" Margin="0,4,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="👑" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Bậc VIP: " FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMain}" />
                                            <TextBlock x:Name="RankTextBlock" Text="Thường" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryColor}" />
                                        </StackPanel>
                                        <TextBlock x:Name="LifetimeTopupTextBlock" Text="Tổng nạp: 0 VND" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tổng nạp -->
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="Tổng nạp (VND)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="👛" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="TotalTopupBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </StackPanel>
                </Border>


                <!-- THÔNG TIN TÀI KHOẢN -->
                <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#F5F3FF" Margin="0,0,12,0">
                                <TextBlock Text="🛡️" FontSize="20" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="THÔNG TIN TÀI KHOẢN" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryColor}" />
                                <TextBlock Text="Cài đặt bảo mật" FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Loại hội viên -->
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Loại hội viên" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🛡️" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <ComboBox x:Name="MemberTypeComboBox" Grid.Column="1" Style="{StaticResource IconComboBoxStyle}" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Thường" Tag="REGULAR" />
                                            <ComboBoxItem Content="VIP" Tag="VIP" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Lần đăng nhập gần đây -->
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Lần đăng nhập gần đây" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}" Background="{StaticResource ReadOnlyInputBg}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📅" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="LastLoginBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" IsReadOnly="True" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Tổng thời gian sử dụng máy -->
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Tổng thời gian sử dụng máy" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}" Background="{StaticResource ReadOnlyInputBg}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⏱️" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <TextBox x:Name="TotalUsageBox" Grid.Column="1" Style="{StaticResource IconTextBoxStyle}" IsReadOnly="True" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            
                            <!-- Đổi mật khẩu -->
                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Đổi mật khẩu" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" />
                                <Border Style="{StaticResource InputBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔒" Grid.Column="0" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        <PasswordBox x:Name="PasswordBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="14" VerticalContentAlignment="Center" Padding="5,0,10,0" />
                                        <TextBlock Text="👁️" Grid.Column="2" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Cursor="Hand" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            
                            <CheckBox x:Name="StatusCheckBox" Grid.Row="4" Content="Tài khoản đang hoạt động" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,16" />
                            
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                <Grid>
                    <TextBlock x:Name="ErrorTextBlock" Foreground="Firebrick" VerticalAlignment="Center" Margin="20,0,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="✕ Hủy" Width="100" Height="40" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMain}" FontWeight="SemiBold" Margin="0,0,10,0" Template="{StaticResource RoundedButtonTemplate}" Click="CancelButton_Click" IsCancel="True" Cursor="Hand"/>
                        <Button Content="💾 Lưu" Width="110" Height="40" Background="{StaticResource PrimaryColor}" Foreground="White" FontWeight="Bold" BorderThickness="0" Template="{StaticResource RoundedButtonTemplate}" Click="SaveButton_Click" IsDefault="True" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
