<Window x:Class="Server.Admin.App.Windows.ConnectionErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lỗi kết nối máy chủ" Height="320" Width="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextMain" Color="#1E293B" />
        <SolidColorBrush x:Key="TextMuted" Color="#64748B" />

        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Opacity" Value="0.9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="White" CornerRadius="12" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Body -->
                <RowDefinition Height="64"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="18,0" Background="#FEF2F2" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#FEE2E2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="⚠️" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Lỗi kết nối máy chủ Backend" FontWeight="Bold" FontSize="14.5" Foreground="#991B1B" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="28" Height="28">
                        <TextBlock Text="✕" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <StackPanel Grid.Row="1" Margin="20,16,20,12" VerticalAlignment="Center">
                <!-- Error Message Box -->
                <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="❌" FontSize="16" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock x:Name="ErrorMessageTextBlock" Grid.Column="1" 
                                   Text="Lỗi kết nối tới máy chủ (localhost:39090)." 
                                   TextWrapping="Wrap" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   Foreground="#9F1239" 
                                   LineHeight="19" />
                    </Grid>
                </Border>

                <!-- Helpful Hint -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="💡 Gợi ý khắc phục:" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,0,0,2" />
                        <TextBlock Text="Dịch vụ Backend hoặc Cơ sở dữ liệu có thể đang bị gián đoạn hoặc chưa bật. Bạn có thể nhấn 'Sửa chữa ngay' để hệ thống tự động kiểm tra và phục hồi kết nối tức thì." 
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextMuted}" LineHeight="17" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="18,0" Background="#F8FAFC">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Đóng" Click="CloseButton_Click" Width="80" Height="36" HorizontalAlignment="Left"
                            Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextMain}"
                            Cursor="Hand" Template="{StaticResource RoundedButtonTemplate}" />

                    <Button x:Name="AutoRepairButton" Grid.Column="1" Content="🛠️ Sửa chữa ngay (Auto Repair)" Click="AutoRepairButton_Click"
                            Padding="16,0" Height="38" Background="#7C3AED" BorderThickness="0" Foreground="White" FontWeight="Bold" FontSize="13"
                            Cursor="Hand" Template="{StaticResource RoundedButtonTemplate}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

