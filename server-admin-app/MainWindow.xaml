                                    <Button Content="2,000" Tag="2000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="3,000" Tag="3000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="4,000" Tag="4000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="5,000" Tag="5000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="6,000" Tag="6000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="7,000" Tag="7000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="8,000" Tag="8000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="9,000" Tag="9000" Style="{StaticResource TopupMinorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                </UniformGrid>

                                <!-- 10k - 90k (Mệnh giá chuẩn) -->
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Mệnh giá chuẩn"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#1E40AF" />
                                    <TextBlock Text="(10.000đ - 90.000đ)"
                                               FontSize="10.5"
                                               Foreground="#94A3B8"
                                               Margin="4,0,0,0" />
                                </DockPanel>
                                <UniformGrid Columns="3">
                                    <Button Content="10,000" Tag="10000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="20,000" Tag="20000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="30,000" Tag="30000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="40,000" Tag="40000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="50,000" Tag="50000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="60,000" Tag="60000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="70,000" Tag="70000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="80,000" Tag="80000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                    <Button Content="90,000" Tag="90000" Style="{StaticResource TopupMajorButtonStyle}" Click="TopupQuickAmountButton_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Error Message -->
                        <TextBlock x:Name="TopupModalErrorTextBlock"
                                   Grid.Row="2"
                                   Foreground="#DC2626"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />

                        <!-- Row 3: Footer Action Buttons -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Utility buttons (Undo, Clear) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button x:Name="TopupUndoButton"
                                        Style="{StaticResource TopupOutlineButtonStyle}"
                                        Content="↩ Hoàn tác"
                                        Height="36"
                                        Padding="12,0"
                                        Margin="0,0,8,0"
                                        ToolTip="Hoàn tác lượt bấm mệnh giá vừa rồi"
                                        Click="TopupUndoButton_Click" />
                                <Button x:Name="TopupClearButton"
                                        Style="{StaticResource TopupOutlineButtonStyle}"
                                        Content="✕ Xóa hết"
                                        Height="36"
                                        Padding="12,0"
                                        ToolTip="Đặt lại số tiền về 0 VND"
                                        Click="TopupClearButton_Click" />
                            </StackPanel>

                            <!-- Right: Cancel & Submit -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource TopupGhostButtonStyle}"
                                        Content="Hủy"
                                        Width="85"
                                        Height="36"
                                        Margin="0,0,10,0"
