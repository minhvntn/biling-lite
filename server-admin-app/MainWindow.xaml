<Window x:Class="Server.Admin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:local="clr-namespace:Server.Admin.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static local:I18n.MainWindowTitle}"
        Height="900"
        Width="1550"
        MinHeight="720"
        MinWidth="1240"
        PreviewMouseDown="Window_PreviewMouseDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E5AA8" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#CFCFCF" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#E6E6E6" />
        <Thickness x:Key="MachineContextMenuItemPadding">12</Thickness>
        <sys:Double x:Key="MachineContextMenuFontSize">14</sys:Double>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F2F2F2" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E5AA8" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Foreground" Value="#1E5AA8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="#F7F9FC"
                                BorderBrush="#CFCFCF"
                                BorderThickness="1,1,1,0"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Border.Resources>
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#DC2626" />
                                <Setter TargetName="TabRoot" Property="Background" Value="#FEF2F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#DC2626" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#DC2626" />
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#94A3B8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Hủy">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Huỷ">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Cancel">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Xóa">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Xoá">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Delete">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}" />

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Collapsed Status Server controls to satisfy code-behind references -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="HealthTextBlock" />
                <TextBlock x:Name="ServerIpTextBlock" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="#0066cc" BorderBrush="#2563EB" BorderThickness="0">
                <Border.Resources>
                    <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid x:Name="Grid">
                                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        </Border>
                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4">
                                                <Border.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Foreground" Value="Black" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Setter Property="Padding" Value="10,6" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="MenuItem">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" MinWidth="24"/>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                                                                <ColumnDefinition Width="16" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                            <ContentPresenter ContentSource="Header" Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                                            <TextBlock Text="{TemplateBinding InputGestureText}" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
                                                                            <Path x:Name="RightArrow" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Data="M 0 0 L 4 4 L 0 8 Z" Fill="Black" Visibility="Collapsed" />
                                                                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2,0,0,0">
                                                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                                                </Border>
                                                                            </Popup>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="Role" Value="SubmenuHeader">
                                                                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Separator">
                                                                    <Border Height="1" Background="#E2E8F0" Margin="0,4" />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Border.Resources>
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="HeaderButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Menu Grid.Column="0" Background="Transparent" FontSize="13.5" Margin="4,2">
                        <MenuItem Header="Công cụ" Style="{StaticResource TopLevelMenuItemStyle}" Padding="12,5" Height="32" VerticalContentAlignment="Center" Foreground="White">
                            <MenuItem Header="Mở máy trạm" Click="OpenWakeUpMachinesDialog_Click" Foreground="Black" />
                            <MenuItem Header="Thông tin" Click="ShowServerInfoMenuItem_Click" Foreground="Black" />
                            <Separator />
                            <MenuItem Header="Hiển thị máy trạm" Foreground="Black">
                                <MenuItem x:Name="ViewModeListMenuItem" Header="Dạng danh sách" Click="ViewModeList_Click" FontWeight="Bold" Foreground="Black">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✔" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ViewModeIconMenuItem" Header="Dạng biểu tượng" Click="ViewModeIcon_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <Button Grid.Column="1"
                            x:Name="LogoutButton" 
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,8,0" 
                            Click="LogoutButton_Click" 
                            ToolTip="{x:Static local:I18n.Logout}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:I18n.Logout}" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Ellipse x:Name="HealthIndicator" 
                             Grid.Column="2" 
                             Width="10" 
                             Height="10" 
                             Fill="#94A3B8" 
                             Stroke="White" 
                             StrokeThickness="1" 
                             Margin="4,0,16,0" 
                             VerticalAlignment="Center" 
                             Cursor="Help"
                             ToolTip="{Binding ElementName=HealthTextBlock, Path=Text}" />
                </Grid>
            </Border>

            <TabControl x:Name="MainTabControl" Margin="0" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem x:Name="WorkstationsTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="&#x1F5A5;" Margin="0,0,6,0" FontSize="20" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Static local:I18n.WorkstationsTab}" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Margin="0,0,6,0" Padding="10,5" Click="RefreshMachinesButton_Click" Content="{x:Static local:I18n.Refresh}" />
                            <Button Grid.Column="1" Margin="0,0,6,0" Padding="10,5" Click="OpenMachineButton_Click" Content="{x:Static local:I18n.OpenMachine}" />
                            <Button Grid.Column="2" Margin="0,0,6,0" Padding="10,5" Click="LockMachineButton_Click" Content="{x:Static local:I18n.LockMachine}" />
                            <Button Grid.Column="3" Margin="0,0,6,0" Padding="10,5" Click="UnlockAllFilterButton_Click" Content="{x:Static local:I18n.ClearFilter}" />

                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="0,0,6,0" Text="{x:Static local:I18n.StatusLabel}" />
                            <ComboBox x:Name="StatusFilterComboBox"
                                      Grid.Column="6"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="StatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True" />
                                <ComboBoxItem Content="Đang sử dụng" />
                                <ComboBoxItem Content="Đang tắt" />
                                <ComboBoxItem Content="Sẵn sàng" />
                                <ComboBoxItem Content="Offline" />
                            </ComboBox>

                            <TextBlock Grid.Column="8" VerticalAlignment="Center" Margin="0,0,6,0" Text="{x:Static local:I18n.SearchMachineLabel}" />
                            <TextBox x:Name="SearchTextBox" Grid.Column="9" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />

                            <TextBlock Grid.Column="11" VerticalAlignment="Center" x:Name="LastSyncTextBlock" Text="{x:Static local:I18n.SyncDefault}" />
                        </Grid>

                        <DataGrid x:Name="MachinesDataGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  AlternationCount="2"
                                  ColumnWidth="*"
                                  ContextMenuOpening="MachinesDataGrid_ContextMenuOpening"
                                  MouseDoubleClick="MachinesDataGrid_MouseDoubleClick"
                                  SelectionChanged="MachinesDataGrid_SelectionChanged">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="MachinesDataGridRow_PreviewMouseRightButtonDown" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu FontSize="{DynamicResource MachineContextMenuFontSize}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Padding" Value="{DynamicResource MachineContextMenuItemPadding}" />
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="ContextOpenMachineMenuItem" Header="Mở máy" Click="ContextOpenMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextOpenGuestMachineMenuItem" Header="Đăng nhập trả tiền trước..." Click="ContextOpenGuestMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextAdminLoginMachineMenuItem" Header="Đăng nhập admin máy trạm" Click="ContextAdminLoginMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextLockMachineMenuItem" Header="Khóa máy" Click="ContextLockMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextTopupMachineMemberMenuItem" Header="Nạp tiền hội viên đang dùng máy..." Click="ContextTopupMachineMemberMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextRestartMachineMenuItem" Header="Khởi động lại máy trạm" Click="ContextRestartMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextWakeRemoteMachineMenuItem" Header="Khởi động máy trạm từ xa" Click="ContextWakeRemoteMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextShutdownMachineMenuItem" Header="Tắt máy trạm">
                                        <MenuItem x:Name="ContextShutdownSelectedMachineMenuItem"
                                                  Header="Tắt máy đã chọn"
                                                  Click="ContextShutdownSelectedMachineMenuItem_Click" />
                                        <MenuItem x:Name="ContextShutdownReadyMachinesMenuItem"
                                                  Header="Tắt các máy sẵn sàng"
                                                  Click="ContextShutdownReadyMachinesMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem x:Name="ContextControlMachineMenuItem" Header="Điều khiển máy trạm">
                                        <MenuItem x:Name="ContextControlCloseAppsMenuItem"
                                                  Header="Đóng ứng dụng..."
                                                  Click="ContextCloseAppsMenuItem_Click" />
                                        <MenuItem x:Name="ContextControlRemoteMenuItem"
                                                  Header="Điều khiển máy trạm (Live)"
                                                  Click="ContextRemoteControlMachineMenuItem_Click" />
                                        <MenuItem x:Name="ContextControlScreenshotMenuItem"
                                                  Header="Chụp màn hình máy trạm"
                                                  Click="ContextCaptureScreenshotMachineMenuItem_Click" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="ContextPauseMachineMenuItem"
                                              Header="Tạm nghỉ máy trạm"
                                              Click="ContextPauseMachineMenuItem_Click"
                                              Visibility="Collapsed" />
                                    <MenuItem x:Name="ContextResumeMachineMenuItem"
                                              Header="Tiếp tục sử dụng"
                                              Click="ContextResumeMachineMenuItem_Click"
                                              Visibility="Collapsed" />
                                    <MenuItem x:Name="ContextTransferMachineMenuItem" Header="Chuyển máy" Click="ContextTransferMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextAssignGroupMenuItem" Header="Chuyển nhóm máy">
                                        <MenuItem Header="Đang tải nhóm máy..." IsEnabled="False" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="ContextViewMachineBillingMenuItem" Header="Thanh toán..." Click="ContextViewMachineBillingMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextSelectServiceMenuItem" Header="Chọn dịch vụ..." Click="ContextSelectServiceMenuItem_Click" />
                                    <MenuItem x:Name="ContextPayServiceMenuItem" Header="Thanh toán dịch vụ..." Click="ContextPayServiceMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextNotifyMachineMenuItem" Header="Gửi thông báo" Click="ContextNotifyMachineMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Làm mới danh sách" Click="ContextRefreshMachinesMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextControlCloseAllAppsMenuItem"
                                              Header="Đóng tất cả ứng dụng (Taskbar)"
                                              Click="ContextCloseAllAppsMenuItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EAE8E3" />
                                    <Setter Property="Foreground" Value="#334155" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="{Binding StatusIconPath}"
                                                                 Width="32"
                                                                 Height="32"
                                                                 Margin="4,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="{Binding StatusIconToolTip}" />
                                                <TextBlock Text="{Binding Name}" 
                                                           VerticalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tình trạng" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Margin="-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                                <Setter Property="Background" Value="{DynamicResource ColorOnlineBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                                <Setter Property="Background" Value="{DynamicResource ColorInUseBgBrush}" />
                                                            </DataTrigger>
                                                            
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                                <Setter Property="Background" Value="#FEF2F2" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                                <Setter Property="Background" Value="{DynamicResource ColorOfflineBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOfflineUnpaidGuest}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorTransferPayBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorAdminBgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,2">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="Gray" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorOnlineFgBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorInUseFgBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorOfflineFgBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ColorAdminFgBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding StatusSubText}"
                                                               Margin="0,1,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusSubText}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Người sử dụng" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Margin="-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsVipSession}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorVipBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UserName}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Margin="8,6"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVipSession}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ColorVipFgBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bắt đầu" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartedAtText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Đã sử dụng" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Margin="-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ColorUsedTimeBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UsedText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorUsedTimeFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Còn lại" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="0" Margin="-2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ColorRemainingTimeBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RemainingText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorRemainingTimeFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tiền" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MoneyText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tiền dịch vụ" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="3,2"
                                                    CornerRadius="0"
                                                    Margin="-8,0"
                                                    HorizontalAlignment="Stretch">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasServiceDebtHighlight}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorServiceDebtBgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasPendingClientServiceOrderHighlight}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ColorServiceCallBgBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ServiceAmountText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasServiceDebtHighlight}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasPendingClientServiceOrderHighlight}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ngày" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="IP" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IpAddress}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nhóm" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupName}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Icon View (toggled via Công cụ > Hiển thị máy trạm) -->
                        <ScrollViewer x:Name="MachinesIconView"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MachinesIconItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="IconCard"
                                                Width="120" Height="120"
                                                Margin="6"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#CBD5E1"
                                                Background="#F8FAFC"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="MachineIconCard_MouseLeftButtonDown"
                                                MouseRightButtonDown="MachineIconCard_MouseRightButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="320">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                                        <TextBlock Text="{Binding StatusSubText}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusSubText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Separator Margin="0,4" />
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Người dùng: " /><Run Text="{Binding UserName, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Bắt đầu: " /><Run Text="{Binding StartedAtText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Đã dùng: " /><Run Text="{Binding UsedText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Còn lại: " /><Run Text="{Binding RemainingText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Tiền: " /><Run Text="{Binding MoneyText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="IP: " /><Run Text="{Binding IpAddress, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Nhóm: " /><Run Text="{Binding GroupName, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <svgc:SvgViewbox Source="{Binding StatusIconPath}"
                                                                 Width="48" Height="48"
                                                                 HorizontalAlignment="Center"
                                                                 ToolTip="{Binding StatusIconToolTip}" />
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="10"
                                                           Margin="0,1,0,0"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#93C5FD" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#ECFDF5" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#86EFAC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                <Setter TargetName="IconCard" Property="Background" Value="#FEF2F2" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#FCA5A5" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#F1F5F9" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#94A3B8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                <Setter TargetName="IconCard" Property="Background" Value="#FEF9C3" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#FDE047" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       x:Name="SelectionTextBlock"
                                       VerticalAlignment="Center"
                                       Text="Chưa chọn máy" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,6,0" Padding="8,4" Background="#EEF2FF" CornerRadius="6">
                                    <TextBlock x:Name="SummaryTotalTextBlock" FontWeight="SemiBold" FontSize="13" Text="Tổng máy: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="8,4" Background="#EEF6FF" CornerRadius="6">
                                    <TextBlock x:Name="SummaryMemberCountTextBlock" FontWeight="SemiBold" FontSize="12.5" Text="Tổng hội viên: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="8,4" Background="#ECFDF3" CornerRadius="6">
                                    <TextBlock x:Name="SummaryUsingTextBlock" FontWeight="SemiBold" FontSize="13" Text="Đang sử dụng: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="8,4" Background="#FEF2F2" CornerRadius="6">
                                    <TextBlock x:Name="SummaryLockedTextBlock" FontWeight="SemiBold" FontSize="13" Text="Đang tắt: 0" />
                                </Border>
                                <Border Padding="8,4" Background="#FFF7ED" CornerRadius="6">
                                    <TextBlock x:Name="SummaryMoneyTextBlock" FontWeight="SemiBold" FontSize="13" Text="Tiền tạm tính: 0" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="MembersTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="&#x1F464;" Margin="0,0,6,0" FontSize="20" />
                            <TextBlock VerticalAlignment="Center" Text="Hội viên" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Margin="0,0,8,0" Padding="10,5" Click="RefreshMembersButton_Click" Content="Làm mới" />
                            <Button Grid.Column="1" Margin="0,0,8,0" Padding="10,5" Click="AddMemberButton_Click" Content="Thêm hội viên" />
                            <Button Grid.Column="2" Margin="0,0,8,0" Padding="10,5" Click="ViewMemberTransactionsButton_Click" Content="Xem log" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBox x:Name="TopupAmountTextBox" Width="100" VerticalContentAlignment="Center" Text="0" />
                                <TextBox x:Name="BuyHoursTextBox" Width="80" Margin="6,0,0,0" VerticalContentAlignment="Center" Text="2" />
                                <TextBox x:Name="RatePerHourTextBox" Width="100" Margin="6,0,0,0" VerticalContentAlignment="Center" Text="15000" />
                            </StackPanel>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" Text="Tìm:" />
                            <TextBox x:Name="MembersSearchTextBox" Grid.Column="4" VerticalContentAlignment="Center"
                                     MinWidth="180" Margin="0,0,8,0"
                                     TextChanged="MembersSearchTextBox_TextChanged" />

                            <TextBlock Grid.Column="5" VerticalAlignment="Center" x:Name="MembersLastSyncTextBlock" Text="Đồng bộ: -" />
                        </Grid>

                        <DataGrid x:Name="MembersDataGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  AlternationCount="2"
                                  ContextMenuOpening="MembersDataGrid_ContextMenuOpening"
                                  MouseDoubleClick="MembersDataGrid_MouseDoubleClick"
                                  SelectionChanged="MembersDataGrid_SelectionChanged">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="MembersDataGridRow_PreviewMouseRightButtonDown" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu FontSize="{DynamicResource MachineContextMenuFontSize}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Padding" Value="{DynamicResource MachineContextMenuItemPadding}" />
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="Xem / sửa hội viên..." Click="ContextEditMemberMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Nạp tiền" Click="ContextTopupMemberMenuItem_Click" />
                                    <MenuItem Header="Chuyển tiền cho hội viên..." Click="ContextTransferMemberMenuItem_Click" />
                                    <MenuItem Header="Nhật ký giao dịch..." Click="ContextMemberTransactionsMenuItem_Click" />
                                    <MenuItem Header="Nhật ký sử dụng máy..." Click="ContextMemberUsageLogsMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Tiền trả lại" Click="ContextRefundMemberMenuItem_Click" />
                                    <MenuItem Header="Tặng tiền miễn phí" Click="ContextGiftMemberMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Xóa hội viên" Click="ContextDeleteMemberMenuItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130" />
                                <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="160" />
                                <DataGridTextColumn Header="Bậc VIP" Binding="{Binding Rank}" Width="100" />
                                <DataGridTextColumn Header="Loại hội viên" Binding="{Binding MemberTypeText}" Width="120" />
                                <DataGridTextColumn Header="Tổng nạp" Binding="{Binding TotalTopupText}" Width="110" />
                                <DataGridTextColumn Header="Điểm" Binding="{Binding AvailablePoints}" Width="80" />
                                <DataGridTextColumn Header="SDT" Binding="{Binding Phone}" Width="120" />
                                <DataGridTextColumn Header="CCCD/CMND" Binding="{Binding IdentityNumber}" Width="140" />
                                <DataGridTextColumn Header="Số dư" Binding="{Binding BalanceText}" Width="120" />
                                                                <DataGridTextColumn Header="Mật khẩu" Binding="{Binding PasswordState}" Width="100" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding ActiveText}" Width="100" />
                                <DataGridTextColumn Header="Tạo lúc" Binding="{Binding CreatedAtText}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid x:Name="MemberTransactionsDataGrid"
                                  Grid.Row="2"
                                  Margin="0,8,0,0"
                                  Height="0"
                                  Visibility="Collapsed"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtText}" Width="170" />
                                <DataGridTextColumn Header="Loại" Binding="{Binding TypeText}" Width="120" />
                                <DataGridTextColumn Header="Tiền thay đổi" Binding="{Binding AmountDeltaText}" Width="140" />
