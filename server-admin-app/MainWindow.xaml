                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#334155"
                                                           Text="Số phút chơi đổi từ 1 điểm:" />
