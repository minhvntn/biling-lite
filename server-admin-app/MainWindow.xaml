                                    </Border>
                                </TabItem>

                                <TabItem Header="Tài khoản ngân hàng">
                                    <Border Margin="0,8,0,0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"
                                                       Text="Cấu hình tài khoản nhận tiền qua mã VietQR" />

                                            <Grid Grid.Row="1" Margin="0,15,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Mã ngân hàng (VD: VCB, MB):" />
                                                <TextBox x:Name="VietQrBankIdTextBox"
                                                         Grid.Column="1"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="VietQrConfigTextChanged" />
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Số tài khoản:" />
                                                <TextBox x:Name="VietQrAccountNoTextBox"
                                                         Grid.Column="1"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="VietQrConfigTextChanged" />
                                            </Grid>

                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="300" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Tên chủ tài khoản:" />
                                                <TextBox x:Name="VietQrAccountNameTextBox"
                                                         Grid.Column="1"
                                                         Height="32"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="VietQrConfigTextChanged" />
                                            </Grid>

                                            <Button Grid.Row="4"
                                                    Width="200"
                                                    Height="38"
                                                    Margin="0,20,0,0"
                                                    HorizontalAlignment="Left"
                                                    Content="Lưu cài đặt ngân hàng"
                                                    Click="SaveVietQrSettingsButton_Click" />

                                            <TextBlock x:Name="VietQrStatusTextBlock"
                                                       Grid.Row="5"
                                                       Margin="0,8,0,0"
                                                       Foreground="#64748B"
                                                       Text="Đang tải cài đặt ngân hàng..." />
                                        </Grid>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Máy trạm ảo" x:Name="VirtualPcsSettingsTabItem">
                                    <Border Margin="0,8,0,0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Row 0: Header title & desc -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 1: Toggle Switch Bật/Tắt Hiển thị Máy trạm Ảo -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 2: Controls & Config -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 3: Status Summary Badges -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 4: Preview DataGrid Header -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Row 5: Preview DataGrid -->
                                                <RowDefinition Height="*" MinHeight="200" MaxHeight="300" />
                                                <!-- Row 6: Footer Status Message -->
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Header title -->
                                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                                <TextBlock FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"
                                                           Text="Quản lý và Khởi tạo Máy trạm Ảo (Giả lập / Demo)" />
                                                <TextBlock FontSize="13"
                                                           Margin="0,4,0,0"
                                                           Foreground="#64748B"
                                                           Text="Khởi tạo danh sách máy trạm giả lập để kiểm tra hiển thị giao diện, màu sắc trạng thái, bố cục phòng máy (20, 30, 50 máy) mà không cần bật máy thật." />
                                            </StackPanel>

                                            <!-- Row 1: Toggle Switch Bật/Tắt Hiển thị Máy trạm Ảo -->
                                            <Border x:Name="VirtualPcToggleContainerBorder"
                                                    Grid.Row="1"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="16,12"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="🖥️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Hiển thị máy trạm ảo trên tab Máy trạm"
                                                                       FontSize="14.5"
                                                                       FontWeight="Bold"
                                                                       Foreground="#0F172A"
                                                                       VerticalAlignment="Center" />
                                                            <Border x:Name="VirtualPcStatusBadgeBorder"
                                                                    Margin="12,0,0,0"
                                                                    Padding="8,2"
                                                                    CornerRadius="10"
                                                                    Background="#F1F5F9"
                                                                    BorderBrush="#CBD5E1"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock x:Name="VirtualPcStatusBadgeText"
                                                                           Text="MẶC ĐỊNH: ĐANG TẮT"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="#64748B" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock x:Name="VirtualPcToggleDescTextBlock"
                                                                   Margin="26,4,0,0"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   TextWrapping="Wrap"
                                                                   Text="Khi TẮT: Tab Máy trạm chỉ hiển thị các máy tính thật trong phòng máy. Bật toggle này nếu bạn muốn gộp máy ảo vào để xem bố cục / demo." />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                        <TextBlock x:Name="VirtualPcToggleStateText"
                                                                   Text="Đang TẮT"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="#64748B"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <CheckBox x:Name="VirtualPcEnableDisplayCheckBox"
                                                                  IsChecked="False"
                                                                  Checked="VirtualPcEnableDisplay_Changed"
                                                                  Unchecked="VirtualPcEnableDisplay_Changed"
                                                                  VerticalAlignment="Center"
                                                                  Cursor="Hand">
                                                            <CheckBox.LayoutTransform>
                                                                <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                                                            </CheckBox.LayoutTransform>
                                                        </CheckBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 2: Controls card -->
                                            <Border Grid.Row="2"
                                                    Background="#F8FAFC"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14,12"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- SubRow 0: So luong may -->
                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#334155"
                                                                   Text="Số lượng máy trạm:" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="20 máy" Tag="20" Click="VirtualPcQuickCount_Click"
                                                                    Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontWeight="SemiBold" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="30 máy" Tag="30" Click="VirtualPcQuickCount_Click"
                                                                    Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontWeight="SemiBold" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="50 máy" Tag="50" Click="VirtualPcQuickCount_Click"
                                                                    Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontWeight="SemiBold" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="80 máy" Tag="80" Click="VirtualPcQuickCount_Click"
                                                                    Padding="10,4" Margin="0,0,10,0" Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" FontWeight="SemiBold" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                                            </Button>
                                                            <TextBlock Text="Hoặc tự nhập:" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,6,0" FontSize="12" />
                                                            <TextBox x:Name="VirtualPcCountTextBox"
                                                                     Text="30"
                                                                     Width="70"
                                                                     Height="28"
                                                                     VerticalContentAlignment="Center"
                                                                     TextAlignment="Center"
                                                                     FontWeight="Bold"
                                                                     FontSize="13" />
                                                            <TextBlock Text="(Tối đa 200 máy)" VerticalAlignment="Center" Foreground="#94A3B8" Margin="8,0,0,0" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- SubRow 1: Che do phan bo trang thai -->
                                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#334155"
                                                                   Text="Tình trạng / Phân bổ:" />
                                                        <ComboBox x:Name="VirtualPcDistributionComboBox"
                                                                  Grid.Column="1"
                                                                  Width="420"
                                                                  Height="30"
                                                                  HorizontalAlignment="Left"
                                                                  SelectedIndex="0">
                                                            <ComboBoxItem Tag="RANDOM" Content="🎲 Ngẫu nhiên thực tế (Sẵn sàng, Hội viên, VIP, Khách, Admin, Offline)" IsSelected="True" />
                                                            <ComboBoxItem Tag="BUSY" Content="🔥 Phòng máy đông đúc (~80% máy đang chơi, 20% online)" />
                                                            <ComboBoxItem Tag="FULL" Content="🏆 100% Đang sử dụng (Kín tất cả các máy)" />
                                                            <ComboBoxItem Tag="ALL_ONLINE" Content="🟢 100% Sẵn sàng (Tất cả máy Online)" />
                                                            <ComboBoxItem Tag="ALL_OFFLINE" Content="🔴 100% Mất kết nối (Offline)" />
                                                        </ComboBox>
                                                    </Grid>

                                                    <!-- SubRow 2: Checkboxes tuy chon -->
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                                        <CheckBox x:Name="VirtualPcAssignGroupsCheckBox"
                                                                  Content="Tự động phân nhóm (Phòng Thường, VIP, Thi Đấu, Stream)"
                                                                  IsChecked="True"
                                                                  Margin="0,0,24,0" />
                                                        <CheckBox x:Name="VirtualPcAddServicesCheckBox"
                                                                  Content="Giả lập tiền dịch vụ đồ ăn / nước uống"
                                                                  IsChecked="True"
                                                                  Margin="0,0,24,0" />
                                                    </StackPanel>

                                                    <!-- SubRow 3: Action Buttons -->
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                                        <Button x:Name="GenerateVirtualPcsButton"
                                                                Content="🚀 Khởi tạo máy trạm ảo"
                                                                Padding="16,8"
                                                                Margin="0,0,8,0"
                                                                Background="#2563EB"
                                                                Foreground="White"
                                                                FontWeight="Bold"
                                                                Cursor="Hand"
                                                                Click="GenerateVirtualPcsButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>

                                                        <Button x:Name="ShuffleVirtualPcsButton"
                                                                Content="🎲 Đổi ngẫu nhiên trạng thái"
                                                                Padding="14,8"
                                                                Margin="0,0,8,0"
                                                                Background="#10B981"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                Click="ShuffleVirtualPcsButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>

                                                        <Button x:Name="ClearVirtualPcsButton"
                                                                Content="🧹 Xóa toàn bộ máy ảo"
                                                                Padding="14,8"
                                                                Margin="0,0,8,0"
                                                                Background="#EF4444"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                Click="ClearVirtualPcsButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>

                                                        <Button x:Name="JumpToMachinesTabButton"
                                                                Content="Xem tab Máy trạm ➜"
                                                                Padding="14,8"
                                                                Background="#F1F5F9"
                                                                Foreground="#1E293B"
                                                                BorderBrush="#CBD5E1"
                                                                BorderThickness="1"
                                                                FontWeight="SemiBold"
                                                                Cursor="Hand"
                                                                Click="JumpToMachinesTabButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 3: Status Summary Badges -->
                                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                                <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Tổng máy ảo: " FontSize="12" Foreground="#475569" FontWeight="SemiBold" />
                                                        <TextBlock x:Name="VpBadgeTotalTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#0F172A" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🟢 Sẵn sàng: " FontSize="12" Foreground="#065F46" />
                                                        <TextBlock x:Name="VpBadgeOnlineTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#059669" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔵 Hội viên: " FontSize="12" Foreground="#1E40AF" />
                                                        <TextBlock x:Name="VpBadgeMemberTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#2563EB" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FEFCE8" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🟡 VIP: " FontSize="12" Foreground="#854D0E" />
                                                        <TextBlock x:Name="VpBadgeVipTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#CA8A04" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🟠 Khách: " FontSize="12" Foreground="#9A3412" />
                                                        <TextBlock x:Name="VpBadgeGuestTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#EA580C" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="👑 Admin: " FontSize="12" Foreground="#713F12" />
                                                        <TextBlock x:Name="VpBadgeAdminTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#A16207" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔴 Offline: " FontSize="12" Foreground="#991B1B" />
                                                        <TextBlock x:Name="VpBadgeOffTextBlock" Text="0" FontSize="12" FontWeight="Bold" Foreground="#DC2626" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💰 Tiền giờ: " FontSize="12" Foreground="#475569" />
                                                        <TextBlock x:Name="VpBadgeMoneyTextBlock" Text="0 đ" FontSize="12" FontWeight="Bold" Foreground="#0284C7" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🍜 Tiền DV: " FontSize="12" Foreground="#475569" />
                                                        <TextBlock x:Name="VpBadgeServicesTextBlock" Text="0 đ" FontSize="12" FontWeight="Bold" Foreground="#16A34A" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <!-- Row 4: Preview Header -->
                                            <TextBlock Grid.Row="4"
                                                       Text="Danh sách xem trước máy trạm ảo:"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#334155"
                                                       Margin="0,4,0,6" />

                                            <!-- Row 5: Preview DataGrid -->
                                            <DataGrid x:Name="VirtualPcsPreviewDataGrid"
                                                      Grid.Row="5"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      SelectionMode="Single"
                                                      HeadersVisibility="Column"
                                                      Background="White"
                                                      RowHeight="34"
                                                      FontSize="12"
                                                      BorderBrush="#E2E8F0"
                                                      BorderThickness="1"
                                                      GridLinesVisibility="Horizontal"
                                                      HorizontalGridLinesBrush="#F1F5F9">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Header="Tên máy" Width="130">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <svgc:SvgViewbox Source="{Binding StatusIconPath}"
                                                                                     Width="22"
                                                                                     Height="22"
                                                                                     Margin="2,0,6,0"
                                                                                     VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTextColumn Header="Tình trạng" Binding="{Binding StatusText}" Width="120" FontWeight="SemiBold" />
                                                    <DataGridTextColumn Header="Người dùng" Binding="{Binding UserName}" Width="130" />
                                                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartedAtText}" Width="80" />
                                                    <DataGridTextColumn Header="Đã dùng" Binding="{Binding UsedText}" Width="80" />
                                                    <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingText}" Width="80" />
                                                    <DataGridTextColumn Header="Tiền giờ" Binding="{Binding MoneyText}" Width="90" />
                                                    <DataGridTextColumn Header="Tiền DV" Binding="{Binding ServiceAmountText}" Width="80" />
                                                    <DataGridTextColumn Header="Nhóm máy" Binding="{Binding GroupName}" Width="120" />
                                                    <DataGridTextColumn Header="Địa chỉ IP" Binding="{Binding IpAddress}" Width="110" />
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!-- Row 6: Footer Status Message -->
                                            <TextBlock x:Name="VirtualPcStatusMessageTextBlock"
                                                       Grid.Row="6"
                                                       Margin="0,8,0,0"
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       Text="Sẵn sàng khởi tạo máy trạm ảo." />
                                        </Grid>
                                    </Border>
                                </TabItem>

                                <TabItem Header="Chatbot AI" x:Name="ChatbotSettingsTabItem">
                                    <Border Margin="0,8,0,0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20,18">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel>
                                                <!-- Header Title -->
                                                <StackPanel Margin="0,0,0,16">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🌸" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Cấu hình Trợ lý AI (Ami) &amp; Google Gemini API"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="#0F172A"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Margin="30,4,0,0"
                                                               Text="Trợ lý ảo thông minh giúp chủ quán kiểm tra nhanh số máy đang chơi, theo dõi doanh thu, soi máy trạm và trò chuyện giải trí trực tiếp trên app."
                                                               Foreground="#64748B"
                                                               FontSize="13"/>
                                                </StackPanel>

                                                <!-- Grid 2 Cột: Bên trái cấu hình, bên phải preview -->
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="2*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- CỘT TRÁI: FORM CẤU HÌNH -->
                                                    <StackPanel Grid.Column="0">
                                                        <!-- Card 1: Bật/Tắt -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                                            <DockPanel LastChildFill="True">
                                                                <StackPanel DockPanel.Dock="Left">
                                                                    <CheckBox x:Name="ChatbotEnableCheckBox"
                                                                              Content="Bật Trợ lý AI (Ami) ở góc phải ứng dụng"
                                                                              FontSize="14"
                                                                              FontWeight="SemiBold"
                                                                              Foreground="#0F172A"
                                                                              IsChecked="True"
                                                                              Checked="ChatbotEnableCheckBox_Changed"
                                                                              Unchecked="ChatbotEnableCheckBox_Changed"/>
                                                                    <TextBlock Margin="24,4,0,0"
                                                                               Text="Khi bật, biểu tượng Ami sẽ hiển thị nổi ở góc phải dưới của Server App."
                                                                               Foreground="#64748B"
                                                                               FontSize="12"/>
                                                                </StackPanel>
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="Trải nghiệm Chat ngay 🚀"
                                                                        Padding="12,6"
                                                                        Background="#2563EB"
                                                                        Foreground="White"
                                                                        FontWeight="SemiBold"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand"
                                                                        Click="OpenChatbotFromSettings_Click"/>
                                                            </DockPanel>
                                                        </Border>

                                                        <!-- Card 2: Gemini API Key & Model -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                                            <StackPanel>
                                                                <TextBlock Text="🔑 Google Gemini API Key" FontWeight="Bold" Foreground="#0F172A" FontSize="13.5"/>
                                                                <TextBlock Margin="0,2,0,8"
                                                                           Text="Dùng để kết nối trực tiếp với trí tuệ nhân tạo Google Gemini (Hoàn toàn miễn phí)."
                                                                           Foreground="#64748B"
                                                                           FontSize="12"/>

                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="ChatbotApiKeyTextBox"
                                                                             Grid.Column="0"
                                                                             Padding="10,8"
                                                                             FontSize="13"
                                                                             Background="White"
                                                                             BorderBrush="#CBD5E1"
                                                                             FontFamily="Consolas, monospace"
                                                                             TextWrapping="NoWrap"/>
                                                                    <Button x:Name="TestGeminiApiKeyButton"
                                                                            Grid.Column="1"
                                                                            Content="Kiểm tra kết nối ⚡"
                                                                            Margin="8,0,0,0"
                                                                            Padding="12,6"
                                                                            Background="#0F172A"
                                                                            Foreground="White"
                                                                            FontWeight="SemiBold"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Click="TestGeminiApiKeyButton_Click"/>
                                                                </Grid>

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                                                    <TextBlock Text="Chưa có API Key? " Foreground="#64748B" FontSize="12"/>
                                                                    <TextBlock Text="Nhận miễn phí tại Google AI Studio (Click để mở)"
                                                                               Foreground="#2563EB"
                                                                               FontSize="12"
                                                                               Cursor="Hand"
                                                                               TextDecorations="Underline"
                                                                               MouseLeftButtonUp="OpenGeminiAiStudioLink_Click"/>
                                                                </StackPanel>

                                                                <!-- Model Selector & Thẩm định Model -->
                                                                <Grid Margin="0,6,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="Mô hình AI:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <ComboBox x:Name="ChatbotModelComboBox"
                                                                              Grid.Column="1"
                                                                              Padding="8,6"
                                                                              SelectedIndex="0"
                                                                              IsEditable="True"
                                                                              FontFamily="Consolas, Segoe UI, monospace"
                                                                              FontSize="13">
                                                                        <ComboBoxItem Content="gemini-3.8-flash (Tốc độ cao &amp; Thông minh vượt trội)" Tag="gemini-3.8-flash"/>
                                                                        <ComboBoxItem Content="gemini-4-argon (Thế hệ 4 thử nghiệm)" Tag="gemini-4-argon"/>
                                                                        <ComboBoxItem Content="gemini-2.5-flash (Mô hình thế hệ 2.5 tối ưu)" Tag="gemini-2.5-flash"/>
                                                                        <ComboBoxItem Content="gemini-2.5-pro (Mô hình thế hệ 2.5 chuyên sâu)" Tag="gemini-2.5-pro"/>
                                                                        <ComboBoxItem Content="gemini-2.0-flash (Mô hình thế hệ 2.0 mới)" Tag="gemini-2.0-flash"/>
                                                                        <ComboBoxItem Content="gemini-1.5-flash (Khuyên dùng: Ổn định &amp; phổ biến)" Tag="gemini-1.5-flash"/>
                                                                        <ComboBoxItem Content="gemini-1.5-pro (Hiểu sâu, phân tích chi tiết)" Tag="gemini-1.5-pro"/>
                                                                    </ComboBox>
                                                                    <Button x:Name="ScanGeminiModelsButton"
                                                                            Grid.Column="2"
                                                                            Content="🔄 Quét Model Trên Key"
                                                                            ToolTip="Tự động quét toàn bộ model Google Gemini được hỗ trợ trên API Key của bạn"
                                                                            Margin="8,0,0,0"
                                                                            Padding="12,6"
                                                                            Background="#0F172A"
                                                                            Foreground="#38BDF8"
                                                                            FontWeight="SemiBold"
                                                                            BorderThickness="0"
                                                                            Cursor="Hand"
                                                                            Click="ScanGeminiModelsButton_Click"/>
                                                                </Grid>

                                                                <!-- CHIP PHÍM TẮT CHỌN NHANH MODEL THẨM ĐỊNH (GIỐNG TOOL THẨM ĐỊNH) -->
                                                                <Border Margin="0,8,0,0"
                                                                        Background="#0F172A"
                                                                        BorderBrush="#1E293B"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="10,8">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                            <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="Model Thẩm Định Nhanh:" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                                            <TextBlock Text=" (Bấm để chọn trực tiếp)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <WrapPanel>
                                                                            <Button Content="gemini-3.8-flash"
                                                                                    Tag="gemini-3.8-flash"
                                                                                    Background="#1E1B4B"
                                                                                    Foreground="#C084FC"
                                                                                    BorderBrush="#8B5CF6"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                            <Button Content="gemini-4-argon"
                                                                                    Tag="gemini-4-argon"
                                                                                    Background="#082F49"
                                                                                    Foreground="#38BDF8"
                                                                                    BorderBrush="#0284C7"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                            <Button Content="gemini-2.5-flash"
                                                                                    Tag="gemini-2.5-flash"
                                                                                    Background="#1E293B"
                                                                                    Foreground="#F1F5F9"
                                                                                    BorderBrush="#475569"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                            <Button Content="gemini-2.5-pro"
                                                                                    Tag="gemini-2.5-pro"
                                                                                    Background="#1E293B"
                                                                                    Foreground="#F1F5F9"
                                                                                    BorderBrush="#475569"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                            <Button Content="gemini-2.0-flash"
                                                                                    Tag="gemini-2.0-flash"
                                                                                    Background="#1E293B"
                                                                                    Foreground="#34D399"
                                                                                    BorderBrush="#059669"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                            <Button Content="gemini-1.5-flash"
                                                                                    Tag="gemini-1.5-flash"
                                                                                    Background="#1E293B"
                                                                                    Foreground="#FBBF24"
                                                                                    BorderBrush="#D97706"
                                                                                    BorderThickness="1"
                                                                                    FontSize="11.5"
                                                                                    FontFamily="Consolas, monospace"
                                                                                    FontWeight="SemiBold"
                                                                                    Padding="10,4"
                                                                                    Margin="0,0,6,4"
                                                                                    Cursor="Hand"
                                                                                    Click="QuickSelectModelChip_Click"/>
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Card 3: Tùy chỉnh vai trò & Ngữ cảnh -->
                                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                                            <StackPanel>
                                                                <TextBlock Text="⚙️ Tùy chọn trợ lý &amp; Tích hợp phòng máy" FontWeight="Bold" Foreground="#0F172A" FontSize="13.5" Margin="0,0,0,8"/>
                                                                
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="Tên trợ lý:" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <TextBox x:Name="ChatbotAssistantNameTextBox" Grid.Column="1" Text="Ami" Padding="8,5" MaxLength="20"/>
                                                                </Grid>

                                                                <CheckBox x:Name="ChatbotAllowPcContextCheckBox"
                                                                          IsChecked="True"
                                                                          Content="Cho phép trợ lý đọc dữ liệu máy trạm thời gian thực"
                                                                          FontWeight="SemiBold"
                                                                          Foreground="#334155"
                                                                          Margin="0,4,0,0"/>
                                                                <TextBlock Margin="24,2,0,0"
                                                                           Text="Khi bật, Ami có thể trả lời chính xác: 'Hiện có bao nhiêu máy đang chơi?', 'Máy nào nợ tiền đồ ăn?', 'Doanh thu hôm nay thế nào?'..."
                                                                           Foreground="#64748B"
                                                                           FontSize="12"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- CỘT PHẢI: PREVIEW & HƯỚNG DẪN -->
                                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" Padding="16" BorderBrush="#1E293B" BorderThickness="1">
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <!-- Avatar Chibi Ami to -->
                                                            <Border Width="80" Height="80" CornerRadius="40" Background="#1E1B4B" BorderBrush="#00F090" BorderThickness="2" Margin="0,0,0,10" HorizontalAlignment="Center">
                                                                <TextBlock Text="🌸" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="Ami 🌸 (Trợ Lý AI)" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="&quot;Anh ơi, có Ami ở đây nè! ✨&quot;" FontStyle="Italic" FontSize="12.5" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                                                            <Border Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                                                                <TextBlock Text="💡 Mẹo hay: Bạn có thể click vào icon Ami ở góc phải để mở cửa sổ chat bất cứ lúc nào, hỏi đáp tình hình phòng máy hoặc tâm sự giải trí."
                                                                           Foreground="#94A3B8"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="18"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <!-- NÚT LƯU CÀI ĐẶT -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="Lưu cài đặt Chatbot"
                                                            Padding="18,8"
                                                            Background="#2563EB"
                                                            Foreground="White"
                                                            FontWeight="Bold"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            Click="SaveChatbotSettingsButton_Click"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="Khôi phục mặc định"
                                                            Padding="14,8"
                                                            Background="#F1F5F9"
                                                            Foreground="#475569"
                                                            BorderBrush="#CBD5E1"
                                                            BorderThickness="1"
                                                            Cursor="Hand"
                                                            Click="ResetChatbotSettingsButton_Click"/>
                                                </StackPanel>

                                                <TextBlock x:Name="ChatbotSettingsStatusTextBlock"
                                                           Margin="0,8,0,0"
                                                           Foreground="#64748B"
                                                           FontSize="12.5"
                                                           Text="Sẵn sàng cấu hình Trợ lý AI."/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </TabItem>
                            </TabControl>

                            <StackPanel Grid.Row="4">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Padding="14,7" Margin="0,0,8,0" Click="SaveFontSizeButton_Click" Content="Lưu cài đặt" />
                                    <Button Padding="14,7" Click="ResetFontSizeButton_Click" Content="Đặt lại mặc định" />
                                </StackPanel>

                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#64748B"
                                           Text="Thông tin: Cỡ chữ được xem trước ngay khi kéo thanh trượt." />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AdminTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F510;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Admin" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabControl Margin="8">
                        <TabItem Header="Server">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Danh sách tài khoản Server Admin" DockPanel.Dock="Left" />
                                        <Button Content="Đổi tài khoản ADMIN mặc định"
                                                DockPanel.Dock="Right"
                                                Padding="10,4"
                                                Click="ChangeAdminCredentialsButton_Click"
                                                Background="#F59E0B"
                                                BorderBrush="#D97706"
                                                Foreground="White" />
                                    </DockPanel>
                                    <TextBlock Margin="0,6,0,0" Foreground="#666" Text="Bạn có thể tạo thêm tài khoản nhân viên. Tài khoản ADMIN không thể bị xóa." />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Tên đăng nhập" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                                            <TextBox x:Name="NewStaffUsernameTextBox" Width="180" Height="30" Padding="5,0" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Mật khẩu" FontSize="11" Foreground="#666" Margin="0,0,0,2"/>
                                            <PasswordBox x:Name="NewStaffPasswordBox" Width="180" Height="30" Padding="5,0" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <Button Content="Tạo tài khoản nhân viên" Width="170" Height="30" Click="CreateStaffButton_Click" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StaffActionStatusTextBlock" Margin="0,8,0,0" Foreground="#555" />
                                </StackPanel>
                                <DataGrid x:Name="ServerUsersDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="200" />
                                        <DataGridTextColumn Header="Quyền" Binding="{Binding Role}" Width="120" />
                                        <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="180" />
                                        <DataGridTemplateColumn Header="Hành động" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Content="Đổi mật khẩu" Click="ResetStaffPasswordButton_Click" Tag="{Binding}" Margin="4,2" Padding="10,4" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                        <Button Content="Xóa" Click="DeleteStaffButton_Click" Tag="{Binding Id}" Margin="4,2" Padding="10,4" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{x:Static local:I18n.DatabaseTab}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="DbStorageSizeTextBlock"
                                                       Text="{x:Static local:I18n.DbLoading}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A" />
                                            <TextBlock x:Name="DbStorageUpdatedAtTextBlock"
                                                       Margin="0,6,0,0"
                                                       Text="{x:Static local:I18n.DbUpdatedLoading}"
                                                       Foreground="#64748B" />
                                            <TextBlock x:Name="DbStorageDeltaTextBlock"
                                                       Margin="0,6,0,0"
                                                       Text="{x:Static local:I18n.DbDeltaDefault}"
                                                       Foreground="#64748B"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Padding="12,6"
                                                Content="Làm mới"
                                                Click="RefreshDatabaseStorageButton_Click" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="240" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Bảng nặng nhất (top 12)" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <DataGrid x:Name="DbStorageTablesDataGrid"
                                                      Grid.Row="2"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      RowHeaderWidth="0"
                                                      AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Bảng" Binding="{Binding TableName}" Width="1.4*" />
                                                    <DataGridTextColumn Header="Tổng" Binding="{Binding TotalPretty}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Data" Binding="{Binding TablePretty}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Index/Toast" Binding="{Binding IndexToastPretty}" Width="0.9*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="240" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Lịch sử dung lượng (14 ngày)" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <DataGrid x:Name="DbStorageHistoryDataGrid"
                                                      Grid.Row="2"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      RowHeaderWidth="0"
                                                      AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="*" />
                                                    <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizePretty}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Client">
                            <Grid Margin="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tài khoản đăng nhập Admin máy trạm" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#666"
                                               Text="Bấm nút bên dưới để mở popup đổi username/mật khẩu." />
                                    <Button Margin="0,14,0,0"
                                            Width="240"
                                            Padding="12,6"
                                            HorizontalAlignment="Left"
                                            Content="Đổi tài khoản admin..."
                                            Click="OpenAdminCredentialPopupButton_Click" />
                                    <TextBlock x:Name="AdminCredentialStatusTextBlock"
                                               Margin="0,10,0,0"
                                               Foreground="#555"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </DockPanel>

        <Grid x:Name="MemberModalOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="460"
                    MinHeight="420"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="0,16"
                    Background="White"
                    BorderBrush="#CFCFCF"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Thêm hội viên" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Tên đăng nhập" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberUsernameTextBox" CharacterCasing="Upper" Grid.Row="2" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3" Text="Mật khẩu" Margin="0,0,0,4" />
                    <PasswordBox x:Name="MemberPasswordBox" Grid.Row="4" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5" Text="Số điện thoại (không bắt buộc)" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberPhoneTextBox" Grid.Row="6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="7" Text="CCCD/CMND (không bắt buộc)" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberIdentityTextBox" Grid.Row="8" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="9" Text="Loại hội viên" Margin="0,0,0,4" />
                    <ComboBox x:Name="MemberTypeComboBox" Grid.Row="10" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="Thường" Tag="REGULAR" />
                        <ComboBoxItem Content="VIP" Tag="VIP" />
                    </ComboBox>

                    <TextBlock Grid.Row="11" Text="Mã giới thiệu (không bắt buộc)" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberReferredByCodeTextBox" Grid.Row="12" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" MaxLength="10" />

                    <TextBlock x:Name="MemberModalErrorTextBlock" Grid.Row="13" VerticalAlignment="Top" Foreground="#B42318" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Padding="10,5" Margin="0,0,8,0" Click="CreateMemberConfirmButton_Click" Content="Tạo" />
                        <Button Padding="10,5" Click="CancelMemberModalButton_Click" Content="Hủy" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="TopupModalOverlay" Background="#75091322" Visibility="Collapsed" Panel.ZIndex="120">
            <Grid.Resources>
                <!-- Close Button Style -->
                <Style x:Key="TopupCloseButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Width" Value="30" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#64748B" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="15"
                                        SnapsToDevicePixels="True">
                                    <TextBlock Text="✕"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Mode Segmented Button Style -->
                <Style x:Key="TopupSegmentedToggleButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Input Textbox Style with Rounded Corners -->
                <Style x:Key="TopupRoundedTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="#0F172A" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  VerticalAlignment="Center"
                                                  Padding="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="border" Property="BorderBrush" Value="#2563EB" />
                                        <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Minor Preset Button (1,000 - 9,000) -->
                <Style x:Key="TopupMinorButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="#F8FAFC" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#334155" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="Margin" Value="2.5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#EEF2F6" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Major Preset Button (10,000 - 90,000) -->
                <Style x:Key="TopupMajorButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="#EFF6FF" />
                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                    <Setter Property="BorderThickness" Value="1.5" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="2.5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DBEAFE" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD" />
                                        <Setter Property="Foreground" Value="#1E40AF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#BFDBFE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Outline Utility Button (Undo, Clear) -->
                <Style x:Key="TopupOutlineButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#CBD5E1" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#475569" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="12.5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                        <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Ghost Button (Cancel) -->
                <Style x:Key="TopupGhostButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="#F1F5F9" />
                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="#475569" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Primary Action Button (Submit) -->
                <Style x:Key="TopupPrimaryButtonStyle" TargetType="Button">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Background" Value="#10B981" />
                    <Setter Property="BorderBrush" Value="#059669" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="13.5" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.45" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border Width="780"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="0,16"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="22,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32"
                                      ShadowDepth="8"
                                      Direction="270"
                                      Color="#000000"
                                      Opacity="0.25" />
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Row 0: Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 1: 2-Column Body -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 2: Error Message -->
                            <RowDefinition Height="Auto" />
                            <!-- Row 3: Footer Actions -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="32"
                                        Height="32"
                                        CornerRadius="8"
                                        Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="💳"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TopupModalTitleTextBlock"
                                               Text="Nạp tiền hội viên"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F172A" />
                                    <TextBlock Text="Chọn mệnh giá nhanh bên phải hoặc nhập số tiền tùy chỉnh"
                                               FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Close Button (X) -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource TopupCloseButtonStyle}"
                                    Click="TopupCancelButton_Click"
                                    ToolTip="Đóng (Esc)" />
                        </Grid>

                        <!-- Row 1: 2-Column Balanced Body -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- Left Column: Info & Inputs (Width 340) -->
                                <ColumnDefinition Width="340" />
                                <!-- Gap -->
                                <ColumnDefinition Width="18" />
                                <!-- Right Column: Presets (Width *) -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <!-- Member Info Banner -->
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28"
                                                Height="28"
                                                CornerRadius="14"
                                                Background="#E2E8F0"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="👤"
                                                       FontSize="13"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="TopupModalMemberTextBlock"
                                                       Text="Hội viên: -"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       Foreground="#1E293B" />
                                            <TextBlock x:Name="TopupModalCurrentBalanceTextBlock"
                                                       Margin="0,1,0,0"
                                                       FontSize="11.5"
                                                       Foreground="#64748B"
                                                       Text="Số dư hiện tại: - VND" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Mode Segmented Switch -->
                                <Border Background="#F1F5F9"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TopupModeAddButton"
                                                Style="{StaticResource TopupSegmentedToggleButtonStyle}"
                                                Content="Nạp tiền (+)"
                                                Width="110"
                                                Margin="0,0,2,0"
                                                Click="TopupModeAddButton_Click" />
                                        <Button x:Name="TopupModeSubtractButton"
                                                Style="{StaticResource TopupSegmentedToggleButtonStyle}"
                                                Content="Trừ tiền (-)"
                                                Width="110"
                                                Click="TopupModeSubtractButton_Click" />
                                    </StackPanel>
                                </Border>

                                <!-- Hero Amount Display Box -->
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8"
                                        Margin="0,0,0,8">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="SỐ TIỀN THỰC HIỆN"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#64748B"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TopupModalAmountTextBlock"
                                                   Text="0 VND"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A"
                                                   Margin="0,2,0,2"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock x:Name="TopupModalBonusTextBlock"
                                                   Foreground="#15803D"
                                                   Background="#DCFCE7"
                                                   Padding="8,2"
                                                   FontWeight="Bold"
                                                   FontSize="11.5"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0"
                                                   Visibility="Collapsed" />
                                        <TextBlock Text="Bấm mệnh giá bên phải để cộng dồn"
                                                   FontSize="10.5"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Custom Direct Inputs Section -->
                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Amount Input -->
                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Số tiền tùy ý"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       Margin="0,0,0,4" />
                                            <Grid>
                                                <TextBox x:Name="TopupCustomAmountTextBox"
                                                         Style="{StaticResource TopupRoundedTextBoxStyle}"
                                                         Padding="8,0,36,0"
                                                         TextChanged="TopupCustomAmountTextBox_TextChanged"
                                                         KeyDown="TopupCustomAmountTextBox_KeyDown" />
                                                <TextBlock Text="VND"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Minutes Input -->
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Theo số phút"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#475569"
                                                       Margin="0,0,0,4" />
                                            <Grid>
                                                <TextBox x:Name="TopupMinutesTextBox"
                                                         Style="{StaticResource TopupRoundedTextBoxStyle}"
                                                         Padding="8,0,36,0"
                                                         TextChanged="TopupMinutesTextBox_TextChanged"
                                                         KeyDown="TopupMinutesTextBox_KeyDown" />
