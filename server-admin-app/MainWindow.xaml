        <!-- ========================================== -->
        <!-- FLOATING CYBER WAIFU AI CHATBOT (AMI)      -->
        <!-- ========================================== -->
        <!-- LAUNCHER CONTAINER (GÓC PHẢI DƯỚI - NÂNG CAO ĐỂ KHÔNG ĐÈ FOOTER THỐNG KÊ) -->
        <Border x:Name="ChatbotLauncherContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,96"
                Panel.ZIndex="5000"
                Cursor="Hand"
                MouseLeftButtonUp="ChatbotLauncher_Click">
            <Grid>
                <!-- NÚT TRÒN THEO TÔNG MÀU SÁNG & XANH DƯƠNG CỦA APP -->
                <Border Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="#FFFFFF"
                        BorderBrush="#2563EB"
                        BorderThickness="2.5">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Color="#2563EB" Opacity="0.3" />
                    </Border.Effect>
                    <!-- AMI AVATAR CANVAS VỚI NỀN XANH DƯƠNG NHẠT SÁNG SỦA -->
                    <Viewbox Width="44" Height="44" Stretch="Uniform">
                        <Canvas Width="64" Height="64">
                            <!-- Background gradient sáng hài hòa -->
                            <Ellipse Width="64" Height="64">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EFF6FF" Offset="0"/>
                                        <GradientStop Color="#DBEAFE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <!-- Tóc sau & ombre -->
                            <Path Data="M14,26 C14,16 22,10 32,10 C42,10 50,16 50,26 C50,38 46,48 46,48 C46,48 42,42 40,38 C38,34 38,30 38,30 C38,30 36,34 32,34 C28,34 26,30 26,30 C26,30 26,34 24,38 C22,42 18,48 18,48 C18,48 14,38 14,26 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#06B6D4" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="0.5"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- Khuôn mặt chibi -->
                            <Ellipse Canvas.Left="19" Canvas.Top="22" Width="26" Height="24" Fill="#FFE0BD"/>
                            <!-- Mắt trái ngọc bích -->
                            <Ellipse Canvas.Left="24.5" Canvas.Top="29.5" Width="5" Height="7" Fill="#00F090"/>
                            <Ellipse Canvas.Left="25" Canvas.Top="31" Width="2" Height="2" Fill="#FFFFFF"/>
                            <!-- Mắt phải ngọc bích -->
                            <Ellipse Canvas.Left="34.5" Canvas.Top="29.5" Width="5" Height="7" Fill="#00F090"/>
                            <Ellipse Canvas.Left="35" Canvas.Top="31" Width="2" Height="2" Fill="#FFFFFF"/>
                            <!-- Má hồng -->
                            <Ellipse Canvas.Left="22" Canvas.Top="37" Width="4" Height="2" Fill="#FF8BA7" Opacity="0.6"/>
                            <Ellipse Canvas.Left="38" Canvas.Top="37" Width="4" Height="2" Fill="#FF8BA7" Opacity="0.6"/>
                            <!-- Miệng cười -->
                            <Path Canvas.Left="30" Canvas.Top="38" Data="M0,0 C1,1.5 3,1.5 4,0" Stroke="#D97706" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Mái tóc sáng -->
                            <Path Data="M19,25 C22,22 26,21 32,21 C38,21 42,22 45,25 C44,28 42,30 40,28 C38,26 35,28 32,27 C29,28 26,26 24,28 C22,30 20,28 19,25 Z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                        <GradientStop Color="#C084FC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                            <!-- Headphone neon phát sáng -->
                            <Rectangle Canvas.Left="15" Canvas.Top="28" Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#2563EB"/>
                            <Rectangle Canvas.Left="45" Canvas.Top="28" Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#2563EB"/>
                            <Path Data="M17,28 C17,19 23,15 32,15 C41,15 47,19 47,28" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <!-- Ngôi sao vàng kẹp tóc -->
                            <Polygon Points="39,18 40.5,21.5 44,22 41.5,24.5 42,28 39,26 36,28 36.5,24.5 34,22 37.5,21.5" Fill="#FBBF24"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <!-- Online Green Dot với viền trắng nổi bật -->
                <Border Width="14"
                        Height="14"
                        CornerRadius="7"
                        Background="#16A34A"
                        BorderBrush="#FFFFFF"
                        BorderThickness="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-2,-2,0"/>
            </Grid>
        </Border>

        <!-- CHATBOT POPUP MODAL (THEME SÁNG THEO APP - KÍCH THƯỚC NHỎ GỌN) -->
        <Border x:Name="ChatbotModalBorder"
                Width="350"
                Height="480"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,18,162"
                Panel.ZIndex="5001"
                Visibility="Collapsed"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="6" Color="#64748B" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Quick prompts -->
                    <RowDefinition Height="Auto"/>
                    <!-- Messages list -->
                    <RowDefinition Height="*"/>
                    <!-- Footer input -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER THEO TÔNG XANH DƯƠNG CỦA APP -->
                <Border Grid.Row="0"
                        Background="#2563EB"
                        BorderBrush="#1D4ED8"
                        BorderThickness="0,0,0,1"
                        CornerRadius="16,16,0,0"
                        Padding="14,12">
                    <DockPanel LastChildFill="True">
                        <!-- Actions bên phải -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🧹"
                                    ToolTip="Xóa lịch sử trò chuyện"
                                    Padding="8,4"
                                    Background="Transparent"
                                    Foreground="#DBEAFE"
                                    BorderThickness="0"
                                    FontSize="13"
                                    Cursor="Hand"
                                    Click="ChatbotClearHistoryButton_Click"
                                    Margin="0,0,4,0"/>
                            <Button Content="✕"
                                    ToolTip="Thu nhỏ cửa sổ"
                                    Padding="8,4"
                                    Background="Transparent"
                                    Foreground="#DBEAFE"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="ChatbotCloseButton_Click"/>
                        </StackPanel>

                        <!-- Profile bên trái -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" Margin="0,0,10,0">
                                <TextBlock Text="🌸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChatbotHeaderNameText" Text="Ami 🌸" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                                    <TextBlock Text=" (Trợ Lý AI)" FontSize="12" Foreground="#DBEAFE" Margin="4,1,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#22C55E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Đang trực cùng Quản trị viên" FontSize="11" Foreground="#BFDBFE"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- QUICK PROMPTS (TÔNG SÁNG) -->
                <Border Grid.Row="1" Background="#F8FAFC" Padding="10,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📊 Tình hình phòng máy"
                                    Tag="Tình hình phòng máy hôm nay thế nào em ơi?"
                                    Background="#FFFFFF"
                                    Foreground="#334155"
                                    FontSize="11.5"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ChatbotQuickPrompt_Click"/>
                            <Button Content="🔍 Máy cần chú ý"
                                    Tag="Kiểm tra giúp anh xem có máy nào đang nợ dịch vụ hoặc cần chú ý không em?"
                                    Background="#FFFFFF"
                                    Foreground="#334155"
                                    FontSize="11.5"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ChatbotQuickPrompt_Click"/>
                            <Button Content="💰 Doanh thu hôm nay"
                                    Tag="Tạm tính tổng tiền giờ và doanh thu hiện tại bao nhiêu rồi em?"
                                    Background="#FFFFFF"
                                    Foreground="#334155"
                                    FontSize="11.5"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ChatbotQuickPrompt_Click"/>
                            <Button Content="💖 Động viên em ơi"
                                    Tag="Động viên anh một câu tiếp năng lượng đi em ơi! ✨"
                                    Background="#FFFFFF"
                                    Foreground="#334155"
                                    FontSize="11.5"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="ChatbotQuickPrompt_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- MESSAGES LIST -->
                <ScrollViewer x:Name="ChatbotScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10" Background="#F8FAFC">
                    <StackPanel>
                        <!-- Danh sách các bong bóng chat được nạp động từ C# -->
                        <StackPanel x:Name="ChatbotMessagesPanel"/>

                        <!-- Thinking Indicator -->
                        <Grid x:Name="ChatbotThinkingRow" Margin="0,4,0,8" Visibility="Collapsed" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#EFF6FF" BorderBrush="#2563EB" BorderThickness="1" Margin="0,0,8,0">
                                <TextBlock Text="🌸" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4,14,14,14" Padding="12,8">
                                <TextBlock Text="Ami đang suy nghĩ... ✨" FontSize="12.5" Foreground="#2563EB" FontStyle="Italic"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER INPUT -->
                <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatbotInputTextBox"
                                 Grid.Column="0"
                                 Background="#F8FAFC"
                                 Foreground="#0F172A"
                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"
                                 Padding="10,8"
                                 FontSize="13"
                                 TextWrapping="NoWrap"
                                 KeyDown="ChatbotInputTextBox_KeyDown"
                                 CaretBrush="#2563EB"/>
                        <Button x:Name="ChatbotSendButton"
                                Grid.Column="1"
                                Content="🚀"
                                ToolTip="Gửi tin nhắn (Enter)"
                                Width="40"
                                Height="36"
                                Margin="8,0,0,0"
                                Background="#2563EB"
                                Foreground="White"
                                FontSize="15"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="ChatbotSendButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="GlobalModalOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="9999" />
    </Grid>
</Window>