                                                <TextBox x:Name="LoyaltyWeekdayMultiplierTextBox"
                                                         Grid.Column="1"
                                                         Width="140"
                                                         Height="30"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="LoyaltyRateTextBox_TextChanged" />
                                            </Grid>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="280" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#334155"
                                                           Text="H&#x1ec7; s&#x1ed1; t&#x00ed;ch l&#x0169;y cu&#x1ed1;i tu&#x1ea7;n:" />
