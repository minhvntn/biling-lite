                                    </Border>
                                </TabItem>

                                <TabItem Header="Backup">
                                    <Border Margin="0,8,0,0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="270" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.ColumnSpan="2"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"
                                                       Text="Sao lưu dữ liệu tự động" />

                                            <CheckBox x:Name="AutoBackupEnabledCheckBox"
                                                      Grid.Row="1"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,10,0,0"
                                                      Content="Bật backup tự động từ backend"
                                                      Checked="AutoBackupConfigControl_Changed"
                                                      Unchecked="AutoBackupConfigControl_Changed" />

                                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Lịch backup:" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox x:Name="AutoBackupScheduleTypeComboBox"
                                                              Width="120"
                                                              SelectionChanged="AutoBackupConfigControl_Changed">
                                                        <ComboBoxItem Content="Hàng ngày" Tag="daily" />
                                                        <ComboBoxItem Content="Hàng tuần" Tag="weekly" />
                                                    </ComboBox>
                                                    <TextBlock Margin="12,0,6,0" VerticalAlignment="Center" Foreground="#334155" Text="Thứ:" />
                                                    <ComboBox x:Name="AutoBackupWeekdayComboBox"
                                                              Width="120"
                                                              SelectionChanged="AutoBackupConfigControl_Changed">
                                                        <ComboBoxItem Content="Thứ 2" Tag="1" />
                                                        <ComboBoxItem Content="Thứ 3" Tag="2" />
                                                        <ComboBoxItem Content="Thứ 4" Tag="3" />
                                                        <ComboBoxItem Content="Thứ 5" Tag="4" />
                                                        <ComboBoxItem Content="Thứ 6" Tag="5" />
                                                        <ComboBoxItem Content="Thứ 7" Tag="6" />
                                                        <ComboBoxItem Content="Chủ nhật" Tag="7" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Giờ chạy backup (HH:mm):" />
                                                <TextBox x:Name="AutoBackupTimeTextBox"
                                                         Grid.Column="1"
                                                         Width="110"
                                                         Height="30"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="02:00"
                                                         TextChanged="AutoBackupConfigTextChanged" />
                                            </Grid>

                                            <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Thư mục lưu backup:" />
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AutoBackupDirectoryTextBox"
                                                             Grid.Column="0"
                                                             Height="30"
                                                             VerticalContentAlignment="Center"
                                                             TextChanged="AutoBackupConfigTextChanged" />
                                                    <Button Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="12,6"
                                                            Content="Chọn thư mục..."
                                                            Click="BrowseBackupDirectoryButton_Click" />
                                                    <Button Grid.Column="2"
                                                            Margin="8,0,0,0"
                                                            Padding="12,6"
                                                            Content="Mở thư mục"
                                                            Click="OpenBackupDirectoryButton_Click" />
                                                </Grid>
                                            </Grid>

                                            <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="270" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#334155" Text="Giữ file backup (ngày):" />
                                                <TextBox x:Name="AutoBackupRetentionDaysTextBox"
                                                         Grid.Column="1"
                                                         Width="110"
                                                         Height="30"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="30"
                                                         TextChanged="AutoBackupConfigTextChanged" />
                                            </Grid>

                                            <StackPanel Grid.Row="6"
                                                        Grid.ColumnSpan="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,12,0,0">
                                                <Button Padding="14,7"
                                                        Margin="0,0,8,0"
                                                        Content="Lưu lịch backup"
                                                        Click="SaveBackupSettingsButton_Click" />
                                                <Button x:Name="RunBackupNowButton"
                                                        Padding="14,7"
                                                        Margin="0,0,8,0"
                                                        Content="Backup ngay"
                                                        Click="RunBackupNowButton_Click" />
                                                <Button x:Name="ImportBackupFileButton"
                                                        Padding="14,7"
                                                        Content="Import backup..."
                                                        Click="ImportBackupFileButton_Click" />
                                            </StackPanel>

                                            <TextBlock x:Name="AutoBackupStatusTextBlock"
                                                       Grid.Row="7"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,8,0,0"
                                                       Foreground="#64748B"
                                                       Text="Đang tải cài đặt backup..." />
                                            <TextBlock x:Name="AutoBackupLastRunTextBlock"
                                                       Grid.Row="8"
                                                       Grid.ColumnSpan="2"
                                                       Margin="0,8,0,0"
                                                       Foreground="#64748B"
                                                       Text="Lần backup gần nhất: -" />
                                        </Grid>
                                    </Border>
                                </TabItem>
                            </TabControl>

                            <StackPanel Grid.Row="4">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Button Padding="14,7" Margin="0,0,8,0" Click="SaveFontSizeButton_Click" Content="Lưu cài đặt" />
                                    <Button Padding="14,7" Click="ResetFontSizeButton_Click" Content="Đặt lại mặc định" />
                                </StackPanel>

                                <TextBlock Margin="0,10,0,0"
                                           Foreground="#64748B"
                                           Text="Thông tin: Cỡ chữ được xem trước ngay khi kéo thanh trượt." />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="AdminTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="&#x1F510;" Margin="0,0,6,0" FontSize="20" />
                            <TextBlock VerticalAlignment="Center" Text="Admin" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabControl Margin="8">
