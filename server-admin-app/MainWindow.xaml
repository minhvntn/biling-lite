                                                         Grid.Column="1"
                                                         Width="140"
                                                         Height="30"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="LoyaltyRateTextBox_TextChanged" />
                                            </Grid>
                                            <TextBlock x:Name="LoyaltySettingsStatusTextBlock"
                                                       Margin="0,8,0,0"
                                                       Foreground="#64748B"
