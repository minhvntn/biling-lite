<Window x:Class="Server.Admin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:local="clr-namespace:Server.Admin.App"
        xmlns:controls="clr-namespace:Server.Admin.App.Windows.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{x:Static local:I18n.MainWindowTitle}"
        Height="900"
        Width="1550"
        MinHeight="720"
        MinWidth="1240"
        PreviewMouseDown="Window_PreviewMouseDown"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2563EB" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F8FAFC" />
        <Thickness x:Key="MachineContextMenuItemPadding">12</Thickness>
        <sys:Double x:Key="MachineContextMenuFontSize">14</sys:Double>

        <Style x:Key="BoldBlackDataGridText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SeparatorVisibility" Value="Collapsed" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#F1F5F9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="{x:Static DataGrid.FocusBorderBrushKey}" Color="#93C5FD" />

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsKeyboardFocusWithin" Value="True" />
                        <Condition Property="IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabRoot"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </Border.Resources>
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#BFDBFE" />
                                <Setter TargetName="TabRoot" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter TargetName="TabRoot" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="TabRoot" Property="Background" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Main TabControl Style -->
        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            
                            <!-- Header Panel Background and Layout -->
                            <Border Grid.Row="0" 
                                    Background="White" 
                                    BorderBrush="#F1F5F9" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="16,8,16,4">
                                <Grid>
                                    <!-- Nơi chứa các tab items header -->
                                    <TabPanel x:Name="HeaderPanel" 
                                              IsItemsHost="True" 
                                              KeyboardNavigation.TabIndex="1" 
                                              VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            
                            <!-- Tab Content -->
                            <Border Grid.Row="1" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" 
                                                   ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho TextBlock Icon trong Tab Header -->
        <Style x:Key="TabIconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" /> <!-- Mặc định màu Slate dịu mắt -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="#2563EB" /> <!-- Màu xanh Primary khi active -->
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="#2563EB" /> <!-- Màu xanh Primary khi hover -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho TextBlock Nhãn trong Tab Header -->
        <Style x:Key="TabHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#475569" /> <!-- Mặc định màu Slate trung tính thanh lịch -->
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="#2563EB" /> <!-- Màu xanh Primary khi active -->
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                    <Setter Property="Foreground" Value="#2563EB" /> <!-- Màu xanh Primary khi hover -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Main TabItem Style -->
        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="TabRoot" Margin="2,0,2,0" Background="Transparent" Cursor="Hand">
                            <!-- Nền của Tab, bo góc -->
                            <Border x:Name="BackgroundBorder" 
                                    Background="Transparent" 
                                    CornerRadius="6" 
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,0,2">
                                <ContentPresenter x:Name="ContentSite"
                                                   ContentSource="Header"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RecognizesAccessKey="True" />
                            </Border>
                            
                            <!-- Đường gạch chân indicator -->
                            <Border x:Name="Indicator" 
                                    Height="3" 
                                    Background="#2563EB" 
                                    CornerRadius="1.5,1.5,0,0"
                                    VerticalAlignment="Bottom" 
                                    Margin="6,0,6,0"
                                    Visibility="Collapsed" />

                            <!-- Separator line (viền ngăn cách) -->
                            <Border Width="1" Background="#E2E8F0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="18" Margin="0,0,-2,0" />
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#EFF6FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="#EFF6FF" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppButtonBaseStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#1D4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#CBD5E1" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#94A3B8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Hủy">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Huỷ">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Cancel">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Xóa">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Xoá">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="Delete">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#B91C1C" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}" />

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonBaseStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B91C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- Collapsed Status Server controls to satisfy code-behind references -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="HealthTextBlock" />
                <TextBlock x:Name="ServerIpTextBlock" />
            </StackPanel>

            <Border DockPanel.Dock="Top" Background="#0066cc" BorderBrush="#2563EB" BorderThickness="0">
                <Border.Resources>
                    <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem">
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="FontWeight" Value="Medium" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="MenuItem">
                                    <Grid x:Name="Grid">
                                        <Border x:Name="Border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                        </Border>
                                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4">
                                                <Border.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Foreground" Value="Black" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Setter Property="Padding" Value="10,6" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="MenuItem">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Icon" MinWidth="24"/>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut" />
                                                                                <ColumnDefinition Width="16" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                            <ContentPresenter ContentSource="Header" Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                                                            <TextBlock Text="{TemplateBinding InputGestureText}" Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#888" />
                                                                            <Path x:Name="RightArrow" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Data="M 0 0 L 4 4 L 0 8 Z" Fill="Black" Visibility="Collapsed" />
                                                                            <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                                                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="2,0,0,0">
                                                                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                                                                </Border>
                                                                            </Popup>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="Role" Value="SubmenuHeader">
                                                                            <Setter TargetName="RightArrow" Property="Visibility" Value="Visible"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                    <Style TargetType="Separator">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Separator">
                                                                    <Border Height="1" Background="#E2E8F0" Margin="0,4" />
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Border.Resources>
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsSubmenuOpen" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="HeaderButtonStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Menu Grid.Column="0" Background="Transparent" FontSize="13.5" Margin="4,2">
                        <MenuItem Header="Công cụ" Style="{StaticResource TopLevelMenuItemStyle}" Padding="12,5" Height="32" VerticalContentAlignment="Center" Foreground="White">
                            <MenuItem Header="Tải lại toàn bộ dữ liệu (F5)" InputGestureText="F5" Click="ReloadAllData_Click" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="🔄" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Kiểm tra hệ thống &amp; Database" Click="CheckSystemAndDatabaseHealth_Click" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="🩺" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Tự động sửa chữa sự cố (1-Click)" Click="QuickAutoRepair_Click" Foreground="#6D28D9" FontWeight="SemiBold" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="⚡" Foreground="#7C3AED" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Mở máy trạm" Click="OpenWakeUpMachinesDialog_Click" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Thông tin" Click="ShowServerInfoMenuItem_Click" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Hiển thị máy trạm" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock Text="" />
                                </MenuItem.Icon>
                                <MenuItem x:Name="ViewModeListMenuItem" Header="Dạng danh sách" Click="ViewModeList_Click" FontWeight="Bold" Foreground="Black" FontSize="15" Padding="12,8">
                                    <MenuItem.Icon>
                                        <TextBlock Text="✔" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ViewModeIconMenuItem" Header="Dạng biểu tượng" Click="ViewModeIcon_Click" FontSize="15" Padding="12,8">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="ShowOfflineMachinesMenuItem" Header="Hiển thị máy trạm mất kết nối" Click="ShowOfflineMachines_Click" Foreground="Black" FontSize="15" Padding="12,8">
                                <MenuItem.Icon>
                                    <TextBlock x:Name="ShowOfflineMachinesIcon" Text="" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>

                    <Button Grid.Column="1"
                            x:Name="ReloadAllDataButton" 
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,8,0" 
                            Click="ReloadAllData_Click" 
                            ToolTip="Tải lại toàn bộ dữ liệu và kết nối lại máy chủ (Phím tắt: F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ReloadAllDataButtonText" Text="Tải lại (F5)" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="ToggleAppModeButton"
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,8,0"
                            Click="ToggleAppModeButton_Click"
                            ToolTip="Chuyển đổi giao diện Bản Lite / Bản Pro">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ModeIconTextBlock" Text="🍂" Foreground="White" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModeTextLabel" Text="Bản Lite" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            x:Name="LogoutButton" 
                            Style="{StaticResource HeaderButtonStyle}"
                            Margin="0,0,8,0" 
                            Click="LogoutButton_Click" 
                            ToolTip="Đăng nhập tài khoản quản trị">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LogoutIconTextBlock" Text="🔑" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="LogoutTextLabel" Text="Đăng nhập" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="13" FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <Ellipse x:Name="HealthIndicator" 
                             Grid.Column="4" 
                             Width="10" 
                             Height="10" 
                             Fill="#94A3B8" 
                             Stroke="White" 
                             StrokeThickness="1" 
                             Margin="4,0,16,0" 
                             VerticalAlignment="Center" 
                             Cursor="Help"
                             ToolTip="{Binding ElementName=HealthTextBlock, Path=Text}" />
                </Grid>
            </Border>

            <TabControl x:Name="MainTabControl" Style="{StaticResource MainTabControlStyle}" Margin="0" SelectionChanged="MainTabControl_SelectionChanged">
                <TabItem x:Name="WorkstationsTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F5A5;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="{x:Static local:I18n.WorkstationsTab}" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Margin="0,0,6,0" Padding="10,5" Click="RefreshMachinesButton_Click" Content="{x:Static local:I18n.Refresh}" />
                            <Button Grid.Column="1" Margin="0,0,6,0" Padding="10,5" Click="OpenMachineButton_Click" Content="{x:Static local:I18n.OpenMachine}" />
                            <Button Grid.Column="2" Margin="0,0,6,0" Padding="10,5" Click="LockMachineButton_Click" Content="{x:Static local:I18n.LockMachine}" />
                            <Button Grid.Column="3" Margin="0,0,6,0" Padding="10,5" Click="UnlockAllFilterButton_Click" Content="{x:Static local:I18n.ClearFilter}" />

                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="0,0,6,0" Text="{x:Static local:I18n.StatusLabel}" />
                            <ComboBox x:Name="StatusFilterComboBox"
                                      Grid.Column="6"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="StatusFilterComboBox_SelectionChanged">
                                <ComboBoxItem Content="Tất cả" IsSelected="True" />
                                <ComboBoxItem Content="Đang sử dụng" />
                                <ComboBoxItem Content="Đang tắt" />
                                <ComboBoxItem Content="Sẵn sàng" />
                                <ComboBoxItem Content="Offline" />
                            </ComboBox>

                            <TextBlock Grid.Column="8" VerticalAlignment="Center" Margin="0,0,6,0" Text="{x:Static local:I18n.SearchMachineLabel}" />
                            <TextBox x:Name="SearchTextBox" Grid.Column="9" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />

                            <TextBlock Grid.Column="11" VerticalAlignment="Center" x:Name="LastSyncTextBlock" Text="{x:Static local:I18n.SyncDefault}" />
                        </Grid>

                        <DataGrid x:Name="MachinesDataGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  RowHeaderWidth="0"
                                  AlternationCount="2"
                                  ColumnWidth="*"
                                  ContextMenuOpening="MachinesDataGrid_ContextMenuOpening"
                                  MouseDoubleClick="MachinesDataGrid_MouseDoubleClick"
                                  SelectionChanged="MachinesDataGrid_SelectionChanged">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="MachinesDataGridRow_PreviewMouseRightButtonDown" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ContextMenu>
                                <ContextMenu FontSize="{DynamicResource MachineContextMenuFontSize}">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Padding" Value="{DynamicResource MachineContextMenuItemPadding}" />
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="ContextOpenMachineMenuItem" Header="Mở máy" Click="ContextOpenMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextOpenGuestMachineMenuItem" Header="Đăng nhập trả tiền trước..." Click="ContextOpenGuestMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextAdminLoginMachineMenuItem" Header="Đăng nhập admin máy trạm" Click="ContextAdminLoginMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextLockMachineMenuItem" Header="Khóa máy" Click="ContextLockMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextChatMenuItem" Header="Nhắn tin" Click="ContextChatMenuItem_Click" />
                                    <!-- <MenuItem x:Name="ContextViewAppUsageMenuItem" Header="Xem ứng dụng đang chạy" Click="ContextViewAppUsageMenuItem_Click" /> -->
                                    <MenuItem x:Name="ContextTopupMachineMemberMenuItem" Header="Nạp tiền hội viên đang dùng máy..." Click="ContextTopupMachineMemberMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextRestartMachineMenuItem" Header="Khởi động lại máy trạm" Click="ContextRestartMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextWakeRemoteMachineMenuItem" Header="Khởi động máy trạm từ xa" Click="ContextWakeRemoteMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextShutdownMachineMenuItem" Header="Tắt máy trạm">
                                        <MenuItem x:Name="ContextShutdownSelectedMachineMenuItem"
                                                  Header="Tắt máy đã chọn"
                                                  Click="ContextShutdownSelectedMachineMenuItem_Click" />
                                        <MenuItem x:Name="ContextShutdownReadyMachinesMenuItem"
                                                  Header="Tắt các máy sẵn sàng"
                                                  Click="ContextShutdownReadyMachinesMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem x:Name="ContextControlMachineMenuItem" Header="Điều khiển máy trạm">
                                        <MenuItem x:Name="ContextControlCloseAppsMenuItem"
                                                  Header="Đóng ứng dụng..."
                                                  Click="ContextCloseAppsMenuItem_Click" />
                                        <MenuItem x:Name="ContextControlRemoteMenuItem"
                                                  Header="Điều khiển máy trạm (Live)"
                                                  Click="ContextRemoteControlMachineMenuItem_Click" />
                                        <MenuItem x:Name="ContextControlScreenshotMenuItem"
                                                  Header="Chụp màn hình máy trạm"
                                                  Click="ContextCaptureScreenshotMachineMenuItem_Click" />
                                    </MenuItem>
                                    <MenuItem x:Name="ContextControlCloseAllAppsMenuItem"
                                              Header="Đóng tất cả ứng dụng (Taskbar)"
                                              Click="ContextCloseAllAppsMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextPauseMachineMenuItem"
                                              Header="Tạm nghỉ máy trạm"
                                              Click="ContextPauseMachineMenuItem_Click"
                                              Visibility="Collapsed" />
                                    <MenuItem x:Name="ContextResumeMachineMenuItem"
                                              Header="Tiếp tục sử dụng"
                                              Click="ContextResumeMachineMenuItem_Click"
                                              Visibility="Collapsed" />
                                    <MenuItem x:Name="ContextTransferMachineMenuItem" Header="Chuyển máy" Click="ContextTransferMachineMenuItem_Click" />
                                    <MenuItem x:Name="ContextAssignGroupMenuItem" Header="Chuyển nhóm máy">
                                        <MenuItem Header="Đang tải nhóm máy..." IsEnabled="False" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem x:Name="ContextViewMachineBillingMenuItem" Header="Thanh toán..." Click="ContextViewMachineBillingMenuItem_Click" />
                                    <MenuItem x:Name="ContextPayServiceMenuItem" Header="Thanh toán dịch vụ..." Click="ContextPayServiceMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Làm mới danh sách" Click="ContextRefreshMachinesMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextSelectServiceMenuItem" Header="Chọn dịch vụ..." Click="ContextSelectServiceMenuItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC" />
                                    <Setter Property="Foreground" Value="#475569" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="10,8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="SeparatorVisibility" Value="Collapsed" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Tên" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <svgc:SvgViewbox Source="{Binding StatusIconPath}"
                                                                 Width="32"
                                                                 Height="32"
                                                                 Margin="4,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="{Binding StatusIconToolTip}" />
                                                <TextBlock Text="{Binding Name}" 
                                                           VerticalAlignment="Center" 
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tình trạng" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,3">
                                                <!-- Status Pill Tag -->
                                                <Border CornerRadius="12" Padding="8,3" BorderThickness="1" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#F1F5F9" />
                                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorOnlineBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="#A7F3D0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorInUseBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorOfflineBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ColorAdminBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="#FDE047" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOfflineUnpaidGuest}" Value="True">
                                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <!-- Status dot -->
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#94A3B8" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                                            <Setter Property="Fill" Value="#10B981" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                                            <Setter Property="Fill" Value="#3B82F6" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                                            <Setter Property="Fill" Value="#94A3B8" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                                            <Setter Property="Fill" Value="#EAB308" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOfflineUnpaidGuest}" Value="True">
                                                                            <Setter Property="Fill" Value="#EF4444" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <!-- Status text -->
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#64748B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorOnlineFgBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorInUseFgBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                                            <Setter Property="Foreground" Value="#64748B" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorOfflineFgBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ColorAdminFgBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOfflineUnpaidGuest}" Value="True">
                                                                            <Setter Property="Foreground" Value="#DC2626" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Status SubText badge -->
                                                <Border CornerRadius="4" 
                                                        Background="#FEF2F2" 
                                                        BorderBrush="#FECACA" 
                                                        BorderThickness="1" 
                                                        Padding="5,1" 
                                                        Margin="0,2,0,0" 
                                                        HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusSubText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusSubText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusSubText}"
                                                               FontSize="10.5"
                                                               FontWeight="Bold"
                                                               Foreground="#DC2626"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Người sử dụng" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,4">
                                                <TextBlock Text="{Binding UserName}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Margin="5,0,0,0" 
                                                        Padding="4,1" 
                                                        CornerRadius="4" 
                                                        Background="#FEF3C7" 
                                                        BorderBrush="#FDE68A" 
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVipSession}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="VIP" FontSize="10" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Bắt đầu" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StartedAtText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Đã sử dụng" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" 
                                                    Padding="8,2" 
                                                    Margin="4,2"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ColorUsedTimeBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="#FECACA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding UsedText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorUsedTimeFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Còn lại" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" 
                                                    Padding="8,2" 
                                                    Margin="4,2"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ColorRemainingTimeBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding RemainingText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ColorRemainingTimeFgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tiền" Width="0.8*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MoneyText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tiền dịch vụ" Width="0.9*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,2"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderBrush" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasServiceDebtHighlight}" Value="True">
                                                                <Setter Property="Background" Value="#CCFBF1" />
                                                                <Setter Property="BorderBrush" Value="#99F6E4" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasPendingClientServiceOrderHighlight}" Value="True">
                                                                <Setter Property="Background" Value="#F3E8FF" />
                                                                <Setter Property="BorderBrush" Value="#E9D5FF" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ServiceAmountText}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0F172A" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasServiceDebtHighlight}" Value="True">
                                                                    <Setter Property="Foreground" Value="#0D9488" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasPendingClientServiceOrderHighlight}" Value="True">
                                                                    <Setter Property="Foreground" Value="#7E22CE" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="MachineDateColumn" Header="Ngày" Width="0.95*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DateText}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="MachineIpColumn" Header="IP" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IpAddress}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="MachineGroupColumn" Header="Nhóm" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupName}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Icon View (toggled via Công cụ > Hiển thị máy trạm) -->
                        <ScrollViewer x:Name="MachinesIconView"
                                      Grid.Row="2"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="MachinesIconItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="IconCard"
                                                Width="120" Height="120"
                                                Margin="6"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="#CBD5E1"
                                                Background="#F8FAFC"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="MachineIconCard_MouseLeftButtonDown"
                                                MouseRightButtonDown="MachineIconCard_MouseRightButtonDown">
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="320">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="0,0,0,4" />
                                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                                        <TextBlock Text="{Binding StatusSubText}" Foreground="#DC2626" FontSize="11" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusSubText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Separator Margin="0,4" />
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Người dùng: " /><Run Text="{Binding UserName, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Bắt đầu: " /><Run Text="{Binding StartedAtText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Đã dùng: " /><Run Text="{Binding UsedText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Còn lại: " /><Run Text="{Binding RemainingText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Tiền: " /><Run Text="{Binding MoneyText, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="IP: " /><Run Text="{Binding IpAddress, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock FontSize="12"><Run FontWeight="SemiBold" Text="Nhóm: " /><Run Text="{Binding GroupName, Mode=OneWay}" /></TextBlock>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <svgc:SvgViewbox Source="{Binding StatusIconPath}"
                                                                 Width="48" Height="48"
                                                                 HorizontalAlignment="Center"
                                                                 ToolTip="{Binding StatusIconToolTip}" />
                                                <TextBlock Text="{Binding Name}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110" />
                                                <TextBlock Text="{Binding StatusText}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           FontSize="10"
                                                           Margin="0,1,0,0"
                                                           Foreground="{Binding StatusBrush}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110" />
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="IN_USE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#EFF6FF" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#93C5FD" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="ONLINE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#ECFDF5" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#86EFAC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="LOCKED">
                                                <Setter TargetName="IconCard" Property="Background" Value="#FEF2F2" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#FCA5A5" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusCode}" Value="OFFLINE">
                                                <Setter TargetName="IconCard" Property="Background" Value="#F1F5F9" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#94A3B8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAdminSession}" Value="True">
                                                <Setter TargetName="IconCard" Property="Background" Value="#FEF9C3" />
                                                <Setter TargetName="IconCard" Property="BorderBrush" Value="#FDE047" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       x:Name="SelectionTextBlock"
                                       VerticalAlignment="Center"
                                       Text="Chưa chọn máy" />

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Border Margin="0,0,6,0" Padding="9,4" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryTotalTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#334155" Text="Tổng máy: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="9,4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryMemberCountTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#1D4ED8" Text="Tổng hội viên: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="9,4" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryUsingTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#047857" Text="Đang sử dụng: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="9,4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryLockedTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#64748B" Text="Đang tắt: 0" />
                                </Border>
                                <Border Margin="0,0,6,0" Padding="9,4" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryOfflineTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#DC2626" Text="Mất kết nối: 0" />
                                </Border>
                                <Border Padding="9,4" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="6">
                                    <TextBlock x:Name="SummaryMoneyTextBlock" FontWeight="SemiBold" FontSize="12.5" Foreground="#C2410C" Text="Tiền tạm tính: 0" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="MembersTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F464;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Hội viên" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0" Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header & Stats Cards -->
                        <Grid Grid.Row="0" Margin="3,4,3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Search -->
                                <Border Width="270" Height="38" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7" Background="White" Padding="12,0" Margin="0,0,8,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="MembersSearchPlaceholderTextBlock" 
                                                   Grid.Column="0"
                                                   Text="Tìm kiếm hội viên" 
                                                   Foreground="#94A3B8" 
                                                   FontSize="13" 
                                                   VerticalAlignment="Center" 
                                                   IsHitTestVisible="False" 
                                                   Margin="2,0,0,0"/>

                                        <TextBox x:Name="MembersSearchTextBox" 
                                                 Grid.Column="0"
                                                 BorderThickness="0" 
                                                 Background="Transparent" 
                                                 VerticalContentAlignment="Center" 
                                                 FontSize="13" 
                                                 Foreground="#1E293B"
                                                 Padding="0,1"
                                                 TextChanged="MembersSearchTextBox_TextChanged" 
                                                 KeyDown="MembersSearchTextBox_KeyDown" />

                                        <Button x:Name="ClearMembersSearchButton" 
                                                Grid.Column="1" 
                                                Click="ClearMembersSearchButton_Click" 
                                                Visibility="Collapsed" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Cursor="Hand" 
                                                Padding="4,0,2,0" 
                                                VerticalAlignment="Center" 
                                                ToolTip="Xóa tìm kiếm (Esc)">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="#E2E8F0">
                                                <TextBlock Text="&#x2715;" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0"/>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Actions -->
                                <Button Height="32" Background="#2563EB" BorderThickness="0" Foreground="White" Padding="12,0" Margin="0,0,6,0" Click="AddMemberButton_Click" Content="+ Thêm hội viên" FontSize="12" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="ImportGcafeMemberButton" Height="32" Background="#7C3AED" BorderThickness="0" Foreground="White" Padding="10,0" Margin="0,0,6,0" Click="ImportGcafeButton_Click" Content="&#x1F4E5; Nhập GCafe" FontSize="12" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Height="32" Background="#059669" BorderThickness="0" Foreground="White" Padding="10,0" Margin="0,0,6,0" Click="ContextTopupMemberMenuItem_Click" Content="&#x1F4B5; Nạp tiền" FontSize="12" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button x:Name="PurgeInactiveMembersButton" Height="32" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" Foreground="#DC2626" Padding="8,0" Margin="0,0,8,0" Click="PurgeInactiveMembersButton_Click" Content="&#x1F9F9; Dọn rác" ToolTip="Xóa các tài khoản không đăng nhập > 6 tháng, số dư &lt; 500đ và tổng nạp &lt; 100.000đ" FontSize="11.5" FontWeight="SemiBold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <CheckBox x:Name="HideInactiveMembersCheckBox" 
                                          Content="Ẩn >30 ngày" 
                                          IsChecked="True" 
                                          VerticalAlignment="Center" 
                                          Margin="2,0,0,0" 
                                          Foreground="#475569" 
                                          FontSize="11.5" 
                                          FontWeight="Medium"
                                          Cursor="Hand"
                                          Click="HideInactiveMembersCheckBox_Click" 
                                          ToolTip="Tự động ẩn hội viên không hoạt động trong 30 ngày. Khi tìm kiếm tên/SĐT sẽ tự động tìm trên tất cả hội viên." />
                            </StackPanel>

                            <Grid Grid.Column="1" HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Total Members -->
                                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#EFF6FF" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F465;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng hội viên" FontSize="10" Foreground="#64748B" Margin="0,0,0,1"/>
                                            <TextBlock x:Name="StatTotalMembersTextBlock" Text="0" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock x:Name="StatTotalMembersTodayTextBlock" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- VIP Members -->
                                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#F3E8FF" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F451;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hội viên VIP" FontSize="10" Foreground="#64748B" Margin="0,0,0,1"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="StatVipMembersTextBlock" Text="0" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                <TextBlock x:Name="StatVipPercentTextBlock" Text=" (0%)" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Total Balance -->
                                <Border x:Name="StatTotalBalanceCardBorder" Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#ECFDF5" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4B5;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng số dư" FontSize="10" Foreground="#64748B" Margin="0,0,0,1"/>
                                            <TextBlock x:Name="StatTotalBalanceTextBlock" Text="0" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock x:Name="StatTotalBalanceTodayTextBlock" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Total Play Hours -->
                                <Border x:Name="StatTotalHoursCardBorder" Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="7,4" Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#FFFBEB" VerticalAlignment="Center">
                                            <TextBlock Text="&#x23F2;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng giờ chơi" FontSize="10" Foreground="#64748B" Margin="0,0,0,1"/>
                                            <TextBlock x:Name="StatTotalHoursTextBlock" Text="0h" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock x:Name="StatTotalHoursTodayTextBlock" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Total Topup -->
                                <Border x:Name="StatTotalTopupCardBorder" Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="7,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="6" Background="#FEF2F2" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4CA;" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng nạp" FontSize="10" Foreground="#64748B" Margin="0,0,0,1"/>
                                            <TextBlock x:Name="StatTotalTopupTextBlock" Text="*****" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock x:Name="StatTotalTopupTodayTextBlock" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" x:Name="ToggleTotalTopupEyeButton" Click="ToggleTotalTopupEyeButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="2,0" VerticalAlignment="Center" ToolTip="Bấm để ẩn / hiện số tiền tổng nạp">
                                            <TextBlock x:Name="TotalTopupEyeIcon" Text="&#x1F441;" FontSize="12.5" Foreground="#64748B" Opacity="0.6"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Content Area -->
                        <Grid Grid.Row="1" Margin="3,4,3,16" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- DataGrid -->
                            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,16,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <DataGrid x:Name="MembersDataGrid"
                                              Grid.Row="0"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9"
                                              VerticalGridLinesBrush="Transparent"
                                              BorderThickness="0"
                                              Background="Transparent"
                                              AlternationCount="2"
                                              RowHeight="50"
                                              RowHeaderWidth="0"
                                              ContextMenuOpening="MembersDataGrid_ContextMenuOpening"
                                              MouseDoubleClick="MembersDataGrid_MouseDoubleClick"
                                              SelectionChanged="MembersDataGrid_SelectionChanged">
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="8,0" />
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="16,12"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="MembersDataGridRow_PreviewMouseRightButtonDown" />
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="MembersDataGridRow_PreviewMouseLeftButtonDown" />
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                                <Style.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#2563EB"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                    </MultiTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu FontSize="{DynamicResource MachineContextMenuFontSize}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Padding" Value="{DynamicResource MachineContextMenuItemPadding}" />
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Xem / sửa hội viên..." Click="ContextEditMemberMenuItem_Click" />
                                                <MenuItem Header="Đổi mật khẩu..." Click="ChangeMemberPasswordButton_Click" />
                                                <Separator />
                                                <MenuItem Header="Nạp tiền" Click="ContextTopupMemberMenuItem_Click" />
                                                <MenuItem Header="Chuyển tiền cho hội viên..." Click="ContextTransferMemberMenuItem_Click" />
                                                <MenuItem Header="Nhật ký giao dịch..." Click="ContextMemberTransactionsMenuItem_Click" />
                                                <MenuItem Header="Nhật ký sử dụng máy..." Click="ContextMemberUsageLogsMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="Tiền trả lại" Click="ContextRefundMemberMenuItem_Click" />
                                                <MenuItem Header="Tặng tiền miễn phí" Click="ContextGiftMemberMenuItem_Click" />
                                                <Separator />
                                                <MenuItem Header="Xóa hội viên" Click="ContextDeleteMemberMenuItem_Click" />
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>

                                            <DataGridTemplateColumn Width="*" MinWidth="150">
                                                <DataGridTemplateColumn.Header>
                                                    <TextBlock Text="Tên đăng nhập" Margin="4,0,0,0"/>
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding Username}" FontWeight="SemiBold" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Hạng VIP" Width="0.8*" MinWidth="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding RankBackground}" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Rank}" Foreground="{Binding RankForeground}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Loại hội viên" Width="1*" MinWidth="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding MemberTypeText}" Foreground="{Binding TypeForeground}" FontSize="11" FontWeight="Medium"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Số dư (VND)" Binding="{Binding BalanceText}" Width="1*" MinWidth="130" ElementStyle="{StaticResource BoldBlackDataGridText}" />
                                            <DataGridTextColumn x:Name="MemberTotalTopupColumn" Header="Tổng nạp (VND)" Binding="{Binding TotalTopupText}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource BoldBlackDataGridText}" />
                                            <DataGridTextColumn Header="Giờ chơi KM" Binding="{Binding PlayHoursText}" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource BoldBlackDataGridText}" />
                                            <DataGridTemplateColumn Header="Trạng thái" Width="1*" MinWidth="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding ActiveText}" FontSize="12">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#0F172A"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                <Setter Property="Foreground" Value="White"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Thao tác" Width="0.6*" MinWidth="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Width="32" Height="32" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#64748B" HorizontalAlignment="Center" Click="MemberRowOptionsButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            <TextBlock Text="⋮" FontSize="16"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Pagination Footer -->
                                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="PaginationInfoTextBlock" Text="Hiển thị toàn bộ hội viên" Foreground="#64748B" VerticalAlignment="Center" FontSize="13"/>
                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Toggle Button: Phân trang (Mặc định: TẮT) -->
                                                <Button x:Name="MembersPaginationToggleButton"
                                                        Height="32"
                                                        Padding="10,0"
                                                        Margin="0,0,10,0"
                                                        Background="#F1F5F9"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        Foreground="#475569"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand"
                                                        Click="MembersPaginationToggleButton_Click">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6"/>
                                                        </Style>
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="MembersPaginationToggleIcon" Text="⚪" Margin="0,0,6,0" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="MembersPaginationToggleText" Text="Phân trang: TẮT" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Pagination Navigation (Chỉ hiện khi BẬT phân trang) -->
                                                <StackPanel x:Name="MembersPaginationControlsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                    <Button x:Name="MembersPrevPageButton" Content="&lt;" Width="32" Height="32" Background="White" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,4,0" Click="MembersPrevPageButton_Click"/>
                                                    
                                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="32" Padding="12,0" Margin="0,0,4,0">
                                                        <TextBlock x:Name="MembersPageNumberTextBlock" Text="1 / 1" VerticalAlignment="Center" Foreground="#0F172A"/>
                                                    </Border>

                                                    <Button x:Name="MembersNextPageButton" Content="&gt;" Width="32" Height="32" Background="White" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" Click="MembersNextPageButton_Click"/>
                                                    
                                                    <ComboBox x:Name="MembersPageSizeComboBox" Width="100" SelectedIndex="2" SelectionChanged="MembersPageSizeComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="10 / trang" Tag="10"/>
                                                        <ComboBoxItem Content="20 / trang" Tag="20"/>
                                                        <ComboBoxItem Content="50 / trang" Tag="50"/>
                                                        <ComboBoxItem Content="100 / trang" Tag="100"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Sidebar Detail -->
                            <Border x:Name="MemberDetailSidebarBorder"
                                    Grid.Column="1"
                                    Width="320"
                                    Background="White"
                                    CornerRadius="8"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Padding="20"
                                    Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="MemberSidebarTranslate" X="0" Y="0"/>
                                </Border.RenderTransform>
                                <Grid x:Name="MemberDetailSidebarContentGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Header (Title + Status + Close Button) -->
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Thông tin hội viên" FontWeight="Bold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ActiveText}" Foreground="#059669" FontSize="12" FontWeight="Medium"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                x:Name="CloseMemberSidebarButton"
                                                Click="CloseMemberSidebarButton_Click"
                                                Width="26" Height="26"
                                                Background="#F1F5F9"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Đóng thông tin">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="13">
                                                        <TextBlock Text="&#x2715;" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                                                            <Setter Property="Foreground" Value="#0F172A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <!-- Profile Info -->
                                    <Grid Grid.Row="1" Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,12,0" VerticalAlignment="Top">
                                            <Border CornerRadius="28" Background="#E2E8F0" Visibility="{Binding AvatarFallbackVisibility}">
                                                <TextBlock Text="{Binding AvatarInitial}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#64748B" />
                                            </Border>
                                            <Border CornerRadius="28" Background="{Binding AvatarBrush}" Visibility="{Binding AvatarImageVisibility}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="18" Foreground="#0F172A" Margin="0,0,8,0"/>
                                                <TextBlock Text="&#x2714;" Foreground="#3B82F6" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Border Background="{Binding TypeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MemberTypeText}" Foreground="{Binding TypeForeground}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Background="{Binding RankBackground}" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Rank}" Foreground="{Binding RankForeground}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Thống kê cá nhân (3 boxes) -->
                                    <Grid Grid.Row="2" Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Số dư" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding BalanceText}" FontWeight="Bold" FontSize="12" Foreground="#10B981" HorizontalAlignment="Center"/>
                                                <TextBlock Text="VND" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="MemberDetailsTotalTopupBorder" Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,4,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Tổng nạp" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding TotalTopupText}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                <TextBlock Text="VND" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,0,0">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Điểm thưởng" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding AvailablePoints}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>
                                                <TextBlock Text="điểm" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Thông chi tiết -->
                                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Col 1 -->
                                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,16,12">
                                                <TextBlock Text="&#x1F4DE; Số điện thoại" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,16,12">
                                                <TextBlock Text="&#x1F4B3; CCCD/CMND" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding IdentityNumber}" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,16,12">
                                                <TextBlock Text="&#x1F382; Ngày sinh" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding BirthdayText}" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="3" Margin="0,0,16,12">
                                                <TextBlock Text="&#x1F4C5; Ngày tham gia" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding CreatedAtText}" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="0" Grid.Row="4" Margin="0,0,16,12">
                                                <TextBlock Text="&#x1F464; Lần đăng nhập cuối" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding LastLoginText}" FontSize="12" Foreground="#334155" FontWeight="Medium"/>
                                            </StackPanel>

                                            <!-- Col 2 -->
                                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,12" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x1F464; Tên đăng nhập" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x2709; Email" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Email}" FontSize="12" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="2" Margin="0,0,0,12" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x1F4CD; Địa chỉ" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Address}" FontSize="12" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,0,0,12" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x2699; Trạng thái" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ActiveText}" FontSize="12" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Grid.Row="4" Margin="0,0,0,12" HorizontalAlignment="Right">
                                                <TextBlock Text="&#x2B50; Loại hội viên" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding MemberTypeText}" FontSize="12" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Thao tác nhanh -->
                                    <Grid Grid.Row="4" Margin="0,16,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Thao tác nhanh" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,12"/>
                                        
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Margin="0,0,4,0" Background="#F0FDF4" BorderBrush="#10B981" BorderThickness="1" Foreground="#059669" Padding="0,8" Click="ContextTopupMemberMenuItem_Click">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                <TextBlock Text="&#x1F4B5; Nạp tiền" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                            <Button Grid.Column="1" Margin="4,0,0,0" Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" Foreground="#1D4ED8" Padding="0,8" Click="ViewMemberTransactionsButton_Click">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                <TextBlock Text="&#x1F552; Lịch sử" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Button Margin="0" Background="#FAF5FF" BorderBrush="#A855F7" BorderThickness="1" Foreground="#7E22CE" Padding="0,8" Click="ChangeMemberPasswordButton_Click">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                <TextBlock Text="&#x1F511; Đổi mật khẩu" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>


                <TabItem x:Name="LogsTabItem" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F4CB;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Nhật ký" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabControl x:Name="LogsTabControl" Margin="4" SelectionChanged="MainTabControl_SelectionChanged">
                        <TabItem x:Name="SystemLogsTabItem">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="&#x1F4CB;" Margin="0,0,6,0" FontSize="20" />
                                    <TextBlock VerticalAlignment="Center" Text="Nhật ký hệ thống" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Button Padding="10,5" Click="RefreshSystemLogsButton_Click" Content="Làm mới" Margin="0,0,8,0" />
                                    <Button Padding="10,5" Click="ClearSystemLogsButton_Click" Content="{x:Static local:I18n.SafeLogClear}" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" Text="Số dòng:" Margin="0,0,6,0" />
                                    <ComboBox x:Name="SystemLogLimitComboBox" Width="110" SelectionChanged="SystemLogLimitComboBox_SelectionChanged" Margin="0,0,10,0">
                                        <ComboBoxItem Content="50" />
                                        <ComboBoxItem Content="100" IsSelected="True" />
                                        <ComboBoxItem Content="200" />
                                        <ComboBoxItem Content="500" />
                                    </ComboBox>

                                    <TextBlock VerticalAlignment="Center" Text="Máy timeline:" Margin="0,0,6,0" />
                                    <ComboBox x:Name="SystemLogMachineFilterComboBox"
                                              Width="240"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,10,0"
                                              SelectionChanged="SystemLogMachineFilterComboBox_SelectionChanged" />
                                </WrapPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Panel: Timeline -->
                                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="12" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="TIMELINE (Trực tiếp)" FontSize="13" FontWeight="Bold" Foreground="#0F172A" />
                                                <TextBlock x:Name="MachineTimelineInfoTextBlock"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#10B981"
