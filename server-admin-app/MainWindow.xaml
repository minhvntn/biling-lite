        <ToggleButton x:Name="UnpaidGuestFloatingButton"
                      Panel.ZIndex="3000"
                      Visibility="Collapsed"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,18,52"
                      BorderThickness="0"
                      Background="#EA580C"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="16,10">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="12" ShadowDepth="3" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UnpaidLabel" Text="Chưa tính tiền" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Background="White" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0">
                                <TextBlock Foreground="#EA580C" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F97316" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#C2410C" />
                        </Trigger>
                        <Trigger Property="Content" Value="0">
                            <Setter Property="Opacity" Value="0.2" />
                            <Setter TargetName="UnpaidLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonBorder" Property="Padding" Value="8" />
                        </Trigger>
                        <Trigger Property="Content">
                            <Trigger.Value>
                                <sys:Int32>0</sys:Int32>
                            </Trigger.Value>
                            <Setter Property="Opacity" Value="0.2" />
                            <Setter TargetName="UnpaidLabel" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ButtonBorder" Property="Padding" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="UnpaidGuestPopup" 
               PlacementTarget="{Binding ElementName=UnpaidGuestFloatingButton}" 
               Placement="Top" 
               IsOpen="{Binding IsChecked, ElementName=UnpaidGuestFloatingButton}" 
               StaysOpen="False" 
               AllowsTransparency="True" 
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,4" MinWidth="200" MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Phiên chờ thanh toán" FontWeight="Bold" Margin="8,4,8,8" />
                    <ListBox x:Name="UnpaidGuestListBox" 
                             BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="UnpaidGuestListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Chat notification popup button -->
        <Border x:Name="ChatNotificationPopupBorder"
                Panel.ZIndex="3000"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="0,0,0,25"
                Background="#EF4444"
                BorderBrush="#EF4444"
                BorderThickness="1"
                Padding="0"
                Cursor="Hand"
                MouseLeftButtonDown="ChatNotificationPopupBorder_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    From="#EF4444" To="#F8FAFC" Duration="0:0:0.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="ChatNotificationTextBlock"
                       Text="Tin nhắn - máy 01"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Padding="16,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                        From="White" To="#EF4444" Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
