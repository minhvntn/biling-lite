                                                       FontWeight="SemiBold" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Padding="12,6"
                                                Content="Làm mới"
                                                Click="RefreshDatabaseStorageButton_Click" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="240" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Bảng nặng nhất (top 12)" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <DataGrid x:Name="DbStorageTablesDataGrid"
                                                      Grid.Row="2"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      RowHeaderWidth="0"
                                                      AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Bảng" Binding="{Binding TableName}" Width="1.4*" />
                                                    <DataGridTextColumn Header="Tổng" Binding="{Binding TotalPretty}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Data" Binding="{Binding TablePretty}" Width="0.8*" />
                                                    <DataGridTextColumn Header="Index/Toast" Binding="{Binding IndexToastPretty}" Width="0.9*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="240" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Lịch sử dung lượng (14 ngày)" FontWeight="SemiBold" Foreground="#0F172A" />
                                            <DataGrid x:Name="DbStorageHistoryDataGrid"
                                                      Grid.Row="2"
                                                      AutoGenerateColumns="False"
                                                      IsReadOnly="True"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      GridLinesVisibility="Horizontal"
                                                      RowHeaderWidth="0"
                                                      AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Ngày" Binding="{Binding Date}" Width="*" />
                                                    <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizePretty}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Client">
                            <Grid Margin="12">
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Tài khoản đăng nhập Admin máy trạm" />
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#666"
                                               Text="Bấm nút bên dưới để mở popup đổi username/mật khẩu." />
                                    <Button Margin="0,14,0,0"
                                            Width="240"
                                            Padding="12,6"
                                            HorizontalAlignment="Left"
                                            Content="Đổi tài khoản admin..."
                                            Click="OpenAdminCredentialPopupButton_Click" />
                                    <TextBlock x:Name="AdminCredentialStatusTextBlock"
                                               Margin="0,10,0,0"
                                               Foreground="#555"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </TabItem>
            </TabControl>
        </DockPanel>

        <Grid x:Name="MemberModalOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="460"
                    MinHeight="420"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="0,16"
                    Background="White"
                    BorderBrush="#CFCFCF"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Thêm hội viên" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="Tên đăng nhập" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberUsernameTextBox" Grid.Row="2" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="3" Text="Mật khẩu" Margin="0,0,0,4" />
                    <PasswordBox x:Name="MemberPasswordBox" Grid.Row="4" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5" Text="Số điện thoại (không bắt buộc)" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberPhoneTextBox" Grid.Row="6" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="7" Text="CCCD/CMND (không bắt buộc)" Margin="0,0,0,4" />
                    <TextBox x:Name="MemberIdentityTextBox" Grid.Row="8" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="9" Text="Loại hội viên" Margin="0,0,0,4" />
                    <ComboBox x:Name="MemberTypeComboBox" Grid.Row="10" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="Thường" Tag="REGULAR" />
                        <ComboBoxItem Content="VIP" Tag="VIP" />
                    </ComboBox>

                    <TextBlock x:Name="MemberModalErrorTextBlock" Grid.Row="11" VerticalAlignment="Top" Foreground="#B42318" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Padding="10,5" Margin="0,0,8,0" Click="CreateMemberConfirmButton_Click" Content="Tạo" />
                        <Button Padding="10,5" Click="CancelMemberModalButton_Click" Content="Hủy" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="TopupModalOverlay" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="120">
            <Border Width="520"
                    MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="0,16"
                    Background="White"
                    BorderBrush="#CFCFCF"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TopupModalTitleTextBlock"
                               Grid.Row="0"
                               Text="Nạp tiền hội viên"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock x:Name="TopupModalMemberTextBlock"
                                   Text="Chọn số tiền nạp:"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="TopupModalCurrentBalanceTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="#334155"
                                   Text="Số dư hiện tại: - VND" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#E7F3FF"
                            BorderBrush="#97B8E2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,8">
                        <TextBlock x:Name="TopupModalAmountTextBlock"
                                   Text="0 VND"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#09248C"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Row="3"
                               Text="Bấm nhiều lần để cộng dồn. Không giới hạn trần mỗi lần nạp."
                               Foreground="DimGray"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="TopupModeAddButton"
                                Content="Nạp (+)"
                                Width="110"
                                Height="34"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                Click="TopupModeAddButton_Click" />
                        <Button x:Name="TopupModeSubtractButton"
                                Content="Trừ (-)"
                                Width="110"
                                Height="34"
                                FontWeight="SemiBold"
                                Click="TopupModeSubtractButton_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="Nhập số tiền:" />
                            <TextBox x:Name="TopupCustomAmountTextBox"
                                     Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"
                                     TextChanged="TopupCustomAmountTextBox_TextChanged"
                                     KeyDown="TopupCustomAmountTextBox_KeyDown" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="Nhập số phút:" />
                            <TextBox x:Name="TopupMinutesTextBox"
                                     Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0"
                                     TextChanged="TopupMinutesTextBox_TextChanged"
                                     KeyDown="TopupMinutesTextBox_KeyDown" />
                        </Grid>

                        <TextBlock x:Name="TopupMinutesRateHintTextBlock"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   Text="Đơn giá quy đổi: -"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,0,0,10">
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <Button Content="1,000" Tag="1000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="2,000" Tag="2000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="3,000" Tag="3000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="4,000" Tag="4000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="5,000" Tag="5000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="6,000" Tag="6000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="7,000" Tag="7000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="8,000" Tag="8000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="9,000" Tag="9000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Background="#83D95C" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Button Content="10,000" Tag="10000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="20,000" Tag="20000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="30,000" Tag="30000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="40,000" Tag="40000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="50,000" Tag="50000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="60,000" Tag="60000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="70,000" Tag="70000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="80,000" Tag="80000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                            <Button Content="90,000" Tag="90000" Height="44" Margin="3" FontWeight="Bold" FontSize="16" Foreground="#FFEE00" Background="#D02217" BorderBrush="#282828" Click="TopupQuickAmountButton_Click" />
                        </UniformGrid>
                    </StackPanel>

                    <TextBlock x:Name="TopupModalErrorTextBlock"
                               Grid.Row="7"
                               Foreground="#B42318"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap" />

                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TopupUndoButton"
                                Content="-"
                                Width="68"
                                Height="36"
                                Margin="0,0,8,0"
                                FontWeight="Bold"
                                Click="TopupUndoButton_Click" />
                        <Button x:Name="TopupClearButton"
                                Content="Xóa"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                Click="TopupClearButton_Click" />
                        <Button Content="Hủy"
                                Width="90"
                                Height="36"
                                Margin="0,0,8,0"
                                Click="TopupCancelButton_Click" />
                        <Button x:Name="TopupSubmitButton"
                                Content="Nạp"
                                Width="90"
                                Height="36"
                                FontWeight="SemiBold"
                                Background="#79C959"
                                BorderBrush="#3F8A2E"
                                Click="TopupSubmitButton_Click" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <ToggleButton x:Name="UnpaidGuestFloatingButton"
                      Panel.ZIndex="3000"
                      Visibility="Collapsed"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Margin="0,0,18,52"
                      Padding="16,10"
                      BorderThickness="0"
                      Background="#EA580C"
                      Cursor="Hand">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="20"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="12" ShadowDepth="3" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Chưa tính tiền" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Border Background="White" CornerRadius="12" MinWidth="24" Height="24" Padding="6,0">
                                <TextBlock Foreground="#EA580C" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{TemplateBinding Content}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F97316" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#C2410C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="UnpaidGuestPopup" 
               PlacementTarget="{Binding ElementName=UnpaidGuestFloatingButton}" 
               Placement="Top" 
               IsOpen="{Binding IsChecked, ElementName=UnpaidGuestFloatingButton}" 
               StaysOpen="False" 
               AllowsTransparency="True" 
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,4" MinWidth="200" MaxHeight="300">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Phiên chờ thanh toán" FontWeight="Bold" Margin="8,4,8,8" />
                    <ListBox x:Name="UnpaidGuestListBox" 
                             BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="UnpaidGuestListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Popup>

        <Border x:Name="GuestLoginToastBorder"
                Panel.ZIndex="4000"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,18,0"
                MaxWidth="360"
                Padding="12,10"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#1D4ED8"
                Background="#EFF6FF">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Text="Thông báo máy trạm"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8" />
                    <Button DockPanel.Dock="Right"
                            Content="Đóng"
                            Padding="8,2"
                            FontSize="12"
                            Margin="10,0,0,0"
                            Click="GuestLoginToastCloseButton_Click" />
                </DockPanel>
                <TextBlock x:Name="GuestLoginToastMessageTextBlock"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="#0F172A"
                           Text="Máy trạm vừa có khách đểng nhập." />
                <ProgressBar x:Name="GuestLoginToastProgressBar" Height="4" Margin="0,8,0,0" Background="#DBEAFE" Foreground="#2563EB" BorderThickness="0" Minimum="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
