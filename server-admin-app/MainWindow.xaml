                                        <TextBlock Text="• Check chọn máy ở bảng giữa và dùng công cụ Chuyển Nhóm Nhanh bên phải để đổi nhóm." TextWrapping="Wrap" FontSize="12" Foreground="#4338CA" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Có thể chuyển nhiều máy cùng lúc bằng cách tick chọn." TextWrapping="Wrap" FontSize="12" Foreground="#4338CA"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="TỔNG QUAN" FontWeight="Bold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Content="&#x21BB; Làm mới" Foreground="#2563EB" Background="White" BorderBrush="#CBD5E1" Cursor="Hand" Click="RefreshGroupsButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <UniformGrid Columns="5" Margin="-6,0">
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Tổng số máy" FontSize="11" Foreground="#475569"/>
                                            <TextBlock x:Name="DashStatTotalMachines" Text="0" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Nhóm lớn nhất" FontSize="11" Foreground="#475569"/>
                                            <TextBlock x:Name="DashStatTopGroup" Text="-" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Nhóm lớn thứ 2" FontSize="11" Foreground="#475569"/>
                                            <TextBlock x:Name="DashStatSecondGroup" Text="-" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Đang hoạt động" FontSize="11" Foreground="#475569"/>
                                            <TextBlock x:Name="DashStatOnline" Text="0" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DashboardCardStyle}" Margin="6,0" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Đang bảo trì/tắt" FontSize="11" Foreground="#475569"/>
                                            <TextBlock x:Name="DashStatOffline" Text="0" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                            
                            <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0" Margin="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="DANH SÁCH MÁY" FontWeight="Bold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Padding="8,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x1F50D;" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox x:Name="GroupMachinesSearchTextBox" Width="150" BorderThickness="0" VerticalAlignment="Center" Background="Transparent" TextChanged="GroupMachinesSearchTextBox_TextChanged"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <DataGrid x:Name="GroupMachinesDataGrid"
                                              Grid.Row="1"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0"
                                              SelectionMode="Extended"
                                              BorderThickness="0,1,0,0"
                                              BorderBrush="#E2E8F0"
                                              FontSize="14"
                                              SelectionChanged="GroupMachinesDataGrid_SelectionChanged"
                                              ContextMenuOpening="GroupMachinesDataGrid_ContextMenuOpening"
                                              AlternationCount="2"
                                              PreviewMouseLeftButtonDown="GroupMachinesDataGrid_PreviewMouseLeftButtonDown"
                                              MouseMove="GroupMachinesDataGrid_MouseMove">
                                        <DataGrid.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Source={x:Static SystemColors.HighlightColor}}"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{Binding Source={x:Static SystemColors.HighlightTextColor}}"/>
                                        </DataGrid.Resources>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="GroupMachinesDataGridRow_PreviewMouseRightButtonDown" />
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu FontSize="{DynamicResource MachineContextMenuFontSize}">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Padding" Value="{DynamicResource MachineContextMenuItemPadding}" />
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem x:Name="GroupMachinesAssignGroupMenuItem" Header="Chuyển nhóm máy">
                                                    <MenuItem Header="Đang tải nhóm máy..." IsEnabled="False" />
                                                </MenuItem>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tên máy" Binding="{Binding MachineName}" Width="130" />
                                            
                                            <DataGridTemplateColumn Header="Nhóm hiện tại" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource BadgeBorderStyle}" Background="#EEF2FF" BorderBrush="#E0E7FF" BorderThickness="1" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding GroupName}" Foreground="#4F46E5" FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            
                                            <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="120" />
                                            
                                            <DataGridTemplateColumn Header="Trạng thái" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{Binding StatusIconBrush}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="Lần cuối online" Binding="{Binding LastSeenAtText}" Width="150" />
                                            <DataGridTextColumn Header="Giá khách" Binding="{Binding HourlyRate, StringFormat={}{0:N0}}" Width="100" />
                                            <DataGridTextColumn Header="Giá hội viên" Binding="{Binding MemberHourlyRate, StringFormat={}{0:N0}}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>


                    </Grid>
                </TabItem>

                <TabItem x:Name="ServicesTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F6CE;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Dịch vụ" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0" Background="#F8FAFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar: Danh mục dịch vụ -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="DANH MỤC DỊCH VỤ" FontWeight="Bold" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                </Grid>

                                <ListBox x:Name="ServiceCategoryListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="ServiceCategoryListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{Binding BackgroundBrush}" CornerRadius="6" Padding="12,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding ForegroundBrush}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                                                                <Border Grid.Column="2" Background="{Binding CountBackgroundBrush}" CornerRadius="4" Padding="6,2">
                                                                    <TextBlock Text="{Binding Count}" Foreground="{Binding ForegroundBrush}" FontSize="12"/>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <Border Grid.Row="2" Background="#EFF6FF" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="ⓘ" Foreground="#3B82F6" Margin="0,0,8,0"/>
                                            <TextBlock Text="Hướng dẫn" FontWeight="Bold" Foreground="#1D4ED8" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Text="• Thêm dịch vụ để quản lý danh mục bán hàng trong phòng máy." Foreground="#334155" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Có thể sắp xếp, bật/tắt dịch vụ hoặc cập nhật giá bán nhanh chóng." Foreground="#334155" TextWrapping="Wrap" FontSize="12"/>
                                        <TextBlock Text="🍽️" FontSize="40" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Main Content -->
                        <Grid Grid.Column="1" Margin="24,20,24,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="↻ Làm mới" Background="#EF4444" Foreground="White" BorderThickness="0" Padding="16,8" Margin="0,0,8,0" Click="RefreshServiceItemsButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="+ Thêm dịch vụ" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#374151" Padding="16,8" Margin="0,0,8,0" Click="CreateServiceItemButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="↻ Đổi giá..." Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#374151" Padding="16,8" Margin="0,0,8,0" Click="UpdateServicePriceButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="✎ Sửa dịch vụ..." Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#374151" Padding="16,8" Margin="0,0,8,0" Click="UpdateServiceItemButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="⊙ Bật/Tắt dịch vụ" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#374151" Padding="16,8" Margin="0,0,8,0" Click="ToggleServiceItemButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                                <Button Content="⟳ Tải lại toàn bộ dữ liệu" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#374151" Padding="16,8" Margin="0,0,8,0" Click="RefreshAllDataButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </StackPanel>

                            <!-- Stats Cards -->
                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Tổng -->
                                <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#EFF6FF" CornerRadius="20" Margin="0,0,12,0">
                                            <TextBlock Text="👥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng dịch vụ" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock x:Name="StatsTotalCountTextBlock" Text="0" FontWeight="Bold" FontSize="20" Foreground="#0F172A" Margin="0,2,0,0"/>
                                            <TextBlock Text="dịch vụ" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 2: Đang bán -->
                                <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#ECFDF5" CornerRadius="20" Margin="0,0,12,0">
                                            <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Đang bán" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock x:Name="StatsActiveCountTextBlock" Text="0" FontWeight="Bold" FontSize="20" Foreground="#0F172A" Margin="0,2,0,0"/>
                                            <TextBlock Text="dịch vụ" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 3: Tạm dừng -->
                                <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#FFFBEB" CornerRadius="20" Margin="0,0,12,0">
                                            <TextBlock Text="⏸" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tạm dừng" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock x:Name="StatsInactiveCountTextBlock" Text="0" FontWeight="Bold" FontSize="20" Foreground="#0F172A" Margin="0,2,0,0"/>
                                            <TextBlock Text="dịch vụ" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 4: Cập nhật -->
                                <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#F3F4F6" CornerRadius="20" Margin="0,0,12,0">
                                            <TextBlock Text="📅" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Cập nhật gần nhất" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock x:Name="StatsLastUpdatedTextBlock" Text="-" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Card 5: Doanh thu -->
                                <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" Background="#FFF7ED" CornerRadius="20" Margin="0,0,12,0">
                                            <TextBlock Text="💰" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Tổng doanh thu hôm nay" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock x:Name="StatsRevenueTextBlock" Text="0" FontWeight="Bold" FontSize="20" Foreground="#DC2626" Margin="0,2,0,0"/>
                                            <TextBlock Text="VND" Foreground="#94A3B8" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- DataGrid -->
                            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                                <DataGrid x:Name="ServiceItemsDataGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          Background="Transparent"
                                          RowBackground="White"
                                          AlternatingRowBackground="#EBEDEE"
                                          BorderThickness="0"
                                          RowHeaderWidth="0"
                                          RowHeight="64"
                                          SelectionChanged="ServiceItemsDataGrid_SelectionChanged"
                                          MouseDoubleClick="ServiceItemsDataGrid_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#0F172A"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="Padding" Value="16,12"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="16,0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Thêm dịch vụ..." Click="CreateServiceItemButton_Click" />
                                            <MenuItem Header="Sửa dịch vụ..." Click="UpdateServiceItemButton_Click" />
                                            <MenuItem Header="Đổi giá..." Click="UpdateServicePriceButton_Click" />
                                            <MenuItem Header="Bật/Tắt dịch vụ" Click="ToggleServiceItemButton_Click" />
                                            <Separator />
                                            <MenuItem Header="Xóa dịch vụ" Click="DeleteServiceItemMenuItem_Click" Foreground="#DC2626" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ServiceItemsDataGridRow_PreviewMouseRightButtonDown" />
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>

                                        <DataGridTemplateColumn Header="Ảnh" Width="80" MinWidth="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="48" Height="48" CornerRadius="6" BorderThickness="1" BorderBrush="#E2E8F0">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding ServiceImageSource}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding Name}" Width="1.5*" MinWidth="160" ElementStyle="{StaticResource BoldBlackDataGridText}" />
                                        <DataGridTemplateColumn Header="Danh mục" Width="1.1*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" Foreground="#3B82F6" FontSize="12" FontWeight="Medium"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Giá (VND)" Binding="{Binding UnitPriceText}" Width="1*" MinWidth="110" ElementStyle="{StaticResource BoldBlackDataGridText}" />
                                        <DataGridTemplateColumn Header="Trạng thái" Width="1*" MinWidth="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#EF4444"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Fill" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding ActiveText}" FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#0F172A"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAtText}" Width="1.3*" MinWidth="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Thao tác" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Button Width="32" Height="32" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569" Click="ServiceRowOptionsButton_Click">
                                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            <TextBlock Text="⋮"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Pagination and Info -->
                            <Grid Grid.Row="3">
                                <TextBlock x:Name="ServiceInfoTextBlock" Text="Đang tải danh sách..." VerticalAlignment="Center" Foreground="#64748B"/>
                            </Grid>
                        </Grid>

                        <!-- Right Sidebar: Thống kê -->
                        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="THỐNG KÊ DỊCH VỤ" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,24"/>

                                <TextBlock Grid.Row="1" Text="Doanh thu theo danh mục (Hôm nay)" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Text="Đơn vị: VND" FontSize="11" Foreground="#94A3B8" Margin="0,20,0,16"/>

                                <!-- Category Revenue Chart -->
                                <ItemsControl x:Name="ServiceCategoryRevenueItemsControl" Grid.Row="2" Margin="0,0,0,32">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding DotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CategoryName}" FontWeight="Medium" Foreground="#475569" Width="80"/>
                                                    <TextBlock Text="{Binding RevenueText}" Foreground="#1E293B" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding PercentageText}" Foreground="#94A3B8" FontSize="12"/>
                                                </StackPanel>
                                                <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="6" BorderThickness="0">
                                                    <ProgressBar.Foreground>
                                                        <SolidColorBrush Color="{Binding BarColor}"/>
                                                    </ProgressBar.Foreground>
                                                    <ProgressBar.Background>
                                                        <SolidColorBrush Color="#F1F5F9"/>
                                                    </ProgressBar.Background>
                                                </ProgressBar>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="3" Text="Top dịch vụ bán chạy (Hôm nay)" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,0,0,16"/>

                                <!-- Top Selling Services -->
                                <ItemsControl x:Name="TopServiceSellingItemsControl" Grid.Row="3" Margin="0,32,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <Border Grid.Column="0" Background="{Binding RankBackground}" CornerRadius="4" Width="20" Height="20" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding RankNumber}" Foreground="{Binding RankForeground}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding ServiceName}" Foreground="#334155" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MetaText}" Foreground="#64748B" Margin="0,0,16,0" Width="30" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding RevenueText}" Foreground="#1E293B" FontWeight="Medium" Width="60" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Grid.Row="4" Content="Xem chi tiết" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#3B82F6" Padding="0,10" FontWeight="Medium" Click="ViewServicesStatsDetailButton_Click">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBox x:Name="ServiceOutputTextBox"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="13" />
                    </Grid>
                </TabItem>

                <TabItem x:Name="BlockTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F6AB;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Chặn" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                                        <Grid Margin="0" Background="#F8FAFC">
                        <Grid.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolToVis" />
                            <Style x:Key="MenuBtnStyle" TargetType="RadioButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="16,10" Margin="12,0,12,8" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FEF2F2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="AppMenuBtnStyle" TargetType="RadioButton" BasedOn="{StaticResource MenuBtnStyle}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="16,10" Margin="12,0,12,8" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar -->
                        <Border Grid.Column="0" Background="White" Margin="16" CornerRadius="8" BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,16,0,0">
                                    <RadioButton x:Name="MenuWebBlock" GroupName="BlockMenu" IsChecked="True" Style="{StaticResource MenuBtnStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F6E1;" FontSize="16" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuWebBlock}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Chặn web" FontWeight="SemiBold" FontSize="13.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuWebBlock}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton x:Name="MenuAppBlock" GroupName="BlockMenu" Style="{StaticResource AppMenuBtnStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4E6;" FontSize="16" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuAppBlock}" Value="True">
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="Chặn ứng dụng" FontWeight="SemiBold" FontSize="13.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#475569" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=MenuAppBlock}" Value="True">
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <!-- Badge at the bottom -->
                                <Border Grid.Row="2" Background="#F8FAFC" Margin="12,0,12,12" CornerRadius="8" Padding="12">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="&#x1F6E1;" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Hệ thống chặn" FontWeight="Bold" FontSize="12.5" Foreground="#1E293B" Margin="0,0,0,4" />
                                            <TextBlock Text="Bảo vệ môi trường mạng lành mạnh và an toàn." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Width="120" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Content Area -->
                        <Grid Grid.Column="1" Margin="0,16,16,16">
                            <!-- Chặn Web Content -->
                            <Border Background="White" CornerRadius="8" Padding="20" Visibility="{Binding IsChecked, ElementName=MenuWebBlock, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <CheckBox x:Name="WebFilterEnabledCheckBox"
                                                  Foreground="#1D4ED8"
                                                  FontWeight="Bold" FontSize="14"
                                                  Content="Bật chặn website đen / nội dung người lớn trên máy trạm"
                                                  VerticalAlignment="Center"
                                                  Checked="WebFilterEnabledCheckBox_Checked"
                                                  Unchecked="WebFilterEnabledCheckBox_Unchecked" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBlock Text="&#x2705;" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="WebFilterStatusTextBlock"
                                                   Foreground="#10B981"
                                                   Text="Đang tải danh sách chặn..." VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Grid.Row="2" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,0" Height="36">
                                            <TextBox x:Name="WebFilterDomainTextBox"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center"
                                                     KeyDown="WebFilterDomainTextBox_KeyDown" />
                                        </Border>
                                        <Button Grid.Column="1" Margin="12,0,0,0" Padding="16,0" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Click="AddWebFilterDomainButton_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+" FontSize="16" Margin="0,0,6,0" FontWeight="Bold" />
                                                <TextBlock Text="Thêm domain" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Margin="8,0,0,0" Padding="16,0" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Click="RemoveSelectedWebFilterDomainButton_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Xóa mục chọn" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Margin="8,0,0,0" Padding="16,0" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Click="ResetDefaultWebFilterDomainsButton_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📄" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Nạp list mẫu (240 domain)" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Margin="8,0,0,0" Padding="16,0" Height="36" Background="#2563EB" Foreground="White" BorderThickness="0" Click="ClearAllWebFilterDomainsButton_Click">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" />
                                                <TextBlock Text="Xóa tất cả" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- DataGrid replaces ListBox -->
                                    <DataGrid x:Name="WebFilterDomainsDataGrid"
                                              Grid.Row="3"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#F1F5F9"
                                              BorderBrush="#E2E8F0"
                                              BorderThickness="1"
                                              Background="White"
                                              RowBackground="White"
                                              AlternatingRowBackground="#EBEDEE"
                                              RowHeight="40"
                                              SelectionMode="Extended">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Padding" Value="12,10" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Padding" Value="12,0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                        <Setter Property="Foreground" Value="#1E293B" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Domain" Binding="{Binding}" Width="*" Foreground="#334155" />
                                            <DataGridTemplateColumn Header="Thao tác" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Click="EditWebFilterDomainButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,16,0" ToolTip="Sửa">
                                                                <TextBlock Text="✏️" Foreground="#3B82F6" FontSize="14" />
                                                            </Button>
                                                            <Button Click="DeleteWebFilterDomainButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Xóa">
                                                                <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="14" />
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="4" Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   Text="Gợi ý: nhập dạng domain chính, ví dụ: badsite.com (không cần http://)." />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Padding="20,8" Margin="0,0,12,0" Click="ReloadWebFilterSettingsButton_Click" Background="White" Foreground="#2563EB" BorderBrush="#E2E8F0" BorderThickness="1" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#x21BB;" Margin="0,0,6,0" />
                                                    <TextBlock Text="Tải lại" />
                                                </StackPanel>
                                            </Button>
                                            <Button Padding="20,8" Click="SaveWebFilterSettingsButton_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" Margin="0,0,6,0" />
                                                    <TextBlock Text="Lưu áp dụng" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Chặn Ứng Dụng Content -->
                            <Border Background="White" CornerRadius="8" Padding="20" Visibility="{Binding IsChecked, ElementName=MenuAppBlock, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <CheckBox x:Name="AppBlockEnabledCheckBox"
                                              Grid.Row="0"
                                              Content="Bật chặn ứng dụng trên máy trạm"
                                              Margin="0,0,0,10"
                                              Foreground="#1D4ED8"
                                              FontWeight="Bold" FontSize="14"
                                              Checked="AppBlockEnabledCheckBox_Changed"
                                              Unchecked="AppBlockEnabledCheckBox_Changed" />

                                    <TextBlock Grid.Row="1" Margin="0,0,0,16" Foreground="#10B981"
                                               Text="Chọn ứng dụng cần chặn rồi bấm + để thêm vào danh sách chặn. Bấm - để gỡ chặn." />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Available Apps -->
                                        <DockPanel Grid.Column="0">
                                            <TextBlock DockPanel.Dock="Top" Text="Ứng dụng có sẵn" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#334155" />
                                            <ListBox x:Name="AppBlockAvailableListBox"
                                                     SelectionMode="Extended"
                                                     BorderBrush="#E2E8F0"
                                                     BorderThickness="1"
                                                     AlternationCount="2">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Style.Triggers>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                <Setter Property="Background" Value="#F8FAFC" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </DockPanel>

                                        <!-- Center: Arrow Buttons -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Button Content="+" Width="44" Height="44" Margin="0,0,0,12"
                                                    FontSize="20" FontWeight="Bold" Background="#2563EB" Foreground="White" BorderThickness="0"
                                                    Click="AppBlockAddButton_Click"
                                                    ToolTip="Thêm vào danh sách chặn">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="-" Width="44" Height="44"
                                                    FontSize="20" FontWeight="Bold" Background="#EF4444" Foreground="White" BorderThickness="0"
                                                    Click="AppBlockRemoveButton_Click"
                                                    ToolTip="Gỡ khỏi danh sách chặn">
                                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="22"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <!-- Right: Blocked Apps -->
                                        <DockPanel Grid.Column="2">
                                            <TextBlock DockPanel.Dock="Top" Text="Chặn ứng dụng client" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,0,0,8" />
                                            <ListBox x:Name="AppBlockBlockedListBox"
                                                     SelectionMode="Extended"
                                                     BorderBrush="#FECACA"
                                                     BorderThickness="1"
                                                     AlternationCount="2">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="12,8" />
                                                        <Setter Property="FontSize" Value="13" />
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                        <Style.Triggers>
                                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                                <Setter Property="Background" Value="#FEF2F2" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </DockPanel>
                                    </Grid>

                                    <Grid Grid.Row="3" Margin="0,16,0,0">
                                        <TextBlock x:Name="AppBlockStatusTextBlock" VerticalAlignment="Center" Foreground="#555" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Padding="20,8" Margin="0,0,12,0" Click="AppBlockReloadButton_Click" Content="Tải lại" Background="White" Foreground="#2563EB" BorderBrush="#E2E8F0" BorderThickness="1" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                            <Button Padding="20,8" Click="AppBlockSaveButton_Click" Content="Lưu áp dụng" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="VipTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="&#x1F451;" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Hệ thống VIP" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Resources>
                        <Style x:Key="VipChipButtonStyle" TargetType="Button">
                            <Setter Property="Height" Value="28"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Resources>
                    <Grid Margin="0" Background="#F8FAFC">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Stat Cards -->
                            <RowDefinition Height="Auto" /> <!-- Control Toolbar -->
                            <RowDefinition Height="*" />    <!-- DataGrid -->
                            <RowDefinition Height="Auto" /> <!-- Footer -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: 4 Summary Stat Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Total Ranks -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7" Background="#F5F3FF" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F451;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Tổng bậc hạng" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="VipTotalRanksTextBlock" Text="100 Cấp" FontWeight="Bold" FontSize="15" Foreground="#1E293B"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2: Highest Bonus -->
                            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7" Background="#ECFDF5" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F381;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Khuyến mãi cao nhất" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="VipMaxBonusTextBlock" Text="+100%" FontWeight="Bold" FontSize="15" Foreground="#059669"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3: Fastest Point Earning -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7" Background="#FFFBEB" VerticalAlignment="Center">
                                        <TextBlock Text="&#x26A1;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Tích điểm nhanh nhất" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="VipFastestPointTextBlock" Text="5p / điểm" FontWeight="Bold" FontSize="15" Foreground="#D97706"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 4: Max Topup Threshold -->
                            <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="7" Background="#EFF6FF" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4B0;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ngưỡng nạp tối đa" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="VipMaxThresholdTextBlock" Text="100.000.000 đ" FontWeight="Bold" FontSize="15" Foreground="#2563EB"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 1: Quick Setup & Search Toolbar -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Quick Rebuild Tool -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x26A1; Thiết lập 100 cấp:" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Width="130" Height="32" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="White" Padding="8,0" Margin="0,0,8,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="RebuildMaxThresholdTextBox" BorderThickness="0" Background="Transparent" 
                                                     VerticalContentAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" 
                                                     Text="100,000,000" HorizontalContentAlignment="Right" />
                                            <TextBlock Text="đ" Grid.Column="1" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11.5" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Border>
                                    <Button Height="32" Padding="12,0" Click="RebuildLoyaltyRanksButton_Click" Background="#4F46E5" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" FontSize="12">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#x2728;" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                                            <TextBlock Text="Tự động chia cấp" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="14,2" Height="22"/>

                                <!-- Middle: Tier filter chips -->
                                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" BorderThickness="0" PanningMode="HorizontalOnly">
                                    <StackPanel x:Name="TierFilterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="TierAllButton" Click="TierFilterButton_Click" Tag="ALL" Content="Tất cả" Style="{StaticResource VipChipButtonStyle}" Background="#4F46E5" Foreground="White" BorderBrush="#4F46E5"/>
                                        <Button Click="TierFilterButton_Click" Tag="Sắt" Content="&#x1F6E1; Sắt" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Đồng" Content="&#x1F949; Đồng" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Bạc" Content="&#x1F948; Bạc" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Vàng" Content="&#x1F947; Vàng" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Bạch Kim" Content="&#x1F48E; Bạch Kim" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Tinh Anh" Content="&#x1F52E; Tinh Anh" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Kim Cương" Content="&#x1F539; Kim Cương" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Cao Thủ" Content="&#x1F451; Cao Thủ" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Đại Cao Thủ" Content="&#x1F396; Đại Cao Thủ" Style="{StaticResource VipChipButtonStyle}"/>
                                        <Button Click="TierFilterButton_Click" Tag="Thách Đấu" Content="&#x1F525; Thách Đấu" Style="{StaticResource VipChipButtonStyle}"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Row 2: DataGrid Container -->
                        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
                            <DataGrid x:Name="LoyaltyRanksDataGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      VerticalGridLinesBrush="Transparent"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      RowHeight="44"
                                      RowHeaderWidth="0"
                                      AlternationCount="2"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      CellEditEnding="LoyaltyRanksDataGrid_CellEditEnding">
                                
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="Padding" Value="14,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                        <Style.Triggers>
                                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                <Setter Property="Background" Value="#FBFBFC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EEF2FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!-- Bậc hạng Badge -->
                                    <DataGridTemplateColumn Header="Tên bậc hạng" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding TierBgColor}" BorderBrush="{Binding TierBorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TierIcon}" FontSize="12.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding RankName}" FontWeight="Bold" FontSize="12.5" Foreground="{Binding TierTextColor}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding RankName, UpdateSourceTrigger=LostFocus}" FontSize="13" VerticalContentAlignment="Center" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Ngưỡng tổng nạp -->
                                    <DataGridTemplateColumn Header="Ngưỡng tổng nạp (VNĐ)" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x1F4B0;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MinTopupFormatted}" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MinTopupText, UpdateSourceTrigger=LostFocus}" FontSize="13" VerticalContentAlignment="Center" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Khuyến mãi -->
                                    <DataGridTemplateColumn Header="Khuyến mãi nạp (%)" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#x1F381;" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding BonusPercentText}" FontWeight="Bold" FontSize="12.5" Foreground="#059669" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding BonusPercent, UpdateSourceTrigger=LostFocus}" FontSize="13" VerticalContentAlignment="Center" Padding="4,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Tích lũy điểm -->
                                    <DataGridTemplateColumn Header="Tốc độ tích lũy điểm" Width="220" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x23F2;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MinutesPerPointText}" FontWeight="Medium" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" / điểm" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Ghi chú / Trạng thái -->
                                    <DataGridTemplateColumn Header="Quyền lợi &amp; Ghi chú" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Tự động áp dụng khuyến mãi nạp tiền &amp; điểm danh hàng ngày" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Row 3: Status Footer -->
                        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F4A1;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Nhấn đúp chuột vào ô để sửa Tên bậc hạng, Ngưỡng nạp hoặc Khuyến mãi %. Dữ liệu tự động đồng bộ lên máy chủ khi ấn Enter." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="LoyaltyRanksInfoTextBlock" Text="Đã sẵn sàng" Foreground="#059669" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ComboTab" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="🎟️" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Thẻ Combo" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0">
                        <controls:ComboTabControl />
                    </Grid>
                </TabItem>

                <TabItem x:Name="StatisticsTabItem" Style="{StaticResource MainTabItemStyle}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TabIconStyle}" VerticalAlignment="Center" Text="📊" Margin="0,0,6,0" FontSize="18" />
                            <TextBlock Style="{StaticResource TabHeaderTextStyle}" VerticalAlignment="Center" Text="Thống kê" FontSize="12.5" />
                        </StackPanel>
                    </TabItem.Header>
                    <TabItem.Resources>
                        <Style x:Key="ModernFilterButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="#F3F4F6" />
                            <Setter Property="Foreground" Value="#374151" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="14,6" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </TabItem.Resources>
                    
                    <TabControl x:Name="StatsTabControl" Margin="4" SelectionChanged="MainTabControl_SelectionChanged">
                        <TabItem x:Name="RevenueStatsTabItem">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="📈" Margin="0,0,6,0" FontSize="20" />
                                    <TextBlock VerticalAlignment="Center" Text="Doanh thu &amp; Xếp hạng" />
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Khoảng thời gian:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="0,0,12,0" />
                                <Button x:Name="StatsWeekButton" Content="Tuần này" Margin="0,0,8,0" Style="{StaticResource ModernFilterButtonStyle}" Click="StatsFilterButton_Click" Tag="week" />
                                <Button x:Name="StatsMonthButton" Content="Tháng này" Margin="0,0,8,0" Style="{StaticResource ModernFilterButtonStyle}" Click="StatsFilterButton_Click" Tag="month" />
                                <Button x:Name="StatsYearButton" Content="Năm nay" Style="{StaticResource ModernFilterButtonStyle}" Click="StatsFilterButton_Click" Tag="year" />
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,20" ItemWidth="330" Orientation="Horizontal">
                                <Border Margin="0,0,12,12" Width="330" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu Giờ chơi" Foreground="#1E40AF" FontSize="13" FontWeight="Medium" />
                                        <TextBlock x:Name="PlaytimeRevenueTextBlock" Text="-" FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,8,0,0" />
                                        <TextBlock x:Name="PlaytimeGrowthTextBlock" Text="+ +12.5% so với kỳ trước" FontSize="11" Foreground="#15803D" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                
                                <Border Margin="0,0,12,12" Width="330" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Doanh thu Dịch vụ" Foreground="#065F46" FontSize="13" FontWeight="Medium" />
                                        <TextBlock x:Name="ServiceRevenueTextBlock" Text="-" FontSize="22" FontWeight="Bold" Foreground="#064E3B" Margin="0,8,0,0" />
                                        <TextBlock x:Name="ServiceGrowthTextBlock" Text="+ +8.2% so với kỳ trước" FontSize="11" Foreground="#15803D" Margin="0,4,0,0" />
