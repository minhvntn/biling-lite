<Window x:Class="Server.Admin.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập CyberS Admin"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern Input TextBox Style -->
        <Style x:Key="ModernLoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="36,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                      Fill="#94A3B8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Margin="36,0,10,0" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox Style -->
        <Style x:Key="ModernLoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="36,0,12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="CaretBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Path Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                      Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Card with Drop Shadow -->
    <Border Margin="14" Background="White" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.14" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/> <!-- Title Bar / Drag Header -->
                <RowDefinition Height="Auto"/> <!-- Brand / Logo Section -->
                <RowDefinition Height="Auto"/> <!-- Form Inputs & CTAs (Auto wraps snuggly) -->
            </Grid.RowDefinitions>

            <!-- Top Title Bar with Drag & Close -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" CornerRadius="14,14,0,0">
                <Grid Margin="14,8,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="7" Height="7" CornerRadius="3.5" Background="#10B981" Margin="0,0,7,0" ToolTip="CyberS Server Client"/>
                        <TextBlock Text="CyberS Billing" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Click="CloseButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Đóng">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBrd" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="#64748B" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBrd" Property="Background" Value="#FEE2E2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Brand Logo & Header -->
            <StackPanel Grid.Row="1" Margin="24,2,24,12" HorizontalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#4F46E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" Color="#2563EB"/>
                    </Border.Effect>
                    <Path Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" 
                          Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="CYBERS ADMIN" FontSize="16.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                <TextBlock Text="Hệ thống quản lý phòng máy CyberS" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Form Inputs & Actions -->
            <StackPanel Grid.Row="2" Margin="24,0,24,18">
                <!-- Username -->
                <TextBlock Text="TÊN ĐĂNG NHẬP" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernLoginTextBox}" Tag="Nhập tài khoản quản trị..." KeyDown="UsernameTextBox_KeyDown" Margin="0,0,0,10" />

                <!-- Password -->
                <TextBlock Text="MẬT KHẨU" FontSize="10.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernLoginPasswordBox}" KeyDown="PasswordBox_KeyDown" Margin="0,0,0,6" />

                <!-- Error Container -->
                <Border x:Name="ErrorContainer" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,2,0,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" 
                              Fill="#DC2626" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ErrorTextBlock" Grid.Column="1" Foreground="#DC2626" TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Loading State Indicator -->
                <StackPanel x:Name="LoadingPanel" Margin="0,2,0,8" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="3" Background="#E0E7FF" Foreground="#2563EB" BorderThickness="0" Margin="0,0,0,5"/>
                    <TextBlock x:Name="LoadingTextBlock" Text="Đang xác thực thông tin, vui lòng đợi..." Foreground="#64748B" HorizontalAlignment="Center" FontSize="11.5" />
                </StackPanel>

                <!-- Primary CTA: Đăng nhập -->
                <Button x:Name="LoginButton" IsDefault="True" Click="LoginButton_Click" Height="40" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,4,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#93C5FD"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ĐĂNG NHẬP" FontWeight="Bold" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                        <Path Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Divider with "HOẶC" -->
                <Grid Margin="0,12,0,10">
                    <Border Height="1" Background="#E2E8F0" VerticalAlignment="Center"/>
                    <Border Background="White" HorizontalAlignment="Center" Padding="8,0">
                        <TextBlock Text="HOẶC" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                </Grid>

                <!-- Secondary Action: Dùng bản Lite -->
                <Button x:Name="SkipToLiteButton" IsCancel="True" Click="SkipToLiteButton_Click" Height="36" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z" 
                              Fill="#64748B" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Dùng Bản Lite (Không đăng nhập)" FontWeight="Medium" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
