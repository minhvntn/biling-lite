<Window x:Class="Server.Admin.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập CyberS Admin" Height="465" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="38,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" x:Name="border">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Tag}" Margin="40,0,10,0" VerticalAlignment="Center" Foreground="#9CA3AF" Visibility="Collapsed" x:Name="placeholder"/>
                                <TextBlock Text="👤" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" FontSize="14" HorizontalAlignment="Left"/>
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="38,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" x:Name="border">
                            <Grid>
                                <TextBlock Text="🔒" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" FontSize="14" HorizontalAlignment="Left"/>
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2563EB">
             <StackPanel VerticalAlignment="Center">
                 <TextBlock Text="💻" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                 <TextBlock Text="CYBERS ADMIN" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
             </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="28,24,28,24">
            <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernTextBox}" Tag="Tên đăng nhập" Margin="0,0,0,12" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}" KeyDown="PasswordBox_KeyDown" Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorTextBlock" Foreground="#EF4444" TextWrapping="Wrap" Margin="0,4,0,10" Visibility="Collapsed" TextAlignment="Center" FontSize="12" />
            
            <Button x:Name="LoginButton" IsDefault="True" Click="LoginButton_Click" Height="46" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,4,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="ĐĂNG NHẬP" FontWeight="Bold" FontSize="14" Foreground="White"/>
            </Button>
            
            <TextBlock x:Name="LoadingTextBlock" Text="Đang xác thực, vui lòng đợi..." Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" FontSize="13" />

            <Border Height="1" Background="#E2E8F0" Margin="0,16,0,14" />

            <Button x:Name="SkipToLiteButton" IsCancel="True" Click="SkipToLiteButton_Click" Height="42" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🍂" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Dùng Bản Lite (Không đăng nhập)" FontWeight="SemiBold" FontSize="13" Foreground="#334155" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>