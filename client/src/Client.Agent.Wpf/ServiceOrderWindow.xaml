<Window x:Class="Client.Agent.Wpf.ServiceOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dịch vụ" Height="760" Width="1280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <!-- ScrollViewer Customization for sleek look -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#33000000" Margin="0" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Service Item Card Style -->
        <DataTemplate x:Key="ServiceItemCardTemplate">
            <Grid Height="260" Margin="8">
                <!-- Shadow layer -->
                <Border CornerRadius="12" Background="#E6FFFFFF">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10" Direction="270" ShadowDepth="4" />
                    </Border.Effect>
                </Border>
                <!-- Content layer -->
                <Border CornerRadius="12" Background="#E6FFFFFF" BorderBrush="#20000000" BorderThickness="1">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Image -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#F8FAFC" ClipToBounds="True">
                        <Image Source="{Binding ServiceImageSource}" Stretch="Uniform" Margin="4" SnapsToDevicePixels="True"/>
                    </Border>
                    
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" BorderBrush="#10000000" BorderThickness="0,0,0,1"/>

                    <!-- Category tag -->
                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Margin="8" Background="#E6FFFFFF" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#475569" FontWeight="Medium"/>
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Row="1" Text="{Binding ServiceName}" FontSize="15" FontWeight="SemiBold" 
                               Foreground="#1E293B" Margin="12,10,12,4" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                    <!-- Price -->
                    <TextBlock Grid.Row="2" Text="{Binding UnitPriceText}" FontSize="14" FontWeight="Bold" 
                               Foreground="#3B82F6" Margin="12,0,12,8"/>

                    <!-- Order Stats -->
                    <StackPanel Grid.Row="3" Margin="12,0" VerticalAlignment="Top">
                        <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap">
                            <Run Text="Đã gọi: " FontWeight="Medium"/>
                            <Run Text="{Binding ExistingText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Quantity Control -->
                    <Border Grid.Row="4" Margin="12,10,12,12" Background="#F1F5F9" CornerRadius="8" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Decrease -->
                            <Button Grid.Column="0" Content="-" Width="32" Height="32" Padding="0" 
                                    FontSize="18" FontWeight="Bold" Foreground="#DC2626" Background="#FEE2E2" 
                                    BorderBrush="Transparent" IsEnabled="{Binding CanDecrease}"
                                    Click="DecreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Value -->
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="16" FontWeight="Bold" 
                                       Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       
                            <!-- Increase -->
                            <Button Grid.Column="2" Content="+" Width="32" Height="32" Padding="0" 
                                    FontSize="18" FontWeight="Bold" Foreground="#16A34A" Background="#DCFCE7" 
                                    BorderBrush="Transparent" Click="IncreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Window Content Container -->
    <Grid>
        <!-- Shadow Layer -->
        <Border CornerRadius="16" Background="White">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="25" ShadowDepth="10" />
            </Border.Effect>
        </Border>

        <!-- Main Glassmorphism Content -->
        <Border CornerRadius="16" BorderBrush="#80FFFFFF" BorderThickness="1.5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BgStop1" Color="#FFF0F8FF" Offset="0.0" />
                    <GradientStop x:Name="BgStop2" Color="#FFE6FAFF" Offset="0.5" />
                    <GradientStop x:Name="BgStop3" Color="#FFF0FFF0" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <ColorAnimation Storyboard.TargetName="BgStop1" Storyboard.TargetProperty="Color" To="#FFFFE4E1" Duration="0:0:6" />
                            <ColorAnimation Storyboard.TargetName="BgStop2" Storyboard.TargetProperty="Color" To="#FFF0FFFF" Duration="0:0:8" />
                            <ColorAnimation Storyboard.TargetName="BgStop3" Storyboard.TargetProperty="Color" To="#FFFFF0F5" Duration="0:0:7" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,16" BorderBrush="#15000000" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock" Text="Máy trạm: PC" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="OrderedPreviewTextBlock" Text="Đã gọi: Chưa gửi dịch vụ." FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" 
                            FontSize="18" Foreground="#64748B" FontWeight="Bold" IsCancel="True" Click="CloseButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Category Menu -->
                <Border Grid.Column="0" Margin="0,0,10,0" Background="#F8FAFC" CornerRadius="12" BorderBrush="#15000000" BorderThickness="1">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mục lục" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,12"/>
                        
                        <!-- Search Box -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#E2E8F0" Padding="8,6" Margin="0,0,0,12">
                            <Grid>
                                <TextBlock Text="Tìm kiếm..." Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#1E293B"/>
                            </Grid>
                        </Border>

                        <!-- Category List -->
                        <ListBox Grid.Row="2" x:Name="CategoryListBox" SelectionChanged="CategoryListBox_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#3B82F6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Services Grid -->
                <ScrollViewer Grid.Column="1" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ServicesItemsControl" ItemTemplate="{StaticResource ServiceItemCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Cart Panel -->
                <Border Grid.Column="2" Background="#E6FFFFFF" CornerRadius="12" BorderBrush="#15000000" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Giỏ hàng của bạn" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="16,16,16,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CartItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="12,4" Background="White" CornerRadius="8" Padding="12" BorderBrush="#10000000" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ServiceName}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding UnitPriceText}" FontSize="13" Foreground="#64748B"/>
                                                        <TextBlock Text=" x " FontSize="13" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" Foreground="#3B82F6"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer (Notes & Submit) -->
            <Border Grid.Row="2" Background="#FAFFFFFF" CornerRadius="0,0,16,16" Padding="20,16" BorderBrush="#15000000" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Ghi chú (không bắt buộc):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox x:Name="NoteTextBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14" 
                                 BorderBrush="#CBD5E1" Background="#FFFFFF">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock x:Name="SummaryTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ErrorTextBlock" FontSize="13" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy" Width="100" Height="42" FontSize="15" FontWeight="SemiBold" 
                                    Foreground="#475569" Background="#F1F5F9" BorderBrush="#CBD5E1" 
                                    IsCancel="True" Margin="0,0,12,0" Click="CloseButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Gửi dịch vụ" Width="150" Height="42" FontSize="15" FontWeight="Bold" 
                                    Foreground="White" Background="#3B82F6" BorderThickness="0" 
                                    IsDefault="True" Click="OrderButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Grid>
</Window>
