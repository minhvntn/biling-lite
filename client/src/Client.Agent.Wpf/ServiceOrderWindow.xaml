<Window x:Class="Client.Agent.Wpf.ServiceOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dịch vụ" Height="760" Width="1280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <!-- ScrollViewer Customization for sleek look -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="#33000000" Margin="0" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Service Item Card Style -->
        <DataTemplate x:Key="ServiceItemCardTemplate">
            <Border Height="260" Margin="8" CornerRadius="12" 
                    Background="#E6FFFFFF" BorderBrush="#20000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="10" Direction="270" ShadowDepth="4" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Image -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#F8FAFC" ClipToBounds="True">
                        <Image Source="{Binding ServiceImageSource}" Stretch="Uniform" Margin="4" SnapsToDevicePixels="True"/>
                    </Border>
                    
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" BorderBrush="#10000000" BorderThickness="0,0,0,1"/>

                    <!-- Category tag -->
                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Margin="8" Background="#E6FFFFFF" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#475569" FontWeight="Medium"/>
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Row="1" Text="{Binding ServiceName}" FontSize="15" FontWeight="SemiBold" 
                               Foreground="#1E293B" Margin="12,10,12,4" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                    <!-- Price -->
                    <TextBlock Grid.Row="2" Text="{Binding UnitPriceText}" FontSize="14" FontWeight="Bold" 
                               Foreground="#3B82F6" Margin="12,0,12,8"/>

                    <!-- Order Stats -->
                    <StackPanel Grid.Row="3" Margin="12,0" VerticalAlignment="Top">
                        <TextBlock FontSize="12" Foreground="#64748B" TextWrapping="Wrap">
                            <Run Text="Đã gọi: " FontWeight="Medium"/>
                            <Run Text="{Binding ExistingText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Quantity Control -->
                    <Border Grid.Row="4" Margin="12,10,12,12" Background="#F1F5F9" CornerRadius="8" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Decrease -->
                            <Button Grid.Column="0" Content="-" Width="32" Height="32" Padding="0" 
                                    FontSize="18" FontWeight="Bold" Foreground="#DC2626" Background="#FEE2E2" 
                                    BorderBrush="Transparent" IsEnabled="{Binding CanDecrease}"
                                    Click="DecreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Value -->
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="16" FontWeight="Bold" 
                                       Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       
                            <!-- Increase -->
                            <Button Grid.Column="2" Content="+" Width="32" Height="32" Padding="0" 
                                    FontSize="18" FontWeight="Bold" Foreground="#16A34A" Background="#DCFCE7" 
                                    BorderBrush="Transparent" Click="IncreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Glassmorphism Border -->
    <Border CornerRadius="16" BorderBrush="#80FFFFFF" BorderThickness="1.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BgStop1" Color="#FFF0F8FF" Offset="0.0" />
                <GradientStop x:Name="BgStop2" Color="#FFE6FAFF" Offset="0.5" />
                <GradientStop x:Name="BgStop3" Color="#FFF0FFF0" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <ColorAnimation Storyboard.TargetName="BgStop1" Storyboard.TargetProperty="Color" To="#FFFFE4E1" Duration="0:0:6" />
                        <ColorAnimation Storyboard.TargetName="BgStop2" Storyboard.TargetProperty="Color" To="#FFF0FFFF" Duration="0:0:8" />
                        <ColorAnimation Storyboard.TargetName="BgStop3" Storyboard.TargetProperty="Color" To="#FFFFF0F5" Duration="0:0:7" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="25" ShadowDepth="10" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="20,16" BorderBrush="#15000000" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock" Text="Máy trạm: PC" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="OrderedPreviewTextBlock" Text="Đã gọi: Chưa gửi dịch vụ." FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" 
                            FontSize="18" Foreground="#64748B" FontWeight="Bold" IsCancel="True" Click="CloseButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Services Grid -->
            <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ServicesItemsControl" ItemTemplate="{StaticResource ServiceItemCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer (Notes & Submit) -->
            <Border Grid.Row="2" Background="#FAFFFFFF" CornerRadius="0,0,16,16" Padding="20,16" BorderBrush="#15000000" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Ghi chú (không bắt buộc):" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBox x:Name="NoteTextBox" Height="48" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Padding="8" FontSize="14" 
                                 BorderBrush="#CBD5E1" Background="#FFFFFF">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock x:Name="SummaryTextBlock" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ErrorTextBlock" FontSize="13" Foreground="#DC2626" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Hủy" Width="100" Height="42" FontSize="15" FontWeight="SemiBold" 
                                    Foreground="#475569" Background="#F1F5F9" BorderBrush="#CBD5E1" 
                                    IsCancel="True" Margin="0,0,12,0" Click="CloseButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Gửi dịch vụ" Width="150" Height="42" FontSize="15" FontWeight="Bold" 
                                    Foreground="White" Background="#3B82F6" BorderThickness="0" 
                                    IsDefault="True" Click="OrderButton_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
