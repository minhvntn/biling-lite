<Window x:Class="Client.Agent.Wpf.ServiceOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dịch vụ" Height="820" Width="1280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <!-- ScrollViewer Customization for sleek look -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#CBD5E1" CornerRadius="2" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Service Item Card Style -->
        <DataTemplate x:Key="ServiceItemCardTemplate">
            <Border Margin="0,0,16,16" Background="White" CornerRadius="12" BorderBrush="#F1F5F9" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="8" Direction="270" ShadowDepth="2" />
                </Border.Effect>
                <Grid Height="280">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Image Section -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="#F8FAFC" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding ServiceImageSource}" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
                            <!-- Category Badge -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" 
                                    Background="#E6FFFFFF" CornerRadius="12" Padding="8,4">
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#475569" FontWeight="Medium"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Content Section -->
                    <Grid Grid.Row="1" Margin="16,12,16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Text="{Binding ServiceName}" FontSize="15" FontWeight="Bold" 
                                   Foreground="#1E293B" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                        <!-- Price -->
                        <TextBlock Grid.Row="1" Text="{Binding UnitPriceText}" FontSize="14" FontWeight="Bold" 
                                   Foreground="#8B5CF6" Margin="0,4,0,0"/>

                        <!-- Quantity Control -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Decrease -->
                            <Button Grid.Column="0" Content="-" Height="36" Padding="0" 
                                    FontSize="18" FontWeight="Medium" Foreground="#64748B" Background="White" 
                                    BorderBrush="#E2E8F0" BorderThickness="1" IsEnabled="{Binding CanDecrease}"
                                    Click="DecreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            
                            <!-- Value -->
                            <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       
                            <!-- Increase -->
                            <Button Grid.Column="2" Content="+" Height="36" Padding="0" 
                                    FontSize="18" FontWeight="Medium" Foreground="#10B981" Background="#D1FAE5" 
                                    BorderThickness="0" Click="IncreaseQuantity_Click" Tag="{Binding}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Main Window Content Container -->
    <Border CornerRadius="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.1" BlurRadius="25" ShadowDepth="10" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,20" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Icon -->
                    <Border Grid.Column="0" Width="48" Height="48" Background="#EDE9FE" CornerRadius="12" Margin="0,0,16,0">
                        <TextBlock Text="🖥️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock" Text="Máy trạm: PC-12" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock x:Name="OrderedPreviewTextBlock" Text="Đã gọi: Chưa gửi dịch vụ." FontSize="14" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2" Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" 
                            FontSize="18" Foreground="#64748B" FontWeight="Bold" IsCancel="True" Click="CloseButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="18"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Category Menu -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Margin="0,0,24,0">
                    <Grid Margin="16,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="Danh mục" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="4,0,0,16"/>
                        
                        <!-- Search Box -->
                        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Tìm kiếm món..." Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Column="1" x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" FontSize="14" Foreground="#1E293B"/>
                            </Grid>
                        </Border>

                        <!-- Category List -->
                        <ListBox Grid.Row="2" x:Name="CategoryListBox" SelectionChanged="CategoryListBox_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconTxt" Text="🏷️" FontSize="16" Margin="0,0,12,0" Foreground="#8B5CF6"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="Tất cả">
                                            <Setter TargetName="IconTxt" Property="Text" Value="🎛️"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Nước">
                                            <Setter TargetName="IconTxt" Property="Text" Value="🥤"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Đồ ăn">
                                            <Setter TargetName="IconTxt" Property="Text" Value="🍜"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Ăn vặt">
                                            <Setter TargetName="IconTxt" Property="Text" Value="🍟"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="Thuốc">
                                            <Setter TargetName="IconTxt" Property="Text" Value="💊"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="16,14"/>
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#8B5CF6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#7C3AED"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Center Panel: Services Grid -->
                <Grid Grid.Column="1" Margin="0,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Center Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Tất cả món" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                            <TextBlock x:Name="ServiceCountBadge" Text="12 món" FontSize="13" Foreground="#64748B" FontWeight="Medium"/>
                        </Border>
                        
                        <!-- Right Tools (Mock UI) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="⊞" Width="40" Height="36" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontSize="18" ToolTip="Dạng lưới">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8,0,0,8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="≡" Width="40" Height="36" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="18" ToolTip="Dạng danh sách"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="36">
                                    <TextBlock Text="Mới nhất" Foreground="#475569" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="⌄" Foreground="#64748B" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Services Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <ItemsControl x:Name="ServicesItemsControl" ItemTemplate="{StaticResource ServiceItemCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" VerticalAlignment="Top"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Right Panel: Cart -->
                <Border Grid.Column="2" Background="White" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="16,16,0,0" Padding="20,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" FontSize="18" Margin="0,0,8,0" Foreground="#8B5CF6"/>
                                <TextBlock Text="Giỏ hàng của bạn" FontSize="16" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Empty State -->
                        <StackPanel Grid.Row="1" x:Name="EmptyCartPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="🛍️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                            <TextBlock Text="Chưa có món nào được chọn" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Hãy chọn món bạn muốn gọi từ danh sách" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Cart Items -->
                        <ScrollViewer Grid.Row="1" x:Name="CartItemsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8">
                            <ItemsControl x:Name="CartItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="16,8" Background="White" CornerRadius="12" Padding="12" BorderBrush="#F1F5F9" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ServiceName}" FontSize="14" FontWeight="Bold" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding UnitPriceText}" FontSize="13" Foreground="#64748B"/>
                                                        <TextBlock Text=" x " FontSize="13" Foreground="#64748B"/>
                                                        <TextBlock Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" Foreground="#8B5CF6"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" FontSize="15" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                
                                                <!-- Delete Button -->
                                                <Button Grid.Column="2" Content="✕" Width="28" Height="28" Background="#FEE2E2" Foreground="#EF4444" BorderThickness="0" FontSize="14" FontWeight="Bold" Click="RemoveFromCart_Click" Tag="{Binding}" ToolTip="Xóa món">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="8"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Summary -->
                        <Border Grid.Row="2" Padding="20" Background="#FAFAFA" CornerRadius="0,0,16,16" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SummaryItemCountTextBlock" Grid.Column="0" Text="Đã chọn 0 món" FontSize="13" Foreground="#64748B"/>
                                    <TextBlock x:Name="SummaryNetTextBlock" Grid.Column="1" Text="Tạm tính: 0 đ" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </Grid>
                                
                                <WrapPanel Margin="0,0,0,16">
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,12,4">
                                        <Run Text="➕ " Foreground="#10B981"/>
                                        <Run Text="Thêm: "/>
                                        <Run x:Name="SummaryAddedTextBlock" Text="0 đ" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,12,4">
                                        <Run Text="➖ " Foreground="#EF4444"/>
                                        <Run Text="Hủy: "/>
                                        <Run x:Name="SummaryCanceledTextBlock" Text="0 đ" FontWeight="Medium"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,0,4">
                                        <Run Text="⚖ " Foreground="#3B82F6"/>
                                        <Run Text="Lệch: "/>
                                        <Run x:Name="SummaryDiffTextBlock" Text="0 đ" FontWeight="Medium"/>
                                    </TextBlock>
                                </WrapPanel>
                                
                                <Border Background="#EDE9FE" CornerRadius="12" Padding="12,14">
                                    <Grid>
                                        <TextBlock Text="Tổng cộng" FontSize="14" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SummaryTotalTextBlock" Text="0 đ" FontSize="18" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer Panel (Row 2) -->
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,16,16" Padding="24" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#EDE9FE" CornerRadius="12" Width="48" Height="48" Margin="0,0,16,0">
                        <TextBlock Text="📝" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="Ghi chú (không bắt buộc)" FontSize="13" FontWeight="Medium" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBox x:Name="NoteTextBox" Height="44" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalScrollBarVisibility="Auto" Padding="12,10" FontSize="14" 
                                 BorderBrush="#E2E8F0" Background="#F8FAFC"
                                 Tag="Nhập ghi chú cho đơn hàng...">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorTextBlock" FontSize="13" Foreground="#EF4444" Margin="0,0,16,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        
                        <Button Content="✕ Hủy" Width="120" Height="48" FontSize="15" FontWeight="SemiBold" 
                                Foreground="#475569" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" 
                                IsCancel="True" Margin="0,0,16,0" Click="CloseButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Width="160" Height="48" Background="#8B5CF6" BorderThickness="0" 
                                IsDefault="True" Click="OrderButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✈" FontSize="16" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Gửi dịch vụ" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
