                                <TextBlock Text="ĐỊA CHỈ MÁY CHỦ BILLING (SERVER IP)"
                                           Foreground="#64748B"
                                           FontWeight="Bold"
                                           FontSize="11"
                                           Margin="2,0,0,6" />
                                
                                <Border Style="{StaticResource ModernFieldBorder}" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" 
                                              Data="M4 1h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zm0 8h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zm0 8h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1zM6 4h2v1H6V4zm0 8h2v1H6v-1zm0 8h2v1H6v-1z"
                                              Fill="#6366F1"
                                              Stretch="Uniform"
                                              Width="16"
                                              Height="16"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                        <TextBox x:Name="ServerIpTextBox"
                                                 Grid.Column="1"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 Padding="4,0,14,0"
                                                 FontSize="14.5"
                                                 FontWeight="SemiBold"
                                                 Foreground="#0F172A"
                                                 CaretBrush="#4F46E5" />
                                    </Grid>
                                </Border>

                                <Button x:Name="SaveServerButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="48"
                                        Content="Cập nhật &amp; Kết nối lại"
                                        FontSize="14.5"
                                        FontWeight="Bold"
                                        Click="SaveServerButton_Click" />

                                <!-- Status Badge Block -->
                                <Border Margin="0,14,0,0" Padding="12,9" Background="#F8FAFC" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ServerSetupStatusTextBlock"
                                                   Foreground="#059669"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- Error Alert Banner -->
                    <Border x:Name="ErrorBorder" 
                            Style="{StaticResource ErrorBorderStyle}"
                            Margin="0,16,0,0" 
                            Background="#FEF2F2" 
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="10" 
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" 
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" 
                                  Fill="#DC2626" 
                                  Stretch="Uniform" 
                                  Width="14" 
                                  Height="14" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Left" />
                            <TextBlock x:Name="ErrorTextBlock"
                                       Grid.Column="1"
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Credits -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28">
            <TextBlock Text="CYBER MANAGER BILLING • AGENT TERMINAL v2.0" 
                       Foreground="White" 
                       Opacity="0.45" 
                       FontSize="11.5" 
                       FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
