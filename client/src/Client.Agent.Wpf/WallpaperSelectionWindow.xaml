<Window x:Class="Client.Agent.Wpf.WallpaperSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi Hình Nền VIP" Height="450" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="8,8,0,0" Padding="15">
                <Grid>
                    <TextBlock Text="ĐỔI HÌNH NỀN VIP" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="CloseButton_Click" Cursor="Hand" FontSize="16"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <WrapPanel x:Name="WallpapersContainer" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Đang tải..." Foreground="#94A3B8" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            
            <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="#EF4444" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,8,8" Padding="15">
                <Button Content="ĐÓNG" Width="100" Height="35" Background="#334155" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
