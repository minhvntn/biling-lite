<Window x:Class="Client.Agent.Wpf.HorseRaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đua Ngựa Tốc Độ" Height="960" Width="1280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0B132B" Foreground="White"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="25" x:Name="MainContainer">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainContainerTransform" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: BETTING CONTROLS -->
        <StackPanel Grid.Column="0">
            <!-- Horse Selection Border -->
            <Border BorderThickness="1" BorderBrush="#1E293B" Background="#050B14" CornerRadius="12" Padding="15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="🐎" Foreground="#3B82F6" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CHỌN NGỰA" FontSize="18" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ListBox x:Name="HorseSelectionListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderThickness="1" BorderBrush="#1E293B" Background="#0B132B" CornerRadius="8" Padding="10,4">
                                                <Grid>
                                                    <ContentPresenter/>
                                                    <!-- Circle Checkmark -->
                                                    <Border x:Name="CheckIcon" Width="24" Height="24" CornerRadius="12" Background="#FACC15" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden">
                                                        <TextBlock Text="✔" Foreground="#000" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FACC15"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A1C10"/>
                                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#334155"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#111827"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding ImagePath}" Height="30" Width="30" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="0,0,10,0" FontSize="16"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="16"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Bottom Panel: Points and Betting combined -->
            <Border BorderThickness="1" BorderBrush="#1E293B" Background="#050B14" CornerRadius="12" Padding="15" Margin="0,10,0,0">
                <StackPanel>
                    <!-- Points Row -->
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ĐIỂM HIỆN CÓ" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <TextBlock x:Name="AvailablePointsText" Text="0" FontSize="28" FontWeight="Black" Foreground="#FACC15"/>
                        </StackPanel>
                        <Border Width="32" Height="32" CornerRadius="16" BorderThickness="2" BorderBrush="#FACC15" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1a1c10">
                            <TextBlock Text="⭐" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <Rectangle Height="1" Fill="#1E293B" Margin="0,10,0,10"/>

                    <!-- Bet Row -->
                    <TextBlock Text="MỨC CƯỢC" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="−" Width="36" Height="36" FontSize="24" FontWeight="Bold" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Click="DecreaseBet_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        
                        <Slider Grid.Column="1" x:Name="BetPointsSlider" Minimum="1" Maximum="20" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="15,0"/>
                        
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=BetPointsSlider, Path=Value}" FontSize="24" FontWeight="Bold" Foreground="#FACC15" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        
                        <Button Grid.Column="3" Content="+" Width="36" Height="36" FontSize="20" FontWeight="Bold" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Click="IncreaseBet_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="18"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                    
                    <Button x:Name="StartRaceButton" Height="56" Background="#10B981" Foreground="White" BorderThickness="0" Click="StartRaceButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▶" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="BẮT ĐẦU ĐUA" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <TextBlock Text="Nhấn nút để bắt đầu cuộc đua" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- RIGHT PANEL: TRACKS -->
        <Grid Grid.Column="1" Margin="25,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ĐUA NGỰA TỐC ĐỘ" FontSize="42" FontWeight="Black" 
                       Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#38BDF8" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="MultipliersInfoText" Grid.Row="1" Text="Dự đoán ngựa về nhất để nhân 3, về nhì nhân 2.25, về ba nhân 1.5 số điểm cược!" 
                       Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="20">
                <ItemsControl x:Name="TracksItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Margin="0,0,0,2" Padding="10,2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#0F172A"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectedInList}" Value="True">
                                                <Setter Property="Background" Value="#1e1814"/>
                                                <Setter Property="BorderBrush" Value="#F97316"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                                <Setter Property="Background" Value="#1E1B4B"/>
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="{Binding ColorValue}" BlurRadius="15" ShadowDepth="0" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="16" Foreground="{Binding ColorHex}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Canvas Grid.Column="1" Height="64" Margin="10,0" ClipToBounds="True" x:Name="TrackCanvas">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                                        <Setter Property="Background" Value="#312E81"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Border Width="6" Height="64" Background="{Binding ColorHex}" Canvas.Right="0"/>
                                        
                                        <Border Height="4" Canvas.Top="30" Width="{Binding TrailWidth}" CornerRadius="2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="{Binding ColorValue}" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="{Binding ColorValue}" BlurRadius="8" ShadowDepth="0"/>
                                            </Border.Effect>
                                        </Border>
                                        
                                        <Image Source="{Binding ImagePath}" Width="64" Height="64" Canvas.Top="0" 
                                                   RenderTransform="{Binding Transform}" x:Name="HorseIcon">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBoosting}" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="White" BlurRadius="20" ShadowDepth="0" Opacity="1"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Canvas>

                                    <TextBlock Grid.Column="2" Text="{Binding DistanceText}" FontWeight="SemiBold" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Race Overlays -->
        <Border x:Name="FlashOverlay" Grid.ColumnSpan="2" Background="White" Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="PhotoFinishOverlay" Grid.ColumnSpan="2" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="📷 PHOTO FINISH 📷" FontSize="60" FontWeight="Black" Foreground="#FACC15" 
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FACC15" BlurRadius="20" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <Border x:Name="BoostOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,150,0,0">
            <TextBlock x:Name="BoostOverlayText" Text="⚡ H5 BOOST! ⚡" FontSize="48" FontWeight="Black" Foreground="#10B981" 
                       HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#10B981" BlurRadius="15" ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <!-- Result Overlay -->
        <Border x:Name="ResultOverlay" Grid.ColumnSpan="2" Background="#D80F172A" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ResultTitleText" Text="CHÚC MỪNG!" FontSize="48" FontWeight="ExtraBold" 
                           Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="ResultMessageText" Text="Ngựa #1 đã về nhất. Bạn trúng 50 điểm!" 
                           FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="ĐÓNG" Width="120" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#334155" Foreground="White" BorderThickness="0"
                        Click="CloseOverlayButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
