<Window x:Class="Client.Agent.Wpf.HorseRaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đua Ngựa Tốc Độ" Height="900" Width="1024"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0F172A" Foreground="White"
        WindowStyle="SingleBorderWindow"
        Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="ĐUA NGỰA TỐC ĐỘ" FontSize="36" FontWeight="ExtraBold" 
                   Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,0,0,5">
            <TextBlock.Effect>
                <DropShadowEffect Color="#38BDF8" BlurRadius="15" ShadowDepth="0"/>
            </TextBlock.Effect>
        </TextBlock>
        <TextBlock Grid.Row="1" Text="Dự đoán ngựa về nhất để nhân 3, về nhì nhân 2.25, về ba nhân 1.5 số điểm cược!" 
                   Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Tracks -->
        <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="15">
            <ItemsControl x:Name="TracksItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0F172A" CornerRadius="8" Margin="0,0,0,6" Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="16" Foreground="{Binding ColorHex}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Canvas Grid.Column="1" Height="36" Margin="10,0" ClipToBounds="True" Background="#1E293B" x:Name="TrackCanvas">
                                    <!-- Finish Line -->
                                    <Border Width="6" Height="36" Background="#EF4444" Canvas.Right="0"/>
                                    
                                    <!-- Trail -->
                                    <Border Height="3" Background="{Binding ColorHex}" Canvas.Top="18" Width="{Binding TrailWidth}" CornerRadius="1.5">
                                        <Border.Effect>
                                            <DropShadowEffect Color="{Binding ColorHex}" BlurRadius="8" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                    
                                    <!-- Horse -->
                                    <TextBlock Text="{Binding Icon}" FontSize="30" Canvas.Top="-5" 
                                               RenderTransform="{Binding Transform}" x:Name="HorseIcon"/>
                                </Canvas>

                                <TextBlock Grid.Column="2" Text="{Binding DistanceText}" FontWeight="SemiBold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#64748B"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Betting Panel -->
        <Border Grid.Row="3" Style="{StaticResource GlassPanel}" Margin="0,20,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="Chọn ngựa:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ListBox x:Name="HorseSelectionListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" Rows="2"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" CornerRadius="6" Padding="8,6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#10B981"/> <!-- Green 500 -->
                                                    <Setter TargetName="Bd" Property="Background" Value="#064E3B"/> <!-- Green 900 -->
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                    <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{Binding ColorHex}" Margin="0,0,4,0" FontSize="13"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="White" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Điểm hiện có:" FontSize="16" Foreground="#94A3B8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AvailablePointsText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FACC15" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Mức cược:" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Slider x:Name="BetPointsSlider" Width="150" Minimum="1" Maximum="20" Value="10" 
                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding ElementName=BetPointsSlider, Path=Value}" FontSize="20" FontWeight="Bold" Foreground="#FACC15" VerticalAlignment="Center" Width="30"/>
                </StackPanel>

                <Button Grid.Row="1" Grid.Column="2" x:Name="StartRaceButton" Content="BẮT ĐẦU ĐUA" 
                        Width="160" Height="44" FontSize="16" FontWeight="Bold"
                        Background="#10B981" Foreground="White" BorderThickness="0"
                        Click="StartRaceButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
        
        <!-- Result Overlay -->
        <Border x:Name="ResultOverlay" Grid.RowSpan="4" Background="#D80F172A" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ResultTitleText" Text="CHÚC MỪNG!" FontSize="48" FontWeight="ExtraBold" 
                           Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="20" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="ResultMessageText" Text="Ngựa #1 đã về nhất. Bạn trúng 50 điểm!" 
                           FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Button Content="ĐÓNG" Width="120" Height="40" FontSize="16" FontWeight="Bold"
                        Background="#334155" Foreground="White" BorderThickness="0"
                        Click="CloseOverlayButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
