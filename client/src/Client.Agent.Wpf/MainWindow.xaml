<Window x:Class="Client.Agent.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberS Client"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0F2FE" Offset="0" />
            <GradientStop Color="#E9D5FF" Offset="0.5" />
            <GradientStop Color="#C6F6D5" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    
    <Window.Resources>
        <!-- Square Premium Button Style for 3x3 Grid -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#60FFFFFF" />
            <Setter Property="BorderBrush" Value="#80FFFFFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="95" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#90FFFFFF" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#00E5FF" />
                                <Setter TargetName="ButtonRoot" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#0284C7" BlurRadius="10" ShadowDepth="0" Opacity="0.3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="50" CenterY="50" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LockButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#60FFE4E6" />
            <Setter Property="BorderBrush" Value="#80FECDD3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#90FFE4E6" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#E11D48" />
                                <Setter TargetName="ButtonRoot" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#E11D48" BlurRadius="10" ShadowDepth="0" Opacity="0.3" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base style for all neon icons -->
        <Style x:Key="NeonIconStyle" TargetType="Path">
            <Setter Property="Fill" Value="{x:Null}" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.LayoutTransform>
            <!-- Scale down the entire UI by 65% to make it much smaller -->
            <ScaleTransform ScaleX="0.65" ScaleY="0.65" />
        </Grid.LayoutTransform>

        <Border BorderThickness="0" CornerRadius="0">
            <Border.Background>
                <SolidColorBrush Color="#20FFFFFF" />
            </Border.Background>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />  <!-- Promotions -->
                    <RowDefinition Height="Auto" />  <!-- TopupPromo Full Width -->
                    <RowDefinition Height="*" />     <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="AgentIdTextBlock" Foreground="#0F172A" FontWeight="Bold" FontSize="26" Margin="0,0,10,0" />
                        <Border Width="12" Height="12" CornerRadius="6" Background="#00FF66" x:Name="ConnectionIndicator" VerticalAlignment="Center" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="10" ShadowDepth="0" />
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="ConnectionStatusTextBlock" Visibility="Collapsed" Text="Connected" />
                    </StackPanel>

                    <!-- User Badge -->
                    <Border Grid.Column="1" x:Name="UserInfoPanel" Background="Transparent" BorderThickness="0" CornerRadius="20" Padding="8,4,16,4" Margin="0,0,20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AvatarButton" Click="AvatarButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,10,0" Padding="0" ToolTip="Đổi Avatar">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="RootBorder" Width="60" Height="60" CornerRadius="30" BorderBrush="#40FFFFFF" BorderThickness="2" Background="{TemplateBinding Background}">
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#00E5FF" />
                                                <Setter TargetName="RootBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="MemberUsernameTextBlock" Foreground="#0F172A" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Image x:Name="VipIconImage" Width="28" Height="28" Visibility="Collapsed" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CollapseButton" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" Click="CollapseButton_Click" Cursor="Hand" ToolTip="Rút gọn/Mở rộng">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BgBorder" Background="#50FFFFFF" BorderBrush="#99FFFFFF" BorderThickness="1.5" CornerRadius="16" Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BgBorder" Property="Background" Value="#70FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BgBorder" Property="Background" Value="#30FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CollapseButtonIcon" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0F172A" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CollapseButtonText" Text="Thu gọn" Foreground="#0F172A" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Content="–" Width="30" Height="30" Foreground="#475569" Background="Transparent" BorderThickness="0" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Click="MinimizeButton_Click" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- BODY -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: Huge Circular Progress -->
                    <Grid x:Name="LeftColumnGrid" Grid.Column="0" Margin="0,0,15,0">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel x:Name="LeftColumnRankPanel" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Grid Width="280" Height="280" HorizontalAlignment="Center">
                                <!-- Background Track -->
                                <Ellipse Stroke="#40FFFFFF" StrokeThickness="15" />
                                                      <!-- Dynamic Arc (Using Path) -->
                                <Path x:Name="ProgressArcPath" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#22C55E" Offset="0"/>
                                            <GradientStop Color="#00D4FF" Offset="0.6"/>
                                            <GradientStop Color="#0088FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Stroke>
                                    <Path.Effect>
                                        <DropShadowEffect Color="#00D4FF" BlurRadius="25" ShadowDepth="0" Opacity="0.6"/>
                                    </Path.Effect>
                                </Path>

                                 <!-- Inner Info -->
                                 <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                     <!-- Percentage Badge -->
                                     <Border x:Name="PercentageBadge" Background="#22C55E" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                                         <TextBlock x:Name="PercentageValueTextBlock" Text="72%" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                     </Border>

                                     <!-- Label (Removed) -->

                                     <!-- Big Hero Value -->
                                     <Viewbox MaxWidth="220" MaxHeight="80" HorizontalAlignment="Center" Margin="0,0,0,8">
                                         <TextBlock x:Name="RemainingTimeValueTextBlock" Text="260:37" FontSize="50" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center">
                                             <TextBlock.Foreground>
                                                 <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                     <GradientStop Color="#0088FF" Offset="0"/>
                                                     <GradientStop Color="#00D4FF" Offset="0.6"/>
                                                     <GradientStop Color="#22C55E" Offset="1"/>
                                                 </LinearGradientBrush>
                                             </TextBlock.Foreground>
                                         </TextBlock>
                                     </Viewbox>

                                     <!-- Bottom Stats Pill -->
                                     <Border x:Name="BottomStatsPill" Background="#80FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="16" Padding="10,3" HorizontalAlignment="Center">
                                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                             <!-- Total Time Part -->
                                             <StackPanel x:Name="TotalTimeContainer" Orientation="Horizontal" VerticalAlignment="Center">
                                                 <Path Data="M12,20 C16.41,20 20,16.41 20,12 C20,7.59 16.41,4 12,4 C7.59,4 4,7.59 4,12 C4,16.41 7.59,20 12,20 Z M12,7 L12,12 L15,14" 
                                                       Stroke="#334155" StrokeThickness="1.5" Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" Fill="{x:Null}"/>
                                                 <TextBlock x:Name="TotalTimeValueTextBlock" Text="260:44" Foreground="#334155" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                                 <!-- Divider -->
                                                 <Border x:Name="BottomStatsDivider" Width="1" Height="16" Background="#E2E8F0" Margin="12,0"/>
                                             </StackPanel>
                                             <!-- Used Time Part -->
                                             <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                 <Path Data="M12,20 C16.41,20 20,16.41 20,12 C20,7.59 16.41,4 12,4 C7.59,4 4,7.59 4,12 C4,16.41 7.59,20 12,20 Z M12,4 V2 M10,2 H14 M12,12 L15,9"
                                                       Stroke="#EF4444" StrokeThickness="1.5" Width="18" Height="18" Margin="0,0,6,0" Stretch="Uniform" Fill="{x:Null}"/>
                                                 <TextBlock x:Name="UsedTimeLabelTextBlock" Visibility="Collapsed"/>
                                                 <TextBlock x:Name="UsedTimeValueTextBlock" Text="00:07" Foreground="#EF4444" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                             </StackPanel>
                                         </StackPanel>
                                     </Border>
                                 </StackPanel>
                             </Grid>

                             <!-- External Info -->
                             <StackPanel x:Name="ExternalInfoPanel" Margin="0,24,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    
                                    <!-- Game Cost Pill -->
                                    <Border Background="#E0F2FE" CornerRadius="16" Padding="16,8" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="GameCostLabelTextBlock" Visibility="Collapsed"/>
                                            <TextBlock x:Name="GameCostValueTextBlock" Text="0" Foreground="#0284C7" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Service Cost Pill -->
                                    <Border Background="#FFE4E6" CornerRadius="16" Padding="16,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#E11D48" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="ServiceCostLabelTextBlock" Visibility="Collapsed"/>
                                            <TextBlock x:Name="ServiceCostValueTextBlock" Text="0" Foreground="#E11D48" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Hidden elements to preserve bindings -->
                        <TextBlock x:Name="LastCommandTextBlock" Visibility="Collapsed" />
                        <Grid Visibility="Collapsed">
                            <TextBlock x:Name="StatusIconTextBlock" />
                            <TextBlock x:Name="StatusTitleTextBlock" />
                            <TextBlock x:Name="MachineStateTextBlock" />
                        </Grid>
                    </Grid>

                    <!-- RIGHT COLUMN: VIP + Action Buttons -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="RightColumnRankPanel" Grid.Row="0" Margin="6,0,6,0">
                            <!-- VIP Card -->
                            <Grid x:Name="MemberRankContainer" Visibility="Collapsed" Margin="0,0,0,8" Height="80" HorizontalAlignment="Stretch">
                                <Border x:Name="MemberRankGlowBorder" CornerRadius="16" Opacity="0" Background="White" BorderThickness="0">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="MemberRankGlowEffect" BlurRadius="0" ShadowDepth="0" Color="#FF4500" Opacity="0" RenderingBias="Performance"/>
                                    </Border.Effect>
                                </Border>
                                
                                <Border x:Name="MemberRankBorder" CornerRadius="16" BorderThickness="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E6FFFFFF" Offset="0"/>
                                            <GradientStop Color="#D8B4FE" Offset="0.5"/>
                                            <GradientStop Color="#CCFFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid Margin="16,0">
                                        <Border x:Name="MemberRankVipLabel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0" Background="#FFF1F2" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="8" Padding="6,2" Visibility="Collapsed">
                                            <TextBlock Text="VIP" Foreground="#E11D48" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                        
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border x:Name="MemberRankIconBadgeBorder" Width="52" Height="52" CornerRadius="26" Background="#F8FAFC" BorderBrush="#FFFFFF" BorderThickness="2" Margin="0,0,16,0">
                                                <Grid>
                                                    <Image x:Name="MemberRankIconImage" Width="38" Height="38" Visibility="Collapsed" Stretch="Uniform" />
                                                    <TextBlock x:Name="MemberRankIconTextBlock" Foreground="#00D4FF" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Text="R" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="MemberRankTextBlock" Foreground="#0F172A" FontSize="20" FontWeight="Black" />
                                                <TextBlock x:Name="MemberPointsTextBlock" Text="0 điểm" Foreground="#64748B" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="SparklesContainer" Visibility="Collapsed" Panel.ZIndex="10">
                                    <TextBlock Text="✨" Foreground="#FDE047" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20, -10, 0, 0" x:Name="Sparkle1" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle1Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FDE047" BlurRadius="5" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✨" Foreground="#A855F7" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, -5, 25, 0" x:Name="Sparkle2" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle2Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✦" Foreground="#2DD4BF" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="60, -20, 0, 0" x:Name="Sparkle3" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle3Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#2DD4BF" BlurRadius="4" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✨" Foreground="#F43F5E" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, -15, 60, 0" x:Name="Sparkle4" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle4Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#F43F5E" BlurRadius="6" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✦" Foreground="#3B82F6" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, -5, 0, 0" x:Name="Sparkle5" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle5Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#3B82F6" BlurRadius="4" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✨" Foreground="#EC4899" FontSize="15" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110, -15, 0, 0" x:Name="Sparkle6" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle6Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#EC4899" BlurRadius="6" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✦" Foreground="#EAB308" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, -8, 100, 0" x:Name="Sparkle7" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle7Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#EAB308" BlurRadius="5" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="✨" Foreground="#8B5CF6" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="70, -20, 0, 0" x:Name="Sparkle8" Opacity="0">
                                        <TextBlock.RenderTransform><TranslateTransform x:Name="Sparkle8Transform" Y="0"/></TextBlock.RenderTransform>
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#8B5CF6" BlurRadius="7" ShadowDepth="0" Opacity="0.8" RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- Action Buttons Grid (3x3) using SVG Paths for perfect Neon Icons -->
                        <UniformGrid x:Name="ActionButtonsGrid" Grid.Row="1" Columns="3" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionButtonStyle}" Click="MessagesButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M3,7 C3,5 5,3 8,3 L16,3 C19,3 21,5 21,7 L21,15 C21,17 19,19 16,19 L10,19 L5,22 L5,19 C4,18 3,16 3,15 Z">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3B82F6" Offset="0"/><GradientStop Color="#06B6D4" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="MessagesIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="MessagesLabelTextBlock" Text="Tin nhắn" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ActionButtonStyle}" Click="ServicesButton_Click">
                                <StackPanel>
                                    <Grid Width="40" Height="34" HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Style="{StaticResource NeonIconStyle}" Data="M2,3 L5,3 L7.5,15 A2,2 0 0,0 9.5,17 L18,17 A2,2 0 0,0 20,15 L21,7 L6,7 M9,21 A1.5,1.5 0 1,1 9,20.9 M18,21 A1.5,1.5 0 1,1 18,20.9">
                                                <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F59E0B" Offset="0"/><GradientStop Color="#FBBF24" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                                <Path.Effect><DropShadowEffect Color="#F59E0B" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                            </Path>
                                        </Viewbox>
                                        <!-- Keep hidden textblock to preserve x:Name binding -->
                                        <TextBlock x:Name="ServicesIconTextBlock" Visibility="Collapsed" />
                                        <Border x:Name="ServicesBadgeBorder" Visibility="Collapsed" Background="#FF0044" BorderBrush="#141B29" BorderThickness="2" CornerRadius="10" MinWidth="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Padding="4,0">
                                            <TextBlock x:Name="ServicesBadgeTextBlock" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="ServicesLabelTextBlock" Text="Dịch vụ" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="LoyaltyActionButton" Style="{StaticResource ActionButtonStyle}" Click="LoyaltyButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M12,2 L15,9 L22,9 L16,14 L18,21 L12,17 L6,21 L8,14 L2,9 L9,9 Z">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#10B981" Offset="0"/><GradientStop Color="#34D399" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="LoyaltyIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="LoyaltyLabelTextBlock" Text="Đổi điểm" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="TransferActionButton" Style="{StaticResource ActionButtonStyle}" Click="TransferBalanceButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M4,8 L20,8 M16,4 L20,8 L16,12 M20,16 L4,16 M8,12 L4,16 L8,20">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#D946EF" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="TransferIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="TransferLabelTextBlock" Text="Chuyển tiền" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="WithdrawActionButton" Style="{StaticResource ActionButtonStyle}" Click="WithdrawBalanceButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M12,4 L12,16 M8,12 L12,16 L16,12 M4,20 L20,20">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EA580C" Offset="0"/><GradientStop Color="#F97316" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#EA580C" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="WithdrawIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="WithdrawLabelTextBlock" Text="Rút tiền" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="TopupRequestActionButton" Style="{StaticResource ActionButtonStyle}" Click="TopupRequestButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M3,7 C3,6 4,5 5,5 L19,5 C20,5 21,6 21,7 L21,17 C21,18 20,19 19,19 L5,19 C4,19 3,18 3,17 Z M3,10 L21,10">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0891B2" Offset="0"/><GradientStop Color="#2DD4BF" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#0891B2" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="TopupRequestIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="TopupRequestLabelTextBlock" Text="Nạp tiền" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="PasswordActionButton" Style="{StaticResource ActionButtonStyle}" Click="PasswordButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M15,5 A4.5,4.5 0 1,1 15,14 A4.5,4.5 0 0,1 15,5 M11.5,10.5 L3,19 L3,22 L6,22 L6,19 L9,19 L9,16 L11.5,13.5">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4338CA" Offset="0"/><GradientStop Color="#818CF8" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#4338CA" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="PasswordIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="PasswordLabelTextBlock" Text="Mật mã" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="LogoutActionButton" Style="{StaticResource ActionButtonStyle}" Click="LogoutButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M10,4 L6,4 C5,4 4,5 4,6 L4,18 C4,19 5,20 6,20 L10,20 M14,8 L18,12 L14,16 M18,12 L8,12">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E11D48" Offset="0"/><GradientStop Color="#FB7185" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#E11D48" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="LogoutIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="LogoutLabelTextBlock" Text="Đăng xuất" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="GameLauncherActionButton" Style="{StaticResource ActionButtonStyle}" Click="GameLauncherButton_Click" Visibility="Collapsed">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M21,10 C21,6 17,4 12,4 C7,4 3,6 3,10 C3,14 5,17 7,17 C8,17 9,16 9,15 L10,14 L14,14 L15,15 C15,16 16,17 17,17 C19,17 21,14 21,10 Z M6,10 L8,10 M7,9 L7,11 M16,11 L16,11 M18,9 L18,9">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A855F7" Offset="0"/><GradientStop Color="#D946EF" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <TextBlock x:Name="GameLauncherIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="GameLauncherLabelTextBlock" Text="Menu Game" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E293B" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource LockButtonStyle}" Click="LockButton_Click">
                                <StackPanel>
                                    <Viewbox Width="26" Height="26" Margin="0,0,0,8">
                                        <Path Style="{StaticResource NeonIconStyle}" Data="M7,11 L17,11 C18,11 19,12 19,13 L19,20 C19,21 18,22 17,22 L7,22 C6,22 5,21 5,20 L5,13 C5,12 6,11 7,11 Z M9,11 L9,7 C9,4.5 15,4.5 15,7 L15,11 M12,15 L12,18">
                                            <Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DC2626" Offset="0"/><GradientStop Color="#F87171" Offset="1"/></LinearGradientBrush></Path.Stroke>
                                            <Path.Effect><DropShadowEffect Color="#DC2626" BlurRadius="8" ShadowDepth="0" Opacity="0"/></Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <!-- Keep hidden textblock to preserve x:Name binding -->
                                    <TextBlock x:Name="LockIconTextBlock" Visibility="Collapsed" />
                                    <TextBlock x:Name="LockLabelTextBlock" Text="Khóa máy" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FF0044" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- FULL WIDTH TOPUP PROMO -->
                <Grid x:Name="TopupPromotionBannerBorder" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                    <Border CornerRadius="16" Background="#60DCFCE7">
                    </Border>
                    <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="#80FFFFFF" Padding="25,15" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Viewbox Grid.Column="0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.9">
                                <Path Fill="#059669" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                            </Viewbox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TopupPromotionNameTextBlock" Foreground="#065F46" FontWeight="Bold" FontSize="20" Margin="0,0,0,4" Text="CHƯƠNG TRÌNH KHUYẾN MÃI NẠP TIỀN" />
                                <TextBlock x:Name="TopupPromotionDiscountTextBlock" Foreground="#059669" FontSize="18" TextWrapping="Wrap" Text="Nạp ngay để nhận thưởng!" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <Grid x:Name="FooterContainer" Grid.Row="4" Margin="0,8,0,0" MinHeight="90">
                    <Border CornerRadius="16" Background="#60FFFFFF">
                    </Border>
                    <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="#80FFFFFF" Padding="25,15" Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                                <TextBlock x:Name="FooterTitleTextBlock" Text="JOIN OUR LOYALTY PROGRAM" Foreground="#0F172A" FontWeight="Bold" FontSize="20" Margin="0,0,0,4" />
                                <TextBlock x:Name="FooterDescriptionTextBlock" Text="Tích lũy điểm khi chơi để đổi giờ hoặc quay thưởng hấp dẫn!" Foreground="#334155" FontSize="18" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Replaced Emoji with Path for Footer Icon to avoid any square rendering -->
                            <Viewbox Grid.Row="0" Width="48" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.3">
                                <Path Fill="#0F172A" Data="M12,2 L22,8 L12,22 L2,8 Z M4.5,8.5 L12,19.5 L19.5,8.5 Z"/>
                            </Viewbox>
                            
                            <!-- The new progress bar -->
                            <StackPanel x:Name="LoyaltyProgressContainer" Grid.Row="1" Margin="0,15,0,0" Visibility="Collapsed">
                                <Grid Height="8">
                                    <Border Background="#E2E8F0" CornerRadius="4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="LoyaltyProgressFilled" Width="0*" />
                                            <ColumnDefinition x:Name="LoyaltyProgressEmpty" Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <!-- Keep hidden textblock to preserve x:Name binding -->
                            <TextBlock x:Name="FooterIconTextBlock" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- PROMOTIONS -->
                <UniformGrid x:Name="PromotionsContainer" Grid.Row="2" Columns="1">
                    <Border x:Name="GuestPromotionBannerBorder" Visibility="Collapsed" Margin="0,0,0,8" Padding="14,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="#80FFFFFF">
                        <Border.Background>
                            <SolidColorBrush Color="#60FEF08A" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Fill="#B45309" Data="M12,2 L22,20 L2,20 Z M12,8 L12,14 M12,17 L12,17.5" Stroke="#B45309" StrokeThickness="2" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Foreground="#92400E" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" Text="Thông báo khuyến mãi" />
                                <TextBlock x:Name="GuestPromotionDiscountTextBlock" Foreground="#B45309" FontSize="18" Text="Chỉ dành cho Hội Viên" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="PromotionBannerBorder" Visibility="Collapsed" Margin="0,0,0,8" Padding="14,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="#80FFFFFF">
                        <Border.Background>
                            <SolidColorBrush Color="#60FFE4E6" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Fill="#E11D48" Data="M12,2 L15,9 L22,9 L16,14 L18,21 L12,17 L6,21 L8,14 L2,9 L9,9 Z" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PromotionNameTextBlock" Foreground="#BE123C" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" Text="Khuyến mãi giờ vàng" />
                                <TextBlock x:Name="PromotionDiscountTextBlock" Foreground="#E11D48" FontSize="18" Text="Giảm 20% tiền giờ chơi" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>



                    <Border x:Name="LoyaltyPromotionBannerBorder" Visibility="Collapsed" Padding="14,12" CornerRadius="12" BorderThickness="1.5" BorderBrush="#80FFFFFF">
                        <Border.Background>
                            <SolidColorBrush Color="#60F3E8FF" />
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Fill="#A21CAF" Data="M12,2 L22,8 L12,22 L2,8 Z M4.5,8.5 L12,19.5 L19.5,8.5 Z" />
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Foreground="#86198F" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" Text="Khuyến mãi điểm thưởng" />
                                <TextBlock x:Name="LoyaltyPromotionDiscountTextBlock" Foreground="#A21CAF" FontSize="18" Text="Hệ số nhân điểm: x2" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

            </Grid>
        </Border>
    </Grid>
</Window>

