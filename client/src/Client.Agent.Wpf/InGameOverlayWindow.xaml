<Window x:Class="Client.Agent.Wpf.InGameOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In-Game Overlay" SizeToContent="Height" Width="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ResizeMode="NoResize">
    <Border Background="#D90F172A" CornerRadius="12" Padding="15" BorderBrush="#33475569" BorderThickness="1">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MemberNameTextBlock" Grid.Column="0" Text="Đang tải..." Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#3310B981" CornerRadius="4" Padding="6,2">
                    <TextBlock Text="SHIFT + F1" Foreground="#10B981" FontSize="10" FontWeight="Bold"/>
                </Border>
            </Grid>
            
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="BalanceLabelTextBlock" Text="SỐ DƯ" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="BalanceTextBlock" Text="0 VNĐ" Foreground="#10B981" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="CÒN LẠI" Foreground="#94A3B8" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TimeTextBlock" Text="00:00" Foreground="#38BDF8" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
            
            <UniformGrid Columns="2" Rows="2">
                <Button x:Name="ServiceButton" Content="🍔 Gọi Dịch vụ" Foreground="White" Background="#33475569" BorderThickness="0" Margin="0,0,6,6" Padding="6,8" Cursor="Hand" Click="ServiceButton_Click" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ChatButton" Content="💬 Trò chuyện" Foreground="White" Background="#33475569" BorderThickness="0" Margin="0,0,0,6" Padding="6,8" Cursor="Hand" Click="ChatButton_Click" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ManageAppsButton" Content="⚙️ Quản lý Ứng dụng" Foreground="White" Background="#33475569" BorderThickness="0" Margin="0,0,6,0" Padding="6,8" Cursor="Hand" Click="ManageAppsButton_Click" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="CloseButton" Content="❌ Đóng" Foreground="White" Background="#99E11D48" BorderThickness="0" Margin="0,0,0,0" Padding="6,8" Cursor="Hand" Click="CloseButton_Click" FontSize="11" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>