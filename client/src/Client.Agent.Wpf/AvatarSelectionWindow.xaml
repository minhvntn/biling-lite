<Window x:Class="Client.Agent.Wpf.AvatarSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn Ảnh Đại Diện" Height="500" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    
    <Border Background="#1E293B" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,15,20,10">
                <TextBlock Text="Chọn Ảnh Đại Diện" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="16" Cursor="Hand" Click="CloseButton_Click"/>
            </Grid>

            <Separator Grid.Row="0" VerticalAlignment="Bottom" Background="#334155" Margin="20,0"/>

            <ScrollViewer Grid.Row="1" Margin="20" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AvatarsContainer" />
            </ScrollViewer>

            <!-- Loading Indicator -->
            <TextBlock x:Name="LoadingText" Grid.Row="1" Text="Đang tải..." Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- Footer -->
            <Grid Grid.Row="2" Background="#0F172A" Margin="0" >
                <Border CornerRadius="0,0,16,16"/>
                <TextBlock Text="Càng nâng bậc VIP, càng mở khóa nhiều Avatar đẹp mắt!" Foreground="#00E5FF" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,15"/>
            </Grid>
        </Grid>
    </Border>
</Window>
