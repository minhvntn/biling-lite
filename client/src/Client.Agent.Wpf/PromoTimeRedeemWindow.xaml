<Window x:Class="Client.Agent.Wpf.PromoTimeRedeemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi Giờ Khuyến Mãi VIP" SizeToContent="Height" MinHeight="440" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded">
    <Border Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="12,12,0,0" Padding="20,15">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="HeaderTitleText" Text="🎁 ĐỔI GIỜ KHUYẾN MÃI" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="HeaderSubText" Text="Dùng giờ khuyến mãi tích lũy để quy đổi thời gian chơi" 
                                   Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="✕" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="CloseButton_Click" Cursor="Hand" FontSize="16"/>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="20">
                <!-- Three Cards Row -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="Card1Label" Text="ĐÃ CHƠI" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PlayedTimeText" Text="00:00" Foreground="#60A5FA" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="GIỜ KM HIỆN CÓ" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalPromoText" Text="00:00" Foreground="#F59E0B" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TỐI ĐA CÓ THỂ ĐỔI" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="MaxRedeemText" Text="00:00" Foreground="#10B981" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Interactive Slider Section -->
                <Border Background="#0F172A" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="KÉO THANH TRƯỢT ĐỂ CHỌN THỜI GIAN ĐỔI:" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>
                        
                        <Slider x:Name="RedeemSlider" Minimum="0" Maximum="100" Value="0" 
                                TickFrequency="1" IsSnapToTickEnabled="True" 
                                ValueChanged="RedeemSlider_ValueChanged"
                                Margin="0,10,0,15" Cursor="Hand"/>

                        <!-- Preview Display -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="THỜI GIAN ĐỔI:" Foreground="#94A3B8" FontSize="12"/>
                                <TextBlock x:Name="SelectedRedeemText" Text="0 phút" Foreground="#10B981" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="GIỜ KM CÒN LẠI:" Foreground="#94A3B8" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="RemainingPromoText" Text="0 phút" Foreground="#F59E0B" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <TextBlock x:Name="StatusMessageText" Text="" Foreground="#EF4444" FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,12,0,10" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,12,12" Padding="20,15">
                <Grid>
                    <Button Content="HỦY" Width="90" Height="36" Background="#334155" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" HorizontalAlignment="Left"/>
                    <Button x:Name="ConfirmButton" Content="✓ XÁC NHẬN ĐỔI" Width="140" Height="36" 
                            Background="#10B981" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="ConfirmButton_Click" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
